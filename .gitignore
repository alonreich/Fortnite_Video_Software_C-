# ==============================================================================
# Application Builds / Artifacts
# ==============================================================================
compiled/
temp_staging/
*.exe
!binaries/*.exe
!binaries/*.dll
!binaries/*.com

# ==============================================================================
# .NET / C# Project Ignores
# ==============================================================================
[Bb]in/
[Oo]bj/
TestResults/
packages/
*.nupkg

# IDEs & Editor
*.user
*.userosscache
*.sln.docstates
*.suo
*.userprefs
.vs/
.idea/
.vscode/

# Local settings
appsettings.Local.json
appsettings.Development.json
.env


# ==============================================================================
# Logs & OS generated
# ==============================================================================
*.log
.DS_Store
Thumbs.db
# Ignore old code
old_code/*
Old_Code/*
developer_tools/redundant_code_report.html_to_delete/

# Python bytecode — the developer_tools scripts all guard against writing it and sweep it on
# every run, but an editor, a `py_compile`, or one script importing another can still create it.
# This is the last line of defence: it must never reach the repository.
__pycache__/
*.py[cod]
*$py.class

# dev.cmd trace mode (SYS-DEVBUILD): in-repo diagnostic logs, never committed.
.devlogs/
.Old_Fortnite_Video_Software/
