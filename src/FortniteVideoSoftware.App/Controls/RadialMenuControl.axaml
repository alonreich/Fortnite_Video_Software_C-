<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FortniteVideoSoftware.App.Controls.RadialMenuControl"
             IsVisible="False"
             IsHitTestVisible="False"
             Opacity="0"
             Width="300" Height="300">
    <UserControl.Styles>
        <Style Selector="Border.RadialMenuOpen">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.RadialMenuClosed">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseIn"/>
                </Transitions>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Border Name="Container" Classes="RadialMenuClosed" Background="Transparent">
        <Grid>
            <Border Name="Hub" Width="60" Height="60" CornerRadius="30"
                    Background="{DynamicResource AppSurfaceAlpha80Brush}"
                    BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="2"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- ISSUE_04 (audit round 4): token-scaled font size -->
                <TextBlock Text="⚙" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize24}"/>
            </Border>
            <Canvas Name="SliceCanvas" Width="300" Height="300"/>
        </Grid>
    </Border>
</UserControl>
