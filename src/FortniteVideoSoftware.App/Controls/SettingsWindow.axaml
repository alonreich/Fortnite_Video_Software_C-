<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FortniteVideoSoftware.App.Controls.SettingsWindow"
        Title="Settings"
        Width="720" Height="520"
        MinWidth="500" MinHeight="400"
        Background="#1e293b"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        Topmost="True">
    <Grid>
        <Border Name="MainBorder" Background="#1e293b" CornerRadius="0" Padding="0" BorderBrush="LightGray" BorderThickness="5">
            <Grid RowDefinitions="30, *">
                <Border Name="TitleBarBorder" Grid.Row="0" Background="{DynamicResource TitleBarBackground}" IsHitTestVisible="False">
                    <TextBlock Name="TitleBarText" Classes="WindowTitleText" Text="{Binding $parent[Window].Title}" Foreground="{DynamicResource TitleBarForeground}" />
                </Border>
                <Grid Grid.Row="1" Margin="15" RowDefinitions="*, Auto">
                    <TabControl Grid.Row="0" Background="Transparent">
                        <TabItem Header="General">
                            <StackPanel Margin="10" Spacing="10">
                                <TextBlock Text="General Settings" FontSize="16" FontWeight="Bold" Foreground="White" />
                                <TextBlock Text="More settings coming soon..." Foreground="#94a3b8" FontSize="12"/>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Defaults">
                            <ScrollViewer>
                                <StackPanel Name="DefaultsPanel" Margin="10" Spacing="15">
                                    <TextBlock Text="Default values applied when the app opens." Foreground="#94a3b8" FontSize="12" Margin="0,0,0,10" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Key Binds">
                            <ScrollViewer>
                                <StackPanel Name="KeyBindsPanel" Margin="10" Spacing="15">
                                    <TextBlock Text="Click a button below and press a new key to rebind." Foreground="#94a3b8" FontSize="12" Margin="0,0,0,10" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,15,0,0">
                        <Button Name="CancelBtn" Classes="Danger" Content="CANCEL" Width="90" Height="32" FontSize="10" ToolTip.Tip="Discard changes and close"/>
                        <Button Name="SaveBtn" Classes="Success" Content="APPLY" Width="90" Height="32" FontSize="10" ToolTip.Tip="Apply settings and close"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
