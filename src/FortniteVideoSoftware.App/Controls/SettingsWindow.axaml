<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FortniteVideoSoftware.App.Controls.SettingsWindow"
        Title="Settings"
        Width="1000" Height="700"
        MinWidth="800" MinHeight="600"
        Background="#1e293b"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        Topmost="True">
    <Grid>
        <Border Name="MainBorder" Background="#1e293b" CornerRadius="0" Padding="0" BorderBrush="{DynamicResource WindowTitleBorder}" BorderThickness="5">
            <Grid RowDefinitions="30, *">
                <Border Name="TitleBarBorder" Grid.Row="0" Background="{DynamicResource TitleBarBackground}">
                    <TextBlock Name="TitleBarText" Classes="WindowTitleText" Text="{Binding $parent[Window].Title}" Foreground="{DynamicResource TitleBarForeground}" />
                </Border>
                <Grid Grid.Row="1" Margin="15" RowDefinitions="*, Auto">
                    <TabControl Grid.Row="0" Background="Transparent">
                        <TabItem Header="General">
                            <StackPanel Name="GeneralPanel" Margin="10" Spacing="10" MaxWidth="500" HorizontalAlignment="Left">
                                <TextBlock Text="General Settings" FontSize="16" FontWeight="Bold" Foreground="White" />
                                
                                <TextBlock Text="Music (mp3) Folder" Foreground="White" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,5">
                                    <TextBox Grid.Column="0" Name="DefaultMusicFolderTextBox" Watermark="C:\Users\...\Music" Background="#0f172a" BorderBrush="#334155" Foreground="White"/>
                                    <Button Grid.Column="1" Name="BrowseMusicFolderBtn" Content="Browse..." Classes="Secondary" Margin="10,0,0,0" Cursor="Hand"/>
                                </Grid>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Defaults">
                            <ScrollViewer>
                                <StackPanel Name="DefaultsPanel" Margin="10" Spacing="10" MaxWidth="500" HorizontalAlignment="Left">
                                    <TextBlock Text="Default values applied when the app opens." Foreground="#94a3b8" FontSize="12" Margin="0,0,0,5" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Key Binds">
                            <Grid RowDefinitions="*, Auto">
                                <ScrollViewer Grid.Row="0">
                                    <StackPanel Name="KeyBindsPanel" Margin="10" Spacing="8" MaxWidth="500" HorizontalAlignment="Left">
                                        <TextBlock Text="Click a button below and press a new key to rebind." Foreground="#94a3b8" FontSize="12" Margin="0,0,0,5" />
                                    </StackPanel>
                                </ScrollViewer>
                                <Button Grid.Row="1" Name="ResetKeyBindsBtn" Content="Reset to Factory Defaults" Classes="Danger" HorizontalAlignment="Right" Margin="0,10,10,10" ToolTip.Tip="Reset all keys to default"/>
                            </Grid>
                        </TabItem>
                    </TabControl>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,15,0,0">
                        <Button Name="CancelBtn" Classes="Danger" Content="CANCEL" Width="90" ToolTip.Tip="Discard changes and close"/>
                        <Button Name="SaveBtn" Classes="Success" Content="APPLY" Width="90" ToolTip.Tip="Apply settings and close"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
