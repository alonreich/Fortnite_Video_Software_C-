<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FortniteVideoSoftware.App.Controls.SettingsWindow"
        Title="Settings"
        Width="600" Height="450"
        Background="#0f172a"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        Topmost="True">
    <Grid>
        <Border Name="MainBorder" Background="#0f172a" CornerRadius="0" Padding="0" BorderBrush="Gray" BorderThickness="5">
            <Grid RowDefinitions="30, *">
                <Border Name="TitleBarBorder" Grid.Row="0" Background="Gray" IsHitTestVisible="False">
                    <TextBlock Name="TitleBarText" Text="{Binding $parent[Window].Title}" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold" FontSize="14" />
                </Border>
                <Grid Grid.Row="1" Margin="15" RowDefinitions="*, Auto">
                    <TabControl Grid.Row="0" Background="Transparent">
                        <TabItem Header="General">
                            <StackPanel Margin="10" Spacing="10">
                                <TextBlock Text="General Settings" FontSize="18" FontWeight="Bold" Foreground="White" />
                                <TextBlock Text="More settings coming soon..." Foreground="Gray" />
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Key Binds">
                            <ScrollViewer>
                                <StackPanel Name="KeyBindsPanel" Margin="10" Spacing="15">
                                    <TextBlock Text="Click a button below and press a new key to rebind." Foreground="Gray" FontSize="12" Margin="0,0,0,10" />
                                    <!-- Populated dynamically -->
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,15,0,0">
                        <Button Name="CancelBtn" Content="CANCEL" Classes="Danger" Width="100" Height="32"/>
                        <Button Name="SaveBtn" Content="SAVE" Classes="Success" Width="100" Height="32"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
