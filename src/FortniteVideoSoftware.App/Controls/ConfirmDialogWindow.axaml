<!-- ISSUE_06: WindowStartupLocation="CenterOwner" below is an INTENTIONAL exception to the
     suite-wide "no CenterOwner" rule. That rule targets the 8 persisted windows tracked by
     WindowBoundsHelper. This is a transient, non-persisted modal confirm, so centering on its
     parent is the correct, expected placement. Do not convert to Manual. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:CompileBindings="True"
        x:Class="FortniteVideoSoftware.App.Controls.ConfirmDialogWindow"
        Title="Confirm"
        MinWidth="420" MinHeight="280" SizeToContent="WidthAndHeight"
        Background="{DynamicResource AppSurfaceBrush}"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30">

    <Grid>
        <Border Background="{DynamicResource AppSurfaceBrush}" CornerRadius="0" Padding="0" BorderBrush="{DynamicResource WindowTitleBorder}" BorderThickness="3">
            <Grid RowDefinitions="30, *, Auto">
                <Border Grid.Row="0" Background="{DynamicResource TitleBarBackground}">
                    <TextBlock Name="DialogTitle" Text="Confirm" Classes="WindowTitleText" Foreground="{DynamicResource TitleBarForeground}" />
                </Border>

                <Border Grid.Row="1" Padding="25,20">
                    <TextBlock Name="MessageText" Text="" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize12}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15" Margin="0,0,0,25">
                    <!-- ISSUE_04 (audit round 5): MinHeight="34" removed from both buttons. It
                         locally overrode the global AppButtonMinHeight token (44) from
                         AvaloniaApp.axaml, dropping the two most consequential buttons in the suite
                         below the WCAG 2.2 target size AND freezing them at 34px while the Settings
                         font scale grew their labels. They now inherit the 44px scaling token. -->
                    <Button Name="YesBtn" Classes="Success" Content="YES" MinWidth="130" Cursor="Hand"/>
                    <Button Name="NoBtn" Classes="Secondary" Content="NO" MinWidth="130" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
