<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:CompileBindings="True"
        x:Class="FortniteVideoSoftware.App.Controls.FinishedDialogWindow"
        Title="Done! Video Processed Successfully!"
        Width="860" Height="500"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        CanResize="True"
        Topmost="False">
    
    <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="#475569" BorderThickness="2" CornerRadius="14" Margin="20">
        <Grid Margin="28,18,28,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Button Grid.Row="0" HorizontalAlignment="Right"
                    Classes="CloseBtn" Content="✕"
                    AutomationProperties.Name="Close dialog"
                    ToolTip.Tip="Close dialog"
                    Click="OnCloseClicked" />
            
            <TextBlock Grid.Row="1" x:Name="MessageText"
                       Text="File successfully saved to:\n..."
                       FontSize="16" FontWeight="Bold" Foreground="#60a5fa"
                       TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
            
            <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,18,0,0">
                <Button Click="OnWhatsAppClicked" Width="200" Height="60" Margin="8" Classes="Success">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="💬" FontFamily="Segoe UI Emoji" FontSize="20" VerticalAlignment="Center" />
                        <TextBlock Text="WHATSAPP SHARE" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="OnInstagramClicked" Width="200" Height="60" Margin="8" Classes="Primary" Background="#C13584">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📷" FontFamily="Segoe UI Emoji" FontSize="20" VerticalAlignment="Center" />
                        <TextBlock Text="INSTAGRAM" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="OnYouTubeClicked" Width="200" Height="60" Margin="8" Classes="Primary" Background="#FF0000">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="▶️" FontFamily="Segoe UI Emoji" FontSize="20" VerticalAlignment="Center" />
                        <TextBlock Text="YOUTUBE" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="OnTikTokClicked" Width="200" Height="60" Margin="8" Classes="Primary" Background="#000000" BorderBrush="#00f2fe" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🎵" FontFamily="Segoe UI Emoji" FontSize="20" VerticalAlignment="Center" />
                        <TextBlock Text="TIKTOK" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Content="OPEN FOLDER"
                        Click="OnOpenFolderClicked" Width="200" Height="60" Margin="8"
                        Classes="Primary" FontWeight="Bold"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Button Content="NEW FILE"
                        Click="OnUploadNewClicked" Width="200" Height="60" Margin="8"
                        Classes="Primary" FontWeight="Bold"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Button Content="EXIT APP!"
                        Click="OnExitClicked" Width="200" Height="60" Margin="8"
                        Classes="Danger" FontWeight="Bold"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </WrapPanel>
        </Grid>
    </Border>
</Window>




