<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FortniteVideoSoftware.App.Controls.FinishedDialogWindow"
        Title="Done! Video Processed Successfully!"
        Width="760" Height="420"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False"
        Topmost="True">
    
    <Border Background="#0b141d" BorderBrush="#7DD3FC" BorderThickness="2" CornerRadius="14" Margin="20">
        <Grid Margin="28,18,28,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Button Grid.Row="0" HorizontalAlignment="Right"
                    Content="X" FontSize="42" FontWeight="Bold" Foreground="#ff4d4d"
                    Background="Transparent" BorderThickness="0"
                    Cursor="Hand" Click="OnCloseClicked" />
            
            <TextBlock Grid.Row="1" x:Name="MessageText"
                       Text="File successfully saved to:\n..."
                       FontSize="16" FontWeight="Bold" Foreground="#7DD3FC"
                       TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
            
            <Grid Grid.Row="2" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="80,18,80,8">
                
                <Button Grid.Row="0" Grid.Column="0" Content="✆  WHATSAPP SHARE  ✆"
                        Click="OnWhatsAppClicked"
                        Background="#3CA557" Foreground="White" FontWeight="Bold" FontSize="12"
                        Width="180" Height="45" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        CornerRadius="8" Margin="0,0,42,28" HorizontalAlignment="Center"/>
                        
                <Button Grid.Row="0" Grid.Column="1" Content="OPEN FOLDER"
                        Click="OnOpenFolderClicked"
                        Background="#2e82a0" Foreground="White" FontWeight="Bold" FontSize="12"
                        Width="180" Height="45" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        CornerRadius="8" Margin="0,0,0,28" HorizontalAlignment="Center"/>
                        
                <Button Grid.Row="1" Grid.Column="0" Content="📂  UPLOAD NEW  📂"
                        Click="OnUploadNewClicked"
                        Background="#2e82a0" Foreground="White" FontWeight="Bold" FontSize="12"
                        Width="180" Height="45" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        CornerRadius="8" Margin="0,0,42,0" HorizontalAlignment="Center"/>
                        
                <Button Grid.Row="1" Grid.Column="1" Content="EXIT APP!"
                        Click="OnExitClicked"
                        Background="#c0392b" Foreground="White" FontWeight="Bold" FontSize="12"
                        Width="180" Height="45" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        CornerRadius="8" Margin="0,0,0,0" HorizontalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
