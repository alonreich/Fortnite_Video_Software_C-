<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:CompileBindings="True"
        x:Class="FortniteVideoSoftware.App.Controls.FinishedDialogWindow"
        Title="Done! Video Processed Successfully!"
        Width="760" Height="420"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False"
        Topmost="True">
    
    <Border Background="#1e293b" BorderBrush="#475569" BorderThickness="2" CornerRadius="14" Margin="20">
        <Grid Margin="28,18,28,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Button Grid.Row="0" HorizontalAlignment="Right"
                    Classes="CloseBtn" Content="✕"
                    Click="OnCloseClicked" />
            
            <TextBlock Grid.Row="1" x:Name="MessageText"
                       Text="File successfully saved to:\n..."
                       FontSize="16" FontWeight="Bold" Foreground="#60a5fa"
                       TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
            
            <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Orientation="Horizontal"
                       ItemWidth="180" ItemHeight="45"
                       Margin="0,18,0,0">
                <Button Content="WHATSAPP SHARE"
                        Click="OnWhatsAppClicked"
                        Classes="Success" FontWeight="Bold" FontSize="12"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Button Content="OPEN FOLDER"
                        Click="OnOpenFolderClicked"
                        Classes="Primary" FontWeight="Bold" FontSize="12"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Button Content="RETURN TO EDITOR"
                        Click="OnUploadNewClicked"
                        Classes="Primary" FontWeight="Bold" FontSize="12"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Button Content="EXIT APP!"
                        Click="OnExitClicked"
                        Classes="Danger" FontWeight="Bold" FontSize="12"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </WrapPanel>
        </Grid>
    </Border>
</Window>
