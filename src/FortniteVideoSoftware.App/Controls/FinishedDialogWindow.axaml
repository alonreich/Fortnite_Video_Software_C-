<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:CompileBindings="True"
        x:Class="FortniteVideoSoftware.App.Controls.FinishedDialogWindow"
        Title="Done! Video Processed Successfully!"
        MinWidth="860" MinHeight="500" SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        CanResize="True"
        Topmost="False"
        Background="{DynamicResource AppSurfaceBrush}">
    
    <!-- ISSUE_01: window has no OS title bar; the background surface is the drag handle -->
    <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="2" CornerRadius="14" Margin="20" PointerPressed="OnRootPointerPressed">
        <Grid Margin="28,18,28,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Button Grid.Row="0" HorizontalAlignment="Right"
                    Classes="CloseBtn" Content="✕"
                    AutomationProperties.Name="Close dialog"
                    ToolTip.Tip="Close dialog"
                    Click="OnCloseClicked" />
            
            <TextBlock Grid.Row="1" x:Name="MessageText"
                       Text="File successfully saved to:&#x0a;..."
                       FontSize="{DynamicResource AppFontSize16}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"
                       TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
            
            <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,18,0,0">
                <Button Click="OnWhatsAppClicked" MinWidth="200" MinHeight="60" Margin="8" Classes="WhatsApp">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="💬" FontFamily="Segoe UI Emoji" FontSize="{DynamicResource AppFontSize20}" VerticalAlignment="Center" />
                        <TextBlock Text="WHATSAPP SHARE" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="OnInstagramClicked" MinWidth="200" MinHeight="60" Margin="8" Classes="Instagram">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📷" FontFamily="Segoe UI Emoji" FontSize="{DynamicResource AppFontSize20}" VerticalAlignment="Center" />
                        <TextBlock Text="INSTAGRAM" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="OnYouTubeClicked" MinWidth="200" MinHeight="60" Margin="8" Classes="YouTube">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="▶" FontFamily="Segoe UI Emoji" FontSize="{DynamicResource AppFontSize20}" VerticalAlignment="Center" />
                        <TextBlock Text="YOUTUBE" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="OnTikTokClicked" MinWidth="200" MinHeight="60" Margin="8" Classes="TikTok">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🎵" FontFamily="Segoe UI Emoji" FontSize="{DynamicResource AppFontSize20}" VerticalAlignment="Center" />
                        <TextBlock Text="TIKTOK" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Content="OPEN FOLDER"
                        Click="OnOpenFolderClicked" MinWidth="200" MinHeight="60" Margin="8"
                        Classes="Primary" FontWeight="Bold"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Button Content="NEW FILE"
                        Click="OnUploadNewClicked" MinWidth="200" MinHeight="60" Margin="8"
                        Classes="Secondary" FontWeight="Bold"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Button Content="EXIT APP!"
                        Click="OnExitClicked" MinWidth="200" MinHeight="60" Margin="8"
                        Classes="Danger" FontWeight="Bold"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </WrapPanel>
        </Grid>
    </Border>
</Window>




