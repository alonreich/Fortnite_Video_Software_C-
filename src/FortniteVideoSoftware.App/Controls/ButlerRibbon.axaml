<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FortniteVideoSoftware.App.Controls.ButlerRibbon"
             IsVisible="False"
             IsHitTestVisible="False"
             Opacity="0"
             ZIndex="997">
    <UserControl.Styles>
        <Style Selector="Border.ButlerVisible">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.ButlerHidden">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseIn"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ButlerCard">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource AppFontSizeNormal}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.ButlerCard:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppAccentAlpha20Brush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.ButlerDismiss">
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
            <!-- ISSUE_04 (audit round 4): token-scaled font sizes -->
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize14}"/>
        </Style>
        <Style Selector="Button.ButlerDismiss:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppAccentAlpha15Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}"/>
        </Style>
    </UserControl.Styles>

    <Border Name="ContainerBorder" Classes="ButlerHidden" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Margin="0,0,12,8" MaxWidth="320">
        <Border.RenderTransform>
            <TranslateTransform X="0" Y="0"/>
        </Border.RenderTransform>
        <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
                <Button Name="CardButton" Classes="ButlerCard" Grid.Column="0" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Name="IconText" FontSize="{DynamicResource AppFontSize20}" VerticalAlignment="Center"/>
                        <TextBlock Name="LabelText" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>
                <Button Name="DismissButton" Classes="ButlerDismiss" Grid.Column="1"
                        VerticalAlignment="Center" Content="✕" Margin="2,0,0,0"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>