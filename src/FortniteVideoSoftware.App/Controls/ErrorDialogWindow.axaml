<!-- Shared failure dialog. WindowStartupLocation="CenterOwner" is an INTENTIONAL exception to
     the suite-wide "no CenterOwner" rule (same rationale as ConfirmDialogWindow): this is a
     transient, non-persisted modal and is NOT one of the 8 WindowBoundsHelper-tracked windows.
     Every user-visible failure in the suite routes through this window via ErrorReporter, so
     the user always gets: what failed, the single root-cause line from the log, OKAY and
     SHOW LOGS. Do not add a third action and do not bypass it with a bare toast. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:CompileBindings="True"
        x:Class="FortniteVideoSoftware.App.Controls.ErrorDialogWindow"
        Title="Something went wrong"
        MinWidth="520" MinHeight="300" MaxWidth="820" SizeToContent="WidthAndHeight"
        Background="{DynamicResource AppSurfaceBrush}"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30">

    <Grid>
        <Border Background="{DynamicResource AppSurfaceBrush}" CornerRadius="0" Padding="0"
                BorderBrush="{DynamicResource WindowTitleBorder}" BorderThickness="3">
            <Grid RowDefinitions="30, Auto, Auto, Auto">

                <Border Grid.Row="0" Background="{DynamicResource TitleBarBackground}">
                    <TextBlock Name="DialogTitle" Text="Something went wrong"
                               Classes="WindowTitleText"
                               Foreground="{DynamicResource TitleBarForeground}" />
                </Border>

                <!-- Plain-English summary -->
                <Border Grid.Row="1" Padding="25,20,25,10">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock Text="&#x26A0;"
                                   FontSize="{DynamicResource AppFontSize28}"
                                   Foreground="{DynamicResource AppDangerBrush}"
                                   VerticalAlignment="Top" />
                        <TextBlock Name="MessageText" Text=""
                                   Foreground="{DynamicResource AppTextMutedBrush}"
                                   FontSize="{DynamicResource AppFontSize13}"
                                   TextWrapping="Wrap" MaxWidth="640"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Root-cause line lifted straight out of the log -->
                <Border Grid.Row="2" Name="DetailContainer" Padding="25,0,25,18" IsVisible="False">
                    <StackPanel Spacing="6">
                        <TextBlock Text="ROOT CAUSE"
                                   FontSize="{DynamicResource AppFontSize10}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextMutedBrush}" />
                        <Border Background="{DynamicResource AppPanelBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1" CornerRadius="3" Padding="10,8">
                            <ScrollViewer MaxHeight="130" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <SelectableTextBlock Name="DetailText" Text=""
                                                     FontFamily="Consolas,Courier New,monospace"
                                                     FontSize="{DynamicResource AppFontSize11}"
                                                     Foreground="{DynamicResource AppTextMutedBrush}"
                                                     TextWrapping="Wrap" MaxWidth="700" />
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
                            Spacing="15" Margin="0,4,0,25">
                    <!-- ISSUE_04 (audit round 5): MinHeight="34" removed — it overrode the global
                         AppButtonMinHeight token (44) and blocked font-scale growth. -->
                    <Button Name="OkayBtn" ToolTip.Tip="Close this message and return to the app." Classes="Primary" Content="OKAY"
                            MinWidth="140" Cursor="Hand" IsDefault="True"
                            AutomationProperties.Name="Acknowledge the error" />
                    <Button Name="ShowLogsBtn" ToolTip.Tip="Open the application log file so you can read or share the technical detail." Classes="Secondary" Content="SHOW LOGS"
                            MinWidth="140" Cursor="Hand"
                            AutomationProperties.Name="Open the application log file" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
