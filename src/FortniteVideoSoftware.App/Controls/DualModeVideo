using System.Threading.Tasks;
using Avalonia.Controls;
using FortniteVideoSoftware.Core.Media;

namespace FortniteVideoSoftware.App.Controls;

/// <summary>
/// Dispatcher control that hosts either the hardware-accelerated video view
/// (HWND-embedded MPV via <see cref="MpvVideoView"/>) or the software fallback
/// (<see cref="SoftwareVideoView"/> with MemoryMappedFile + WriteableBitmap).
///
/// The decision is made at startup by <see cref="VideoRenderMode"/> and cannot
/// be changed at runtime.
/// </summary>
public class DualModeVideoView : ContentControl
{
    private MpvVideoView? _hwView;
    private SoftwareVideoView? _swView;

    /// <summary>
    /// Gets the active video view. Use this for IPC access and MPV control.
    /// </summary>
    public MpvVideoView? HardwareView => _hwView;

    /// <summary>
    /// Gets the software video view (null in hardware mode).
    /// </summary>
    public SoftwareVideoView? SoftwareView => _swView;

    /// <summary>
    /// Gets the active IPC client regardless of mode.
    /// </summary>
    public MpvIpcClient? IpcClient => _hwView?.IpcClient ?? _swView?.IpcClient;

    /// <summary>
    /// True if using hardware acceleration (GPU mode).
    /// </summary>
    public bool IsHardwareMode => VideoRenderMode.Current.UseHardwareAcceleration;

    public DualModeVideoView()
    {
        if (VideoRenderMode.Current.UseHardwareAcceleration)
        {
            _hwView = new MpvVideoView();
            Content = _hwView;
        }
        else
        {
            _swView = new SoftwareVideoView();
            Content = _swView;
        }
    }

    /// <summary>
    /// Starts the MPV process. In hardware mode, launches MPV with --hwdec=auto
    /// bound to the HWND. In software mode, launches MPV with --hwdec=no and
    /// --vo=rawvideo, then connects the SoftwareVideoView to the frame buffer.
    /// </summary>
    public async Task StartMpvProcessAsync(string mpvPath)
    {
        if (_hwView != null)
        {
            await _hwView.StartMpvProcessAsync(mpvPath);
        }
        else if (_swView != null)
        {
            // In software mode, the IPC client is created separately and
            // configured with software-only args. The frame buffer name is
            // passed via an environment variable that MPV's custom VO reads.
            var ipc = new MpvIpcClient();
            await ipc.StartAsyncSoftware(nint.Zero, mpvPath);

            // Create frame buffer and connect
            var mmap = MmapFrameBridge.Create();
            _swView.IpcClient = ipc;
            _swView.ConnectToFrameBuffer(mmap.MapName);
        }
    }
}