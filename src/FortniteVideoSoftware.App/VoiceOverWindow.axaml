<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:CompileBindings="True"
        xmlns:local="clr-namespace:FortniteVideoSoftware.App"
        xmlns:controls="clr-namespace:FortniteVideoSoftware.App.Controls"
        x:Class="FortniteVideoSoftware.App.VoiceOverWindow"
        Title="Voice Over Studio"

        Background="{DynamicResource AppSurfaceBrush}"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="Manual"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30">

    <Grid>
        <Border Name="MainBorder" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="0" Padding="0" BorderBrush="{DynamicResource WindowTitleBorder}" BorderThickness="5">
            <Grid RowDefinitions="30, *">
                <Border Name="TitleBarBorder" Grid.Row="0" Background="{DynamicResource TitleBarBackground}" Cursor="DragMove" ToolTip.Tip="Drag to move. Double-click to maximize.">
                    <TextBlock Name="TitleBarText" Classes="WindowTitleText" Text="{Binding $parent[Window].Title}" Foreground="{DynamicResource TitleBarForeground}" TextTrimming="CharacterEllipsis" />
                </Border>
                <Grid Grid.Row="1" RowDefinitions="*, Auto">

                    <!-- MAIN BODY -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">

                        <!-- LEFT: Video preview + timeline -->
                        <Grid Grid.Column="0" RowDefinitions="*, Auto" Margin="12" MinWidth="0">

                            <!-- Video preview -->
                            <Border Name="VideoAreaBorder" Grid.Row="0" Background="{DynamicResource AppVideoSurfaceBrush}" CornerRadius="6" ClipToBounds="True">
                                <Grid>
                                    <local:MpvVideoView Name="VideoHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                    <!-- Playhead overlay (optional) -->
                                </Grid>
                            </Border>

                            <!-- Timeline and controls -->
                            <Grid Grid.Row="1" Margin="0,15,0,0">
                                <StackPanel Orientation="Vertical" Spacing="8">
                                    <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        
                                        <!-- Realistic Mic Button -->
                                         <Button Name="MicRecordButton" Classes="Danger" MinWidth="82" MinHeight="82" Margin="0,0,20,0" ToolTip.Tip="Start or stop voiceover recording (V)" AutomationProperties.Name="Start or stop voiceover recording" IsEnabled="False">
                                             <Viewbox MinWidth="32" MinHeight="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                 <Path Name="MicIcon" Fill="{DynamicResource AppOnAccentTextBrush}" Data="M12,14c1.66,0,3-1.34,3-3V5c0-1.66-1.34-3-3-3S9,3.34,9,5v6C9,12.66,10.34,14,12,14z M17,11c0,2.76-2.24,5-5,5s-5-2.24-5-5H5c0,3.53,2.61,6.43,6,6.92V21h2v-3.08c3.39-0.49,6-3.39,6-6.92H17z" />
                                             </Viewbox>
                                         </Button>
                                        
                                        <!-- Recording Indicator & EQ -->
                                        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Spacing="10" Margin="0,0,20,0">
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <Ellipse Name="RecordingLight" Width="16" Height="16" ToolTip.Tip="Recording indicator: Red = recording, Green = idle" Fill="{DynamicResource AppDangerBrush}" Opacity="0.2"/>
                                                <TextBlock Name="RecordingStatusText" Text="READY" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize16}" FontWeight="Bold"/>
                                            </StackPanel>
                                            
                                            <!-- EQ Meter -->
                                            <Border Name="EqMeterTrack" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="4" MinWidth="120" MaxWidth="180" Height="20" ClipToBounds="True">
                                                <Rectangle Name="EqMeter" Width="0" Height="20" HorizontalAlignment="Left" Fill="{DynamicResource AppSuccessBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Play Pause -->
                                        <!-- ISSUE_06 (audit round 4): token-sized shared Play/Pause geometries (were fixed
                                             16/4/14px Polygon+Rectangles) — now identical to the Main/Granular/Merger/Wizard
                                             transport icons and scale with the Settings font size. -->
                                        <Button Name="PlayPauseButton" Classes="Primary" MinWidth="70" MinHeight="50" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsEnabled="False" ToolTip.Tip="Play or pause the preview video" AutomationProperties.Name="Play or pause the preview video">
                                            <Panel Width="{DynamicResource AppFontSize16}" Height="{DynamicResource AppFontSize16}">
                                                <Path Name="PlayIcon" Data="{DynamicResource AppPlayIconGeometry}" Fill="{DynamicResource AppOnAccentTextBrush}" Stretch="Uniform"/>
                                                <Path Name="PauseIcon" IsVisible="False" Data="{DynamicResource AppPauseIconGeometry}" Fill="{DynamicResource AppOnAccentTextBrush}" Stretch="Uniform"/>
                                            </Panel>
                                        </Button>
                                    </WrapPanel>

                                    <!-- Timeline lanes -->
                                    <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,10,0,0">
                                        <Grid RowDefinitions="Auto, *, *" MinHeight="140">
                                            <!-- Ruler -->
                                            <Canvas Name="TimelineRulerCanvas" Classes="TimelineSeekSurface" Grid.Row="0" MinHeight="20" Background="{DynamicResource AppPanelBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="Hand" Focusable="True" KeyboardNavigation.IsTabStop="True" ToolTip.Tip="Click or drag to seek inside the trimmed voiceover range" AutomationProperties.Name="Voiceover timeline ruler" />

                                            <!-- Thumbnails -->
                                            <Grid Name="ThumbnailLaneGrid" Classes="TimelineSeekSurface" Grid.Row="1" MinHeight="54" Background="{DynamicResource AppSurfaceBrush}" Cursor="Hand" Focusable="True" KeyboardNavigation.IsTabStop="True" ToolTip.Tip="Click or drag to seek by frame preview" AutomationProperties.Name="Voiceover thumbnail seek lane">
                                                <Image Name="ThumbnailLaneImage" Stretch="Fill" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                <Border Name="ThumbLoadingOverlay" Background="{DynamicResource AppOverlayBrush}" IsHitTestVisible="False" IsVisible="False">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                                                        <ProgressBar IsIndeterminate="True" Width="60" Height="3" Foreground="{DynamicResource AppWarningBrush}" Background="{DynamicResource AppControlTrackBrush}"/>
                                                        <TextBlock Text="Generating Frames..." Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize10}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <!-- We can generate Images via code or just a Canvas -->
                                                <Canvas Name="ThumbnailCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                                <!-- Playhead Marker -->
                                                <TextBlock Name="ThumbFallbackText" Text="" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" IsHitTestVisible="False" IsVisible="False"/>
                                                <Border Name="ThumbPlayheadLine" Width="2" Background="{DynamicResource AppDangerBrush}" HorizontalAlignment="Left" VerticalAlignment="Stretch" />
                                            </Grid>

                                            <!-- Waveform -->
                                            <Grid Name="WaveformLaneGrid" Classes="TimelineSeekSurface" Grid.Row="2" MinHeight="54" Background="{DynamicResource AppSurfaceBrush}" Cursor="Hand" Focusable="True" KeyboardNavigation.IsTabStop="True" ToolTip.Tip="Click or drag to seek by audio waveform" AutomationProperties.Name="Voiceover waveform seek lane">
                                                <Image Name="WaveformLaneImage" Stretch="Fill" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                <Border Name="WaveformLoadingOverlay" Background="{DynamicResource AppOverlayBrush}" IsHitTestVisible="False" IsVisible="False">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                                                        <ProgressBar IsIndeterminate="True" Width="60" Height="3" Foreground="{DynamicResource AppInfoBrush}" Background="{DynamicResource AppControlTrackBrush}"/>
                                                        <TextBlock Text="Generating Waveform..." Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize10}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <Canvas Name="WaveformCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                                <TextBlock Name="WaveformFallbackText" Text="" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" IsHitTestVisible="False" IsVisible="False"/>
                                                <Border Name="WavePlayheadLine" Width="2" Background="{DynamicResource AppDangerBrush}" HorizontalAlignment="Left" VerticalAlignment="Stretch" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- RIGHT PANEL: Probing & Options -->
                        <Border Grid.Column="1" Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0" Padding="15" MinWidth="260" MaxWidth="340">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Orientation="Vertical" Spacing="15">
                                <TextBlock Text="VOICE DETECTION" FontSize="{DynamicResource AppFontSize16}" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                <TextBlock Text="Scanning for candidate voice-frequency ranges..." Name="ProbingStatusText" FontSize="{DynamicResource AppFontSize12}" Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Vertical" Spacing="5">
                                    <TextBlock Text="MICROPHONE" FontSize="{DynamicResource AppFontSize11}" FontWeight="Bold" Foreground="{DynamicResource AppTextMutedBrush}" />
                                    <ComboBox Name="MicDeviceComboBox" MinWidth="220" HorizontalAlignment="Stretch" PlaceholderText="No microphone found" ToolTip.Tip="Choose which microphone records the voiceover" />
                                </StackPanel>
                                
                                <StackPanel Orientation="Vertical" Spacing="5">
                                    <TextBlock Text="VOICE MUTING FILTERS" FontSize="{DynamicResource AppFontSize11}" FontWeight="Bold" Foreground="{DynamicResource AppTextMutedBrush}" />
                                    <Border Background="{DynamicResource AppSurfaceBrush}" CornerRadius="4" Padding="10">
                                        <Panel MinHeight="100">
                                            <TextBlock Text="Scan audio to unlock voice frequencies" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize11}" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding !#MuteMaleCb.IsVisible}" />
                                            <StackPanel Orientation="Vertical" Spacing="10" Name="DemographicPanel">
                                                <CheckBox Name="MuteMaleCb" Content="Reduce Adult Male Range" IsVisible="False" IsChecked="{Binding $parent[local:VoiceOverWindow].IsMuteMale, Mode=TwoWay}" ToolTip.Tip="Attenuate the strongest detected adult male frequency range in the original audio" />
                                                <CheckBox Name="MuteFemaleCb" Content="Reduce Female Range" IsVisible="False" IsChecked="{Binding $parent[local:VoiceOverWindow].IsMuteFemale, Mode=TwoWay}" ToolTip.Tip="Attenuate the strongest detected female frequency range in the original audio" />
                                                <CheckBox Name="MuteChildCb" Content="Reduce Child Range" IsVisible="False" IsChecked="{Binding $parent[local:VoiceOverWindow].IsMuteChild, Mode=TwoWay}" ToolTip.Tip="Attenuate the strongest detected child voice frequency range in the original audio" />
                                            </StackPanel>
                                        </Panel>
                                    </Border>
                                </StackPanel>
                                
                                <TextBlock Text="Frequency muting can also reduce nearby game sounds." FontSize="{DynamicResource AppFontSize10}" Foreground="{DynamicResource AppTextMutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- BOTTOM ROW (Apply / Cancel) -->
                    <Border Grid.Row="1" Background="{DynamicResource AppSurfaceBrush}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppBorderBrush}" Padding="12,12,12,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Name="VoiceOverHintText" Grid.Column="0" Text="Record a take or choose a detected voice mute option before applying. Cancel discards unapplied takes." Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize11}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15" HorizontalAlignment="Right">
                                <Button Name="CancelButton" Classes="Secondary" Content="CANCEL" MinWidth="100" ToolTip.Tip="Close without applying this voiceover session"/>
                                <Button Name="ApplyButton" Classes="Success" Content="APPLY &amp; CLOSE" MinWidth="140" IsEnabled="False" ToolTip.Tip="Record a take or choose a mute option before applying"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        <Border Name="ResizeGrip" MinWidth="24" MinHeight="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomRightCorner" ToolTip.Tip="Resize Voice Over Studio" AutomationProperties.Name="Resize Voice Over Studio">
            <Path Stroke="{DynamicResource AppBorderBrush}" StrokeThickness="1.5" StrokeLineCap="Round" Data="M 8,20 L 20,8 M 13,20 L 20,13 M 18,20 L 20,18" />
        </Border>
    </Grid>
</Window>
