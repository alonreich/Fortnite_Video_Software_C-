<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:CompileBindings="True"
        xmlns:local="clr-namespace:FortniteVideoSoftware.App"
        xmlns:controls="clr-namespace:FortniteVideoSoftware.App.Controls"
        x:Class="FortniteVideoSoftware.App.GranularSpeedEditorWindow"
        Title="Granular Speed Editor"
        Background="{DynamicResource AppSurfaceBrush}"
        MinWidth="900" MinHeight="600"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        WindowStartupLocation="Manual">

    <Grid>
        <Border Name="MainBorder" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="0" Padding="0" BorderBrush="{DynamicResource WindowTitleBorder}" BorderThickness="5">
            <Grid RowDefinitions="30, *">
                <Border Name="TitleBarBorder" Grid.Row="0" Background="{DynamicResource TitleBarBackground}">
                    <TextBlock Name="TitleBarText" Classes="WindowTitleText" Text="{Binding $parent[Window].Title}" Foreground="{DynamicResource TitleBarForeground}" />
                </Border>
                <Grid Grid.Row="1" RowDefinitions="*, Auto">

        <!-- MAIN BODY -->
        <Grid Grid.Row="0" ColumnDefinitions="*, 280">

            <!-- LEFT: Video preview + timeline -->
            <Grid Grid.Column="0" RowDefinitions="*, Auto, Auto, Auto, Auto" Margin="12">

                <!-- Video preview -->
                <Border Name="GranularVideoAreaBorder" Grid.Row="0" Background="{DynamicResource AppVideoSurfaceBrush}" CornerRadius="6" ClipToBounds="True">
                    <Grid>
                        <local:MpvVideoView Name="GranularVideoHost" ZIndex="0"/>
                        <!-- #1 Fake mobile phone frame: shows the 9:16 portrait crop area (visible only when Portrait mode is on) -->
                        <Grid Name="GranularPortraitDimmingGrid" ZIndex="5" IsVisible="False" IsHitTestVisible="False">
                            <controls:PhoneFrameMockup Name="GranularPhoneFrame" />
                        </Grid>
                        <!-- #10 Live drag readout: shows exact start / end / length while dragging a block -->
                        <Border Name="DragReadoutBadge" IsVisible="False" ZIndex="60" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Background="{DynamicResource AppOverlayBrush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5" IsHitTestVisible="False">
                            <TextBlock Name="DragReadoutText" Text="" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize11}" FontWeight="Bold"/>
                        </Border>
                        <!-- §4 Zoom draw surface. Dimmer + spotlight cutout + handles + tutorial are built
                             in code-behind and added here. Background is near-transparent so the whole
                             area receives pointer events while zoom mode is active. -->
                        <Canvas Name="ZoomOverlayCanvas" ZIndex="40" IsVisible="False" Background="#01000000"
                                Cursor="Cross" ClipToBounds="True"/>
                        <Popup Name="FreezeValidationPopup" IsOpen="False" Placement="Center" IsHitTestVisible="False" ZIndex="11">
                            <Border Name="FreezeValidationBorder" Background="{DynamicResource AppOverlayBrush}" BorderBrush="{DynamicResource AppWarningBrush}" BorderThickness="2" CornerRadius="6" Padding="16,10">
                                <TextBlock Name="FreezeValidationText" Text="SELECT FREEZE DURATION" FontSize="{DynamicResource AppFontSize16}" Foreground="{DynamicResource AppWarningBrush}" FontWeight="Bold" HorizontalAlignment="Center" />
                            </Border>
                        </Popup>
                        <Popup Name="GranularFeedbackPopup" IsOpen="False" Placement="Bottom"
                               HorizontalOffset="0" VerticalOffset="-80" IsLightDismissEnabled="False"
                               IsHitTestVisible="False" ZIndex="11">
                            <Border Name="GranularFeedbackPopupBorder" Background="{DynamicResource AppOverlayBrush}" BorderBrush="{DynamicResource AppWarningBrush}" BorderThickness="1" CornerRadius="8" Padding="24,12" Opacity="0">
                                <TextBlock Name="GranularFeedbackPopupText" Text="" Foreground="{DynamicResource AppWarningBrush}" FontSize="{DynamicResource AppFontSize28}" FontWeight="Bold" HorizontalAlignment="Center" />
                            </Border>
                        </Popup>
                    </Grid>
                </Border>

                <!-- ROW 1: ACTION RIBBON (Contextual Tools) -->
                <Border Grid.Row="1" Background="{DynamicResource AppPanelBrush}" CornerRadius="6" Padding="10" Margin="10,10,10,5">
                    <Grid ColumnDefinitions="*, *">
                        <!-- LEFT: Freeze Controls -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Button Name="FreezeImageToggle" Classes="Primary" MinWidth="120" ToolTip.Tip="Freeze frame at current playhead">
                                <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Fill="{DynamicResource AppOnAccentTextBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" RenderTransform="translateY(5px)" Data="M 2,6 L 4,6 L 5,4 L 11,4 L 12,6 L 14,6 Q 15,6 15,7 L 15,12 Q 15,13 14,13 L 2,13 Q 1,13 1,12 L 1,7 Q 1,6 2,6 Z M 8,7.5 A 2.5,2.5 0 1,0 8,12.5 A 2.5,2.5 0 1,0 8,7.5" />
                                    <TextBlock Name="FreezeImageToggleText" Text=" FREEZE IMAGE " FontSize="{DynamicResource AppFontSize9}" VerticalAlignment="Center" Margin="4,0,4,0" />
                                </StackPanel>
                            </Button>
                            <StackPanel Name="FreezePresetsPanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Name="FreezePreset05" Classes="SpeedPreset" Content="0.5s" ToolTip.Tip="Freeze for 0.5s"/>
                                <Button Name="FreezePreset10" Classes="SpeedPreset" Content="1.0s" ToolTip.Tip="Freeze for 1.0s"/>
                                <Button Name="FreezePreset15" Classes="SpeedPreset" Content="1.5s" ToolTip.Tip="Freeze for 1.5s"/>
                                <Button Name="FreezePreset20" Classes="SpeedPreset" Content="2.0s" ToolTip.Tip="Freeze for 2.0s"/>
                                <Button Name="FreezePreset25" Classes="SpeedPreset" Content="2.5s" ToolTip.Tip="Freeze for 2.5s"/>
                                <Button Name="FreezePreset30" Classes="SpeedPreset" Content="3.0s" ToolTip.Tip="Freeze for 3.0s"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- RIGHT: Zoom Controls -->
                        <Panel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" MinHeight="30" MinWidth="240">
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" IsVisible="{Binding #ZoomSegmentBtn.IsVisible}">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <CheckBox Name="SlowZoomCheck" Content="Slow" FontSize="{DynamicResource AppFontSize9}" MinHeight="0" Padding="4,0,0,0" ToolTip.Tip="Slow zoom-in/out: eases in over up to 1 second."/>
                                    <CheckBox Name="InstantZoomCheck" Content="Instant" IsChecked="True" FontSize="{DynamicResource AppFontSize9}" MinHeight="0" Padding="4,0,0,0" ToolTip.Tip="Instant zoom-in/out: snaps to the box immediately."/>
                                </StackPanel>
                                <Button Name="ZoomSegmentBtn" Classes="Primary" Content="ZOOM-IN" MinWidth="100" HorizontalAlignment="Right" IsVisible="False" ToolTip.Tip="Draw a zoom (punch-in) box on the selected speed segment"/>
                            </StackPanel>
                        </Panel>
                    </Grid>
                </Border>

                <!-- ROW 2: Timeline -->
                <Border Grid.Row="2" Background="{DynamicResource AppOverlayBrush}" CornerRadius="6" Padding="8,4" Margin="10,5,10,10" ClipToBounds="False">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" ClipToBounds="False">
                    <!-- ISSUE_05: MinWidth (not Width) so scaled fonts never clip the clocks -->
                    <TextBlock Name="GranularTimeElapsed" Text="00:00:00" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" MinWidth="64" FontSize="{DynamicResource AppFontSize10}" Margin="0,0,8,0" />
                    <Grid Grid.Column="1" VerticalAlignment="Center" MinHeight="46" ClipToBounds="False">
                        <StackPanel Orientation="Vertical">
                            <Canvas Name="GranularTimelineScaleCanvas" IsHitTestVisible="False" ClipToBounds="False" HorizontalAlignment="Stretch" Height="14" ZIndex="10000" />
                            <!-- ISSUE_06: row is 44 (was 32) so the 44px CompactSlider fits without bleeding into the tick ruler -->
                            <Grid Height="44" ClipToBounds="False" ZIndex="10001">
                                <Slider Name="GranularTimeline" Classes="CompactSlider" Minimum="0" Maximum="1000" Height="44" MinHeight="44" VerticalAlignment="Center" ClipToBounds="False" ZIndex="10002" ToolTip.Tip="Drag to scrub through the video" />
                                <Canvas Name="GranularTimelineCanvas" Classes="TimelineSeekSurface" IsHitTestVisible="True" Cursor="Hand" Focusable="True" KeyboardNavigation.IsTabStop="True" ClipToBounds="False" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="32" ZIndex="10003" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Column="2" Name="GranularDuration" Text="-00:00:00" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" MinWidth="64" TextAlignment="Right" FontSize="{DynamicResource AppFontSize10}" Margin="8,0,0,0" />
                </Grid>
                </Border>

                <!-- ROW 3: Transport -->
                <Grid Grid.Row="3" Margin="0,5,0,10" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Name="MarkStartBtn" Classes="Primary" Content="MARK START" MinWidth="90" Margin="0,0,30,0" ToolTip.Tip="Mark the beginning of your clip"/>
                        <Button Name="GranularPlayPause" Classes="Primary" MinWidth="70" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="Play or Pause" ToolTip.Tip="Play or pause the video" Margin="0,0,30,0">
                            <Panel Width="16" Height="16">
                                <Polygon Name="PlayIcon" Points="3,1 14,8 3,15" Fill="{DynamicResource AppOnAccentTextBrush}"/>
                                <StackPanel Name="PauseIcon" IsVisible="False" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Rectangle Width="4" Height="14" Fill="{DynamicResource AppOnAccentTextBrush}"/>
                                    <Rectangle Width="4" Height="14" Fill="{DynamicResource AppOnAccentTextBrush}"/>
                                </StackPanel>
                            </Panel>
                        </Button>
                        <Button Name="MarkEndBtn" Classes="Primary" Content="MARK END" MinWidth="90" ToolTip.Tip="Mark the end of your clip"/>
                    </StackPanel>
                </Grid>

                <!-- ROW 4: Speed presets + slider -->
                <Grid Grid.Row="4" Margin="0,10,0,0">

                    <!-- Center: Speed presets + slider -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                        <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="SPEED" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center" />
                            <controls:SpinningWheelSlider Name="PendingSpeedSlider" IsEnabled="True" MinWidth="160" MaxWidth="300" Height="35" Cursor="Hand" ToolTip.Tip="Precise speed for the active segment" />
                            <TextBlock Name="PendingSpeedLabel" Text="1.1x" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-2,0,0" />
                        </StackPanel>
                        <!-- Speed preset buttons — two rows with vertical gap -->
                        <StackPanel Name="SpeedPresetsPanel" Classes="SpeedPresetRows" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,0,0">
                            <!-- Row 1: 0.1x – 1.0x -->
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <Button Name="SpeedPreset01" Classes="SpeedPreset" Content="0.1x" ToolTip.Tip="Set speed to 0.1x"/>
                                <Button Name="SpeedPreset10" Classes="SpeedPreset" Content="1.0x" ToolTip.Tip="Set speed to normal (1.0x)"/>
                                <Button Name="SpeedPresetBase" Classes="SpeedPreset BaseSpeedPreset" Content="1.1x" ToolTip.Tip="Set speed to 1.1x"/>
                            </StackPanel>
                            <!-- Row 2: 2.0x – 4.0x -->
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <Button Name="SpeedPreset20" Classes="SpeedPreset" Content="2.0x" ToolTip.Tip="Set speed to 2.0x"/>
                                <Button Name="SpeedPreset30" Classes="SpeedPreset" Content="3.0x" ToolTip.Tip="Set speed to 3.0x"/>
                                <Button Name="SpeedPreset40" Classes="SpeedPreset" Content="4.0x" ToolTip.Tip="Set speed to 4.0x"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- RIGHT: Segments List -->
            <Border Grid.Column="1" Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0" Padding="12">
                <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">
                    <!-- Header: title + Help button (#8) -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,5">
                        <TextBlock Grid.Column="0" Text="SPEED SEGMENTS" Foreground="{DynamicResource AppAccentBrush}" FontSize="{DynamicResource AppFontSize13}" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Name="HelpButton" Content="?" MinWidth="24" MinHeight="24" Padding="0" FontWeight="Bold" Classes="Secondary" ToolTip.Tip="New here? Click for simple step-by-step help."/>
                    </Grid>
                    <TextBlock Grid.Row="1" Name="SegmentCountLabel" Text="No segments" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize11}" Margin="0,0,0,8"/>
                    <!-- #6 Colour legend: what the block colours mean (matches GetSegmentOverlayColor) -->
                    <Border Grid.Row="2" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="4" Padding="8,6" Margin="0,0,0,10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="WHAT THE COLOURS MEAN" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize9}" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="14" Height="14" CornerRadius="3" Background="{DynamicResource AppSuccessBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Green = faster than normal" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize9}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="14" Height="14" CornerRadius="3" Background="{DynamicResource AppSpeedSlowBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Red = slower than normal" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize9}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="14" Height="14" CornerRadius="3" Background="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Blue = frozen (still) frame" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize9}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Brighter colour = stronger effect." Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize9}" FontStyle="Italic" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel Name="SegmentsPanel" Spacing="2"/>
                    </ScrollViewer>
                    <StackPanel Grid.Row="4" Orientation="Vertical" Spacing="8" Margin="0,15,0,0" HorizontalAlignment="Stretch">
                        <Button Name="DeleteSegmentBtn" Classes="Secondary" Content="DELETE SEGMENT" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="False" ToolTip.Tip="Delete the currently selected speed segment"/>
                        <Button Name="ClearAllSegmentsBtn" Classes="Danger" Content="CLEAR ALL SEGMENTS" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="False" ToolTip.Tip="Remove all speed segments"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM NAVIGATION -->
        <Border Grid.Row="1" Background="{DynamicResource AppSurfaceBrush}" Padding="16,10" BorderBrush="{DynamicResource AppPanelBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Name="BottomStatusLabel"
                           Text="Set speed, then press MARK END to create a segment. Start is auto-inferred."
                           Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize11}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Name="CancelGranularBtn" Classes="Secondary" Content="CANCEL" MinWidth="90" ToolTip.Tip="Discard changes and close"/>
                    <Button Name="AcceptGranularBtn" Classes="Success" Content="APPLY" MinWidth="90" ToolTip.Tip="Apply all speed segments and return"/>
                </StackPanel>
            </Grid>
        </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- #8 Help overlay: plain-English visual tutorial -->
        <Grid Name="HelpOverlay" IsVisible="False" ZIndex="10000" Background="{DynamicResource AppOverlayBrush}">
            <Border Name="HelpCard" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="2" CornerRadius="14" MaxWidth="600" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26">
                <StackPanel Spacing="15">
                    <TextBlock Text="How the Speed Editor Works" FontSize="{DynamicResource AppFontSize20}" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center"/>
                    
                    <Border Background="{DynamicResource AppPanelBrush}" CornerRadius="8" Padding="20" MinHeight="200" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                            <Path Fill="{DynamicResource AppAccentBrush}" Width="48" Height="48" Stretch="Uniform" Data="M10,9V5L3,12l7,7v-4.1c5,0,8.5,1.6,11,5.1c-1-5-4-10-11-11z" />
                            <TextBlock Text="[ Interactive Timeline Tutorial Animation ]" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize14}" FontStyle="Italic" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="1. MARK START and MARK END to select a piece of video." Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize12}" />
                    <TextBlock Text="2. Drag the colored blocks on the timeline to adjust their edges." Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize12}" />
                    <TextBlock Text="3. Select a block to change its speed, freeze it, or zoom in." Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize12}" />

                    <Button Name="HelpCloseButton" Content="GOT IT" Classes="Primary" HorizontalAlignment="Center" MinWidth="140" Margin="0,20,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>

</Window>
