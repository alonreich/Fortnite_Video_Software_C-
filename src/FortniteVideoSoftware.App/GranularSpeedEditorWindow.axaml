<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:CompileBindings="True"
        xmlns:local="clr-namespace:FortniteVideoSoftware.App"
        x:Class="FortniteVideoSoftware.App.GranularSpeedEditorWindow"
        Title="Granular Speed Editor"
        Width="1050" Height="720"
        Background="#0f172a"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30">


    <Grid>
        <Border Name="MainBorder" Background="#0f172a" CornerRadius="0" Padding="0" BorderBrush="Gray" BorderThickness="5">
            <Grid RowDefinitions="30, *">
                <Border Name="TitleBarBorder" Grid.Row="0" Background="Gray">
                    <TextBlock Name="TitleBarText" Text="{Binding $parent[Window].Title}" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold" FontSize="14" IsHitTestVisible="False" />
                </Border>
                <Grid Grid.Row="1" RowDefinitions="Auto, *, Auto">

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#1e293b" Padding="16,12" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="2">
                    <TextBlock Text="&#x26A1; GRANULAR SPEED EDITOR" Foreground="#60a5fa" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Name="VideoFileLabel" Text="No video loaded" Foreground="#64748b" FontSize="11"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Name="StatusLabel" Text="" Foreground="#22c55e" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- MAIN BODY -->
        <Grid Grid.Row="1" ColumnDefinitions="*">

            <!-- LEFT: Video preview + timeline -->
            <Grid Grid.Column="0" RowDefinitions="*, Auto, Auto, Auto" Margin="12">

                <!-- Video preview -->
                <Border Grid.Row="0" Background="Black" CornerRadius="6" ClipToBounds="True">
                    <Grid>
                        <local:MpvVideoView Name="GranularVideoHost"/>
                        <Border Name="GranularFeedback" Background="#22eab308" BorderBrush="#eab308" BorderThickness="1" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Padding="20,10" CornerRadius="8" IsVisible="False">
                            <TextBlock Name="GranularFeedbackText" Text="" Foreground="#fde047" FontSize="18" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Timeline -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="10,10,10,0">
                    <TextBlock Name="GranularTimeElapsed" Text="00:00:00" Foreground="White" VerticalAlignment="Center" Width="60" />
                    <Grid Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                        <Slider Name="GranularTimeline" Minimum="0" Maximum="1000" Cursor="Hand" Height="20" MinHeight="20" VerticalAlignment="Center" ToolTip.Tip="Drag to scrub through the video" />
                        <Canvas Name="GranularTimelineCanvas" IsHitTestVisible="False" ZIndex="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="20"/>
                    </Grid>
                    <TextBlock Grid.Column="2" Name="GranularDuration" Text="00:00:00" Foreground="White" VerticalAlignment="Center" Width="60" TextAlignment="Right" />
                </Grid>

                <!-- Playback controls -->
                <Grid Grid.Row="2" Margin="0,15,0,10">
                    <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <ToggleButton Name="FreezeFrameCheck" Classes="Primary" Content="📸 FREEZE FRAME" Width="130" Height="32" FontSize="10" ToolTip.Tip="Set speed to 0 for a freeze frame" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Name="MarkStartBtn" Classes="Primary" Content="MARK START" Width="90" Height="32" FontSize="10" Margin="0,0,30,0" ToolTip.Tip="Mark the beginning of your clip"/>
                        <Button Name="GranularPlayPause" Classes="Success" Content="||" Width="70" Height="32" FontSize="15" FontWeight="Black" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Play or pause the video" Margin="0,0,30,0"/>
                        <Button Name="MarkEndBtn" Classes="Primary" Content="MARK END" Width="90" Height="32" FontSize="10" ToolTip.Tip="Mark the end of your clip"/>
                    </StackPanel>
                </Grid>

                <!-- Bottom Row -->
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Name="ClearAllSegmentsBtn" Classes="Danger" Content="CLEAR ALL SEGMENTS" Width="140" Height="32" FontSize="10" ToolTip.Tip="Remove all speed segments"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Speed:" Foreground="#94a3b8" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider Name="PendingSpeedSlider" Minimum="0.1" Maximum="4.0" Value="1.1" TickFrequency="0.05" IsSnapToTickEnabled="True" IsEnabled="True" Width="200" VerticalAlignment="Center"/>
                        <TextBlock Name="PendingSpeedLabel" Text="1.10x" Foreground="#f59e0b" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" Width="45" TextAlignment="Right" Margin="10,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- BOTTOM NAVIGATION -->
        <Border Grid.Row="2" Background="#1e293b" Padding="16,10" BorderBrush="#334155" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Name="BottomStatusLabel"
                           Text="Set speed, then press MARK END to create a segment. Start is auto-inferred."
                           Foreground="#64748b" FontSize="11" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Name="CancelGranularBtn" Classes="Danger" Content="CANCEL" Width="100" Height="42" FontSize="13" ToolTip.Tip="Discard changes and close"/>
                    <Button Name="AcceptGranularBtn" Classes="Success" Content="APPLY" Width="120" Height="42" FontSize="13" ToolTip.Tip="Apply all speed segments and return"/>
                </StackPanel>
            </Grid>
        </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

