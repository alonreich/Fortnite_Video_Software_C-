<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:CompileBindings="True"
        xmlns:local="clr-namespace:FortniteVideoSoftware.App"
        xmlns:controls="clr-namespace:FortniteVideoSoftware.App.Controls"
        x:Class="FortniteVideoSoftware.App.GranularSpeedEditorWindow"
        Title="Granular Speed Editor"
        Background="{DynamicResource AppSurfaceBrush}"
        MinWidth="900" MinHeight="600"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        WindowStartupLocation="Manual">

    <Grid>
        <Border Name="MainBorder" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="0" Padding="0" BorderBrush="{DynamicResource WindowTitleBorder}" BorderThickness="5">
            <Grid RowDefinitions="30, *">
                <Border Name="TitleBarBorder" Grid.Row="0" Background="{DynamicResource TitleBarBackground}">
                    <TextBlock Name="TitleBarText" Classes="WindowTitleText" Text="{Binding $parent[Window].Title}" Foreground="{DynamicResource TitleBarForeground}" />
                </Border>
                <Grid Grid.Row="1" RowDefinitions="*, Auto">

        <!-- MAIN BODY -->
        <Grid Grid.Row="0" ColumnDefinitions="*, 280">

            <!-- LEFT: Video preview + timeline -->
            <Grid Grid.Column="0" RowDefinitions="*, Auto, Auto, Auto" Margin="12">

                <!-- Video preview -->
                <Border Name="GranularVideoAreaBorder" Grid.Row="0" Background="Black" CornerRadius="6" ClipToBounds="True">
                    <Grid>
                        <local:MpvVideoView Name="GranularVideoHost" ZIndex="0"/>
                        <Popup Name="FreezeValidationPopup" IsOpen="False" Placement="Center" IsHitTestVisible="False" ZIndex="11">
                            <Border Name="FreezeValidationBorder" Background="{DynamicResource AppOverlayBrush}" BorderBrush="{DynamicResource AppWarningBrush}" BorderThickness="2" CornerRadius="6" Padding="16,10">
                                <TextBlock Name="FreezeValidationText" Text="SELECT FREEZE DURATION" FontSize="16" Foreground="{DynamicResource AppWarningBrush}" FontWeight="Bold" HorizontalAlignment="Center" />
                            </Border>
                        </Popup>
                        <Popup Name="GranularFeedbackPopup" IsOpen="False" Placement="Bottom"
                               HorizontalOffset="0" VerticalOffset="-80" IsLightDismissEnabled="False"
                               IsHitTestVisible="False" ZIndex="11">
                            <Border Name="GranularFeedbackPopupBorder" Background="{DynamicResource AppOverlayBrush}" BorderBrush="{DynamicResource AppWarningBrush}" BorderThickness="1" CornerRadius="8" Padding="24,12" Opacity="0">
                                <TextBlock Name="GranularFeedbackPopupText" Text="" Foreground="{DynamicResource AppWarningBrush}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
                            </Border>
                        </Popup>
                    </Grid>
                </Border>

                <!-- Timeline -->
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="10,10,10,15" VerticalAlignment="Center" ClipToBounds="False">
                    <TextBlock Name="GranularTimeElapsed" Text="00:00:00" Foreground="White" VerticalAlignment="Center" Width="64" FontSize="10" Margin="0,0,8,0" />
                    <Grid Grid.Column="1" VerticalAlignment="Center" MinHeight="46" ClipToBounds="False">
                        <StackPanel Orientation="Vertical">
                            <Canvas Name="GranularTimelineScaleCanvas" IsHitTestVisible="False" ClipToBounds="False" HorizontalAlignment="Stretch" Height="14" ZIndex="10000" />
                            <Grid Height="32" ClipToBounds="False" ZIndex="10001">
                                <Slider Name="GranularTimeline" Classes="CompactSlider" Minimum="0" Maximum="1000" Height="44" MinHeight="44" VerticalAlignment="Center" ClipToBounds="False" ZIndex="10002" ToolTip.Tip="Drag to scrub through the video" />
                                <Canvas Name="GranularTimelineCanvas" IsHitTestVisible="True" ClipToBounds="False" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="32" ZIndex="10003" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Column="2" Name="GranularDuration" Text="-00:00:00" Foreground="White" VerticalAlignment="Center" Width="64" TextAlignment="Right" FontSize="10" Margin="8,0,0,0" />
                </Grid>

                <!-- Playback controls -->
                <Grid Grid.Row="2" Margin="0,5,0,10">
                    <StackPanel Orientation="Vertical" Spacing="5" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Name="FreezeImageToggle" Classes="Primary" Width="140" ToolTip.Tip="Freeze frame at current playhead">
                            <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Fill="White" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" RenderTransform="translateY(5px)" Data="M 2,6 L 4,6 L 5,4 L 11,4 L 12,6 L 14,6 Q 15,6 15,7 L 15,12 Q 15,13 14,13 L 2,13 Q 1,13 1,12 L 1,7 Q 1,6 2,6 Z M 8,7.5 A 2.5,2.5 0 1,0 8,12.5 A 2.5,2.5 0 1,0 8,7.5" />
                                <TextBlock Name="FreezeImageToggleText" Text=" FREEZE IMAGE " FontSize="9" VerticalAlignment="Center" Margin="6,0,6,0" />
                                <Path Fill="White" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" RenderTransform="translateY(5px)" Data="M 2,6 L 4,6 L 5,4 L 11,4 L 12,6 L 14,6 Q 15,6 15,7 L 15,12 Q 15,13 14,13 L 2,13 Q 1,13 1,12 L 1,7 Q 1,6 2,6 Z M 8,7.5 A 2.5,2.5 0 1,0 8,12.5 A 2.5,2.5 0 1,0 8,7.5" />
                            </StackPanel>
                        </Button>
                        <TextBlock Name="FreezeHintLabel" Text="👇 PICK FREEZE TIME" Foreground="{DynamicResource AppWarningBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,2" IsVisible="False">
                            <TextBlock.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.6"/>
                                </Transitions>
                            </TextBlock.Transitions>
                        </TextBlock>
                        <StackPanel Name="FreezePresetsPanel" Classes="SpeedPresetRows" Orientation="Vertical" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <Button Name="FreezePreset05" Classes="SpeedPreset" Content="0.5s" ToolTip.Tip="Freeze frame for 0.5 seconds"/>
                                <Button Name="FreezePreset10" Classes="SpeedPreset" Content="1.0s" ToolTip.Tip="Freeze frame for 1.0 seconds"/>
                                <Button Name="FreezePreset15" Classes="SpeedPreset" Content="1.5s" ToolTip.Tip="Freeze frame for 1.5 seconds"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" Margin="0,3,0,0">
                                <Button Name="FreezePreset20" Classes="SpeedPreset" Content="2.0s" ToolTip.Tip="Freeze frame for 2.0 seconds"/>
                                <Button Name="FreezePreset25" Classes="SpeedPreset" Content="2.5s" ToolTip.Tip="Freeze frame for 2.5 seconds"/>
                                <Button Name="FreezePreset30" Classes="SpeedPreset" Content="3.0s" ToolTip.Tip="Freeze frame for 3.0 seconds"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Name="FreezeHintLabelBottom" Text="☝ PICK FREEZE TIME" Foreground="{DynamicResource AppWarningBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,2" IsVisible="False">
                            <TextBlock.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.6"/>
                                </Transitions>
                            </TextBlock.Transitions>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Name="MarkStartBtn" Classes="Primary" Content="MARK START" Width="90" Margin="0,0,30,0" ToolTip.Tip="Mark the beginning of your clip"/>
                        <Button Name="GranularPlayPause" Classes="Success" Width="70" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="Play or Pause" ToolTip.Tip="Play or pause the video" Margin="0,0,30,0">
                            <Panel Width="16" Height="16">
                                <Polygon Name="PlayIcon" Points="3,1 14,8 3,15" Fill="White"/>
                                <StackPanel Name="PauseIcon" IsVisible="False" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Rectangle Width="4" Height="14" Fill="White"/>
                                    <Rectangle Width="4" Height="14" Fill="White"/>
                                </StackPanel>
                            </Panel>
                        </Button>
                        <Button Name="MarkEndBtn" Classes="Primary" Content="MARK END" Width="90" ToolTip.Tip="Mark the end of your clip"/>
                    </StackPanel>
                </Grid>

                <!-- Bottom Row: Speed presets + slider + Clear All -->
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <!-- Right side: Delete buttons stacked vertically -->
                    <StackPanel Orientation="Vertical" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Name="DeleteSegmentBtn" Classes="Danger" Content="DELETE SEGMENT" Width="140" IsVisible="False" ToolTip.Tip="Delete the currently selected speed segment"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding #ClearAllSegmentsBtn.IsVisible}">
                            <TextBlock Text="⚠️ This cannot be undone" Foreground="{DynamicResource AppWarningBrush}" FontSize="9" VerticalAlignment="Center" />
                            <Button Name="ClearAllSegmentsBtn" Classes="Danger" Content="CLEAR ALL SEGMENTS" Width="140" ToolTip.Tip="Remove all speed segments"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: Speed presets + slider -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                        <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="SPEED" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                            <controls:SpinningWheelSlider Name="PendingSpeedSlider" IsEnabled="True" Width="160" Height="35" Cursor="Hand" ToolTip.Tip="Precise speed for the active segment" />
                            <TextBlock Name="PendingSpeedLabel" Text="1.1x" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-2,0,0" />
                        </StackPanel>
                        <!-- Speed preset buttons — two rows with vertical gap -->
                        <StackPanel Name="SpeedPresetsPanel" Classes="SpeedPresetRows" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,0,0">
                            <!-- Row 1: 0.1x – 1.0x -->
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <Button Name="SpeedPreset01" Classes="SpeedPreset" Content="0.1x" ToolTip.Tip="Set speed to 0.1x"/>
                                <Button Name="SpeedPreset10" Classes="SpeedPreset" Content="1.0x" ToolTip.Tip="Set speed to normal (1.0x)"/>
                                <Button Name="SpeedPresetBase" Classes="SpeedPreset BaseSpeedPreset" Content="1.1x" ToolTip.Tip="Set speed to 1.1x"/>
                            </StackPanel>
                            <!-- Row 2: 2.0x – 4.0x -->
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <Button Name="SpeedPreset20" Classes="SpeedPreset" Content="2.0x" ToolTip.Tip="Set speed to 2.0x"/>
                                <Button Name="SpeedPreset30" Classes="SpeedPreset" Content="3.0x" ToolTip.Tip="Set speed to 3.0x"/>
                                <Button Name="SpeedPreset40" Classes="SpeedPreset" Content="4.0x" ToolTip.Tip="Set speed to 4.0x"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- RIGHT: Segments List -->
            <Border Grid.Column="1" Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0" Padding="12">
                <Grid RowDefinitions="Auto, Auto, *">
                    <TextBlock Grid.Row="0" Text="SPEED SEGMENTS" Foreground="{DynamicResource AppAccentBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="1" Name="SegmentCountLabel" Text="No segments" Foreground="#94a3b8" FontSize="11" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Name="SegmentsPanel" Spacing="2"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM NAVIGATION -->
        <Border Grid.Row="1" Background="{DynamicResource AppSurfaceBrush}" Padding="16,10" BorderBrush="{DynamicResource AppPanelBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Name="BottomStatusLabel"
                           Text="Set speed, then press MARK END to create a segment. Start is auto-inferred."
                           Foreground="#94a3b8" FontSize="11" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Name="CancelGranularBtn" Classes="Secondary" Content="CANCEL" Width="90" ToolTip.Tip="Discard changes and close"/>
                    <Button Name="AcceptGranularBtn" Classes="Success" Content="APPLY" Width="90" ToolTip.Tip="Apply all speed segments and return"/>
                </StackPanel>
            </Grid>
        </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>

</Window>
