<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:CompileBindings="True"
        xmlns:local="clr-namespace:FortniteVideoSoftware.App"
        x:Class="FortniteVideoSoftware.App.AdvancedVideoEditorWindow"
        Title="Fortnite Advanced Video Editor"
        Width="1280" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#1e293b"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30">

    <!-- Spec 5: Dynamic Interaction Shrink — 4px resting rail expands on hover;
         ExpandLayer (ticks/thumb/markers) is opacity-gated, never clipped. -->
    <Window.Styles>
        <Style Selector="Border.TimelineOverlay">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Height" Duration="0:0:0.22" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.TimelineOverlay:pointerover">
            <Setter Property="Height" Value="52"/>
        </Style>
        <Style Selector="Panel.TimelineExpandLayer">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.TimelineOverlay:pointerover Panel.TimelineExpandLayer">
            <Setter Property="Opacity" Value="1"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Border Name="MainBorder" Background="#1e293b" CornerRadius="0" Padding="0" BorderBrush="{DynamicResource WindowTitleBorder}" BorderThickness="5">
            <Grid RowDefinitions="30, *">

                <!-- Title Bar -->
                <Border Name="TitleBarBorder" Grid.Row="0" Background="{DynamicResource TitleBarBackground}" IsHitTestVisible="False">
                    <TextBlock Classes="WindowTitleText" Text="{Binding $parent[Window].Title}" Foreground="{DynamicResource TitleBarForeground}" />
                </Border>

                <Grid Grid.Row="1" RowDefinitions="Auto,*" ColumnDefinitions="300,*,300">
                    <!-- Top Menu Bar -->
                    <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#1e293b" Height="42" BorderBrush="#334155" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Spacing="15" Margin="10,0" VerticalAlignment="Center">
                            <Button Name="ReturnButton" Content="RETURN TO COMPRESSOR" Classes="Primary" Height="32" FontSize="9"/>
                            <Button Name="ExportButton" Content="EXPORT VIDEO" Classes="Primary" Height="32" FontSize="9" Background="DarkRed"/>
                            <TextBlock Text="ADVANCED TIMELINE EDITOR" VerticalAlignment="Center" Foreground="#94a3b8" FontWeight="Bold" FontSize="12" Margin="20,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Media Pool (Left) -->
                    <Border Grid.Row="1" Grid.Column="0" Background="#1e293b" BorderBrush="#334155" BorderThickness="0,0,1,0" DragDrop.AllowDrop="True" Name="MediaPoolBorder">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Grid.Row="0" Text="MEDIA POOL" Foreground="#94a3b8" FontWeight="Bold" Margin="10" FontSize="13"/>
                            <ListBox Grid.Row="1" Name="MediaPoolList" Background="Transparent" Foreground="White" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:MediaItem">
                                        <Border Background="#334155" CornerRadius="4" Padding="5" Margin="0,0,0,5">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="40" Height="25" Background="Black" CornerRadius="2" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" Foreground="White" TextTrimming="CharacterEllipsis" Width="200"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Video Preview (Center) -->
                    <Border Grid.Row="1" Grid.Column="1" Background="Black" Margin="10" CornerRadius="6">
                        <Grid>
                            <TextBlock Text="MPV PREVIEW HOST" Foreground="#94a3b8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                        </Grid>
                    </Border>

                    <!-- Inspector (Right) -->
                    <Border Grid.Row="1" Grid.Column="2" Background="#1e293b" BorderBrush="#334155" BorderThickness="1,0,0,0">
                        <StackPanel Margin="10">
                            <TextBlock Text="INSPECTOR" Foreground="#94a3b8" FontWeight="Bold" Margin="0,0,0,10" FontSize="13"/>
                            <TextBlock Text="Select a clip to view properties." Foreground="#94a3b8" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ─────────────────────────────────────────────────────────────────────
                     PREMIUM X-AXIS TIMELINE OVERLAY
                     ─────────────────────────────────────────────────────────────────────
                     Spec 1: Z-Index Domination (9999) — floats above every sibling.
                     Spec 2: Edge-to-edge, zero padding/margin, bottom-anchored stretch.
                     Spec 3: ClipToBounds=False on every parent so nothing is truncated.
                     Spec 4: ExperimentalAcrylicBorder frosted-glass backdrop.
                     Spec 5: 4px resting rail expands to 52px on :pointerover.
                     Spec 6: Tick canvas + slider merged into the same grid cell.
                     Spec 7: Markers canvas placed AFTER the slider (strictly on top).
                     Spec 8: Magnetic time pill translated by code-behind.
                     Spec 9: DropShadow glow on Start/End markers.
                     ───────────────────────────────────────────────────────────────────── -->
                <!-- Hidden clip-lane host preserves old dummy clip rendering state without
                     interfering with the new scrubber overlay. -->
                <Canvas Name="TimelineCanvas" ClipToBounds="False" IsHitTestVisible="False" IsVisible="False"/>

                <Panel Name="TimelineRoot" Grid.Row="1" ZIndex="9999"
                       HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                       Margin="0" ClipToBounds="False"
                       DragDrop.AllowDrop="True">

                    <Border Name="TimelineContainer" Classes="TimelineOverlay"
                            HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                            Padding="0" Margin="0" ClipToBounds="False"
                            DragDrop.AllowDrop="True">
                        <Grid ClipToBounds="False">

                            <!-- Spec 4: Frosted-glass material (non-interactive so it never blocks the slider) -->
                            <ExperimentalAcrylicBorder ClipToBounds="False" IsHitTestVisible="False">
                                <ExperimentalAcrylicBorder.Material>
                                    <ExperimentalAcrylicMaterial BackgroundSource="Digger"
                                                                 TintColor="#0f172a"
                                                                 TintOpacity="0.55"
                                                                 MaterialOpacity="0.60"
                                                                 FallbackColor="#1e293b"/>
                                </ExperimentalAcrylicBorder.Material>
                            </ExperimentalAcrylicBorder>

                            <!-- Always-visible accent rail (this is the 4px resting bar) -->
                            <Border VerticalAlignment="Bottom" Height="3" ClipToBounds="False"
                                    Background="#22c55e" Opacity="0.85" IsHitTestVisible="False"/>

                            <!-- Expandable layer: hidden at rest (Opacity 0), revealed on hover; never clipped -->
                            <Panel Name="TimelineExpandLayer" Classes="TimelineExpandLayer"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                   Height="48" ClipToBounds="False">
                                <Grid ClipToBounds="False">

                                    <!-- Spec 6 (top): time-scale ticks share the same row as the slider -->
                                    <Canvas Name="TimelineScaleCanvas" ClipToBounds="False"
                                            VerticalAlignment="Top" Height="14" IsHitTestVisible="False"/>

                                    <!-- Spec 6 (bottom): interactive scrub slider, same grid cell -->
                                    <Slider Name="TimelineSlider" Minimum="0" Maximum="100" Value="0"
                                            VerticalAlignment="Bottom" Margin="0,0,0,2"
                                            ToolTip.Tip="Scrub through the timeline"/>

                                    <!-- Spec 7: Markers canvas declared AFTER the slider so it renders strictly above it -->
                                    <Canvas Name="TimelineMarkersCanvas" ClipToBounds="False"
                                            VerticalAlignment="Stretch" IsHitTestVisible="False">

                                        <!-- Spec 9: Energetic marker glow via DropShadowEffect -->
                                        <Rectangle Name="StartMarker" Width="3" Height="44" Fill="#22c55e">
                                            <Rectangle.Effect>
                                                <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="14" Color="#22c55e" Opacity="0.95"/>
                                            </Rectangle.Effect>
                                        </Rectangle>
                                        <Rectangle Name="EndMarker" Width="3" Height="44" Fill="#ef4444">
                                            <Rectangle.Effect>
                                                <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="14" Color="#ef4444" Opacity="0.95"/>
                                            </Rectangle.Effect>
                                        </Rectangle>

                                        <!-- Spec 8: Magnetic time pill (positioned continuously by code-behind) -->
                                        <Border Name="TimePill" IsHitTestVisible="False" Opacity="0"
                                                CornerRadius="8" Background="#cc0f172a" ClipToBounds="False"
                                                BorderBrush="#38bdf8" BorderThickness="1" Padding="6,2">
                                            <TextBlock Name="TimePillText" Text="00:00" Foreground="#e2e8f0"
                                                       FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Canvas>
                                </Grid>
                            </Panel>
                        </Grid>
                    </Border>
                </Panel>
            </Grid>
        </Border>
    </Grid>
</Window>
