<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:CompileBindings="True"
        x:Class="FortniteVideoSoftware.App.DeploymentProgressWindow"
        Title="Fortnite Video Software Setup"
        Width="720" Height="480"
        MinWidth="560" MinHeight="360"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="0"
        Background="{DynamicResource AppSurfaceBrush}"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        CanResize="True">
    <!-- ISSUE_01: window has no OS title bar; the background surface is the drag handle -->
    <Border Background="{DynamicResource AppSurfaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource AppInfoBrush}" BorderThickness="2" Margin="8" PointerPressed="OnRootPointerPressed">
        <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">
            <TextBlock Name="TitleText"
                       Grid.Row="0"
                       Text="Installing Fortnite Video Software"
                       Foreground="{DynamicResource AppInfoBrush}"
                       FontSize="{DynamicResource AppFontSize20}"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>
            <TextBlock Name="LogPathText"
                       Grid.Row="1"
                       Text=""
                       Foreground="{DynamicResource AppTextMutedBrush}"
                       FontSize="{DynamicResource AppFontSize11}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>
            <TextBox Name="LogTextBox" Watermark="Waiting for log output..."
                     Grid.Row="2"
                     Background="{DynamicResource AppSurfaceBrush}"
                     BorderThickness="0"
                     Foreground="{DynamicResource AppTextPrimaryBrush}"
                     FontFamily="Consolas,Courier New,monospace"
                     FontSize="{DynamicResource AppFontSize12}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Padding="8" />
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,12,0,4">
                <TextBlock Name="PhaseText"
                           Text="Initializing..."
                           Foreground="{DynamicResource AppTextMutedBrush}"
                           FontSize="{DynamicResource AppFontSize12}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Name="PercentageText"
                           Grid.Column="1"
                           Text="0%"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
            </Grid>
            <ProgressBar Name="ProgressBar"
                         Grid.Row="4"
                         Height="16"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Foreground="{DynamicResource AppInfoBrush}"
                         Background="{DynamicResource AppPanelBrush}"
                         Margin="0,0,0,12"/>
            <Button Name="FinishButton"
                    Grid.Row="5"
                    Classes="Success"
                    Content="Finish"
                    HorizontalAlignment="Center"
                    MinWidth="120"
                    IsVisible="False"
                    FontWeight="Bold"
                    ToolTip.Tip="Complete setup and launch the application"
                    Click="OnFinishClick"/>
        </Grid>
    </Border>
</Window>