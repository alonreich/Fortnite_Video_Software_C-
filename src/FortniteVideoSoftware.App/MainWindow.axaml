<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:CompileBindings="True"
        xmlns:local="clr-namespace:FortniteVideoSoftware.App"
        xmlns:controls="clr-namespace:FortniteVideoSoftware.App.Controls"
        x:Class="FortniteVideoSoftware.App.MainWindow"
        Title="Fortnite Video Software"
        Width="1200" Height="800"
        Background="#1e293b"
        MinWidth="800" MinHeight="600"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        DragDrop.AllowDrop="True">

    <Grid>
        <Border Name="MainBorder" Background="#1e293b" CornerRadius="0" Padding="0" BorderBrush="{DynamicResource WindowTitleBorder}" BorderThickness="5">
            <Grid RowDefinitions="30, *">
                <!-- Issue #5: Title bar bound to shared resource tokens -->
                <Border Name="TitleBarBorder" Grid.Row="0" Background="{DynamicResource TitleBarBackground}">
                    <TextBlock Name="TitleBarText" Classes="WindowTitleText" Text="{Binding $parent[Window].Title}" Foreground="{DynamicResource TitleBarForeground}" />
                </Border>
                <Grid Grid.Row="1" ColumnDefinitions="*, 170">
        <!-- LEFT COLUMN: Player & Editing Controls -->
        <Grid Grid.Column="0" RowDefinitions="*, Auto" ClipToBounds="False">

            <!-- Video Player Area with overlaid timeline.
                 Right margin removed so the volume frame sits flush against the right pane (no gap). -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="10,10,0,10" ClipToBounds="False">
                <!-- Video Border contains the video, overlays, and the floating timeline -->
                <Border Name="VideoAreaBorder" Grid.Column="0" Background="Black" CornerRadius="6" ClipToBounds="False" Padding="2" DragDrop.AllowDrop="True">
                    <Grid ClipToBounds="False">
                        <!-- MpvVideoView: bottom margin leaves room for the overlaid timeline
                             so the native HWND does not cover the Avalonia timeline controls -->
                        <local:MpvVideoView Name="VideoHost" IsVisible="False" Margin="0,0,0,52" />

                        <!-- Portrait Dimming Grid (kept for structure; actual dim rendered
                             via MPV vf drawbox so it is visible above the native video surface) -->
                        <Grid Name="PortraitDimmingGrid" IsVisible="False" Margin="0,0,0,52">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="4*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#66000000" />
                            <Border Grid.Column="1" Background="Transparent" />
                            <Border Grid.Column="2" Background="#66000000" />
                        </Grid>

                        <!-- Upload Video Overlay -->
                        <Border Name="UploadOverlay" Background="#cc1e293b" CornerRadius="6" ClipToBounds="False">
                            <Grid ClipToBounds="False">
                                <Grid Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Rectangle Stroke="#64748b" StrokeThickness="2" StrokeDashArray="6,4" RadiusX="8" RadiusY="8" Fill="#1a2536" Opacity="0.8" />
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Margin="60,40">
                                        <TextBlock Text="Drag &amp; Drop video file here" Foreground="#94a3b8" FontSize="14" HorizontalAlignment="Center" />
                                        <TextBlock Text="Upload Video File to begin!" Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <Button Name="CenterUploadButton" Classes="Primary" Content="BROWSE VIDEO" Width="200" Cursor="Hand" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <!-- Settings Button -->
                                <Button Name="SettingsOverlayBtn" Classes="Primary" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30" Cursor="Hand" ToolTip.Tip="Open Settings and Key Binds">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="SETTINGS" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Timeline overlay: floats at the bottom of the video border.
                             The MpvVideoView has Margin="0,0,0,52" so the native HWND
                             does not extend into this strip, keeping the Avalonia controls visible. -->
                        <Border Name="TimelineOverlay" IsVisible="False" VerticalAlignment="Bottom" Height="72" Background="Transparent" ZIndex="9999" Cursor="Hand" ClipToBounds="False">
                            <Border VerticalAlignment="Bottom" Background="#B3000000" Padding="8,0,8,3" Height="52" ClipToBounds="False">
                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" ClipToBounds="False">
                                    <TextBlock Name="TimeElapsed" Text="00:00:00" Foreground="White" VerticalAlignment="Center" Width="64" FontSize="10" Margin="0,0,8,0" />
                                    <Grid Grid.Column="1" VerticalAlignment="Center" MinHeight="46" RowDefinitions="14,32" ClipToBounds="False">
                                        <Canvas Name="TimelineScaleCanvas" Grid.Row="0" IsHitTestVisible="False" ClipToBounds="False" HorizontalAlignment="Stretch" Height="14" ZIndex="10000" />
                                        <Grid Grid.Row="1" Height="32" ClipToBounds="False" ZIndex="10001">
                                            <Slider Name="TimelineSlider" Classes="TimelineSlider CompactSlider" Minimum="0" Maximum="100" Height="44" MinHeight="44" VerticalAlignment="Center" ClipToBounds="False" ZIndex="10002" RenderTransform="translateY(-10px)" ToolTip.Tip="Drag to scrub through the video" />
                                            <Canvas Name="TimelineMarkersCanvas" IsHitTestVisible="True" ClipToBounds="False" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="32" ZIndex="10003" />
                                        </Grid>
                                    </Grid>
                                    <TextBlock Grid.Column="2" Name="TimeRemaining" Text="-00:00:00" Foreground="White" VerticalAlignment="Center" Width="64" TextAlignment="Right" FontSize="10" Margin="8,0,0,0" />
                                </Grid>
                            </Border>
                        </Border>

                        <!-- Tactical Feedback Popup: Avalonia Popup creates a separate native popup
                             window (WS_POPUP) that has its own z-order, guaranteeing it renders ABOVE
                             the embedded MPV HWND. This is the ONLY reliable way to show overlay text
                             on top of the native video surface on Windows. -->
                        <Popup Name="FeedbackPopup" IsOpen="False" PlacementMode="Bottom" PlacementTarget="{Binding #VideoAreaBorder}"
                               HorizontalOffset="0" VerticalOffset="-80" IsLightDismissEnabled="False"
                               IsHitTestVisible="False">
                            <Border Name="FeedbackPopupBorder" Background="#800f1b3a" BorderBrush="#FAfacc15" BorderThickness="1" CornerRadius="8" Padding="24,12" Opacity="0">
                                <TextBlock Name="FeedbackPopupText" Text="" Foreground="#facc15" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
                            </Border>
                        </Popup>
                    </Grid>
                </Border>
                <!-- Rebuilt vertical volume slider: plain default track (matches Granular Speed slider style),
                     enlarged + elongated, inside a slim clear frame (<=60px). Flush against the video border
                     (left) and the right pane (right) with no horizontal gaps. Stretches to the video height. -->
                <Border Grid.Column="1" CornerRadius="4" Background="#15202b" BorderBrush="#475569" BorderThickness="1" Padding="0,8" Width="40" VerticalAlignment="Stretch" Margin="2,0,2,0" ClipToBounds="False" ZIndex="9999">
                    <Grid RowDefinitions="Auto, *, Auto" ClipToBounds="False" HorizontalAlignment="Left" Margin="-6,0,0,0">
                        <TextBlock Grid.Row="0" Name="VolumeBadgeText" Text="100%" Foreground="#38bdf8" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="5,0,-5,6" Opacity="1" />
                        <Slider Grid.Row="1" Name="VolumeSlider" Classes="CompactSlider" Orientation="Vertical" Minimum="0" Maximum="100" Value="100" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,0,0,0" ToolTip.Tip="Adjust Master Volume" Cursor="Hand" ClipToBounds="False" ZIndex="10000" Foreground="#38bdf8" />
                        <!-- Speaker icon: enlarged 35x35 hit box on top (ZIndex 10001), centered on the
                             slider track at its bottom end. The icon Path itself is shifted 2px right and
                             made non-hit-testable so the square hit box receives all clicks/hover. -->
                        <Border Grid.Row="2" Name="SpeakerHitBox" Width="35" Height="35" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0" ZIndex="10001" Cursor="Hand" Focusable="True" ToolTip.Tip="Mute or restore volume" AutomationProperties.Name="Mute or restore volume" ClipToBounds="False">
                            <Path Name="VolumeSpeakerIcon" Fill="Transparent" Stroke="#38bdf8" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransform="translateX(2px)" IsHitTestVisible="False" Data="M3,7 L6,7 L10,3 L10,13 L6,9 L3,9 Z M13,5 A4,4 0 0,1 13,11 M16,2 A8,8 0 0,1 16,14" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Combined Trim and Process Controls Grid -->
            <Grid Grid.Row="1" RowDefinitions="Auto, Auto" Margin="10,8,10,8">
                <!-- Upper Row -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Name="SetThumbnailButton" Classes="Primary" Width="160" IsEnabled="False" ToolTip.Tip="Set current frame as the thumbnail">
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📸" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Name="SetThumbnailText" Text="SET THUMBNAIL" FontSize="9" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Name="MarkStartButton" Classes="Primary" Content="MARK START" Width="115" Margin="0,0,30,0" IsEnabled="False" ToolTip.Tip="Mark the beginning of your clip"/>
                        <!-- Drawn shapes for crisp white play/pause icons (no emoji blue tint) -->
                        <Button Name="PlayPauseButton" Classes="Success" Width="70" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsEnabled="False" AutomationProperties.Name="Play or Pause" ToolTip.Tip="Play or pause the video" Margin="0,0,30,0">
                            <Panel Width="16" Height="16">
                                <Polygon Name="PlayIcon" Points="3,1 14,8 3,15" Fill="White"/>
                                <StackPanel Name="PauseIcon" IsVisible="False" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Rectangle Width="4" Height="14" Fill="White"/>
                                    <Rectangle Width="4" Height="14" Fill="White"/>
                                </StackPanel>
                            </Panel>
                        </Button>
                        <Button Name="MarkEndButton" Classes="Primary" Content="MARK END" Width="115" IsEnabled="False" ToolTip.Tip="Mark the end of your clip"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Name="GranularButton" Classes="Primary" Content="GRANULAR SPEED" Width="120" IsEnabled="False" ToolTip.Tip="Adjust granular speed settings"/>
                    </StackPanel>
                </Grid>

                <!-- Bottom Row -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Vertical" Spacing="2" Margin="0,0,50,0" VerticalAlignment="Center">
                            <TextBlock Text="OUTPUT FILE SIZE" Foreground="#c5dcf2" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                            <!-- Issue #15: Dynamic tooltip set from code-behind depending on enabled state -->
                            <controls:SpinningWheelSlider Name="QualitySlider" IsEnabled="False" Width="180" Height="35" Cursor="Hand" ToolTip.Tip="Upload a video to set target size" />
                            <TextBlock Name="QualityLabel" Text="" Foreground="#c5dcf2" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-2,0,0" />
                        </StackPanel>

                        <!-- Issue #13: Normalize to 42px standard -->
                        <Button Name="CancelButton" Classes="Danger" Content="CANCEL" Width="125" Height="60" CornerRadius="8" IsVisible="False" ToolTip.Tip="Cancel the current operation"/>
                        <Button Name="ProcessButton" Classes="Success" Content="PROCESS" Width="125" Height="60" CornerRadius="8" IsEnabled="False" ToolTip.Tip="Render and export the final video"/>

                        <StackPanel Orientation="Vertical" Spacing="2" Margin="50,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="SPEED" Foreground="#c5dcf2" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                                    <controls:SpinningWheelSlider Name="MainSpeedSlider" IsEnabled="False" Width="180" Height="35" Cursor="Hand" ToolTip.Tip="Upload a video to set speed" />
                                    <TextBlock Name="MainSpeedLabel" Text="" Foreground="#c5dcf2" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,-2,0,0" />
                                </StackPanel>
                                <StackPanel Name="MainSpeedPresetsPanel" Classes="SpeedPresetRows" Orientation="Vertical" VerticalAlignment="Center" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <Button Name="SpeedPreset01" Classes="SpeedPreset" Content="0.1x"/>
                                        <Button Name="SpeedPreset10" Classes="SpeedPreset" Content="1.0x"/>
                                        <Button Name="SpeedPresetBase" Classes="SpeedPreset BaseSpeedPreset" Content="1.1x"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <Button Name="SpeedPreset20" Classes="SpeedPreset" Content="2.0x"/>
                                        <Button Name="SpeedPreset30" Classes="SpeedPreset" Content="3.0x"/>
                                        <Button Name="SpeedPreset40" Classes="SpeedPreset" Content="4.0x"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- RIGHT PANEL: Utility & Plugins -->
        <Border Grid.Column="1" Background="#334155" BorderBrush="#475569" BorderThickness="1,0,0,0" Padding="15">
            <Grid RowDefinitions="Auto, Auto, Auto, *, Auto, Auto, Auto">
                <Button Grid.Row="0" Name="UploadButton" Classes="Primary" Content="UPLOAD VIDEO" HorizontalAlignment="Stretch" Margin="0,0,0,15" ToolTip.Tip="Upload an MP4 or MKV video"/>
                <Button Grid.Row="1" Name="AddMusicButton" Classes="Primary" Content="ADD MUSIC" HorizontalAlignment="Stretch" Margin="0,0,0,15" IsEnabled="False" ToolTip.Tip="Add background music to the video"/>

                <TextBlock Grid.Row="2" Name="HardwareStatusLabel" Text="HW: Scanning..." Foreground="#00783C" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,15" TextWrapping="Wrap"/>

                <StackPanel Grid.Row="4" Margin="0,0,0,15" Spacing="5">
                    <Viewbox Width="140" Height="50" HorizontalAlignment="Left" Stretch="Uniform" StretchDirection="DownOnly" IsVisible="{Binding #PortraitModeCheckbox.IsChecked}">
                        <TextBox Name="PortraitTextInput" Watermark="Overlay Text" Width="140" MinHeight="50" FontSize="16" ToolTip.Tip="Custom text for the top 150px of the 1080x1920 mobile video" TextWrapping="Wrap" AcceptsReturn="True" />
                    </Viewbox>
                    <CheckBox Name="PortraitModeCheckbox" Content="Portrait (9:16)" IsChecked="True" IsEnabled="False" />
                    <CheckBox Name="BossHpCheckbox" Content="Boss HP" IsEnabled="False" />
                    <CheckBox Name="TeammatesCheckbox" Content="Show Teammates" IsEnabled="False" />
                    <CheckBox Name="NoFadeCheckbox" Content="Disable Fade-In/Out" IsEnabled="False" />
                </StackPanel>

                <Button Grid.Row="5" Name="VideoMergerButton" Classes="Primary" Content="VIDEO MERGER" HorizontalAlignment="Stretch" Margin="0,0,0,8" ToolTip.Tip="Merge multiple videos together"/>
                <Button Grid.Row="6" Name="CropSettingsButton" Classes="Primary" Content="CROP SETTINGS" HorizontalAlignment="Stretch" Margin="0,0,0,8" ToolTip.Tip="Adjust the cropping area"/>
            </Grid>
        </Border>

        <!-- Phase Overlay for export progress -->
        <controls:PhaseOverlayControl x:Name="OverlayLayer" Grid.ColumnSpan="2" IsVisible="False" />

        <!-- Overlay Canvas for Pop-up Badges and Custom Floating Animations -->
        <Canvas Name="OverlayCanvas" Grid.ColumnSpan="2" IsHitTestVisible="False" />

                </Grid>
            </Grid>
        </Border>
        <!-- Drag & Drop Airspace Override Popup -->
        <Popup Name="DragOverlayPopup" PlacementTarget="VideoAreaBorder" Placement="Center" IsOpen="False" IsHitTestVisible="True" WindowManagerAddShadowHint="False">
            <Border Background="#A0000000" BorderBrush="#FF1493" BorderThickness="3" CornerRadius="12" Padding="40" DragDrop.AllowDrop="True">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🎬" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Drop Video Here" FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
