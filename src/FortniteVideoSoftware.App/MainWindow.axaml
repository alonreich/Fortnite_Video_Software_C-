<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:CompileBindings="True"
        xmlns:local="clr-namespace:FortniteVideoSoftware.App"
        xmlns:controls="clr-namespace:FortniteVideoSoftware.App.Controls"
        x:Class="FortniteVideoSoftware.App.MainWindow"
        Title="Fortnite Video Software"
        Background="{DynamicResource AppSurfaceBrush}"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="Manual"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        DragDrop.AllowDrop="True">

    <!-- IDEA_01: gentle pulse for the hero drop icon (finite-cost, opacity-only) -->
    <Window.Styles>
        <Style Selector="Border.DropIconPulse">
            <Style.Animations>
                <Animation Duration="0:0:2.4" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.6"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1.0"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.6"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Grid>
        <Border Name="MainBorder" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="0" Padding="0" BorderBrush="{DynamicResource WindowTitleBorder}" BorderThickness="5">
            <Grid RowDefinitions="30, Auto, *">
                <Border Name="TitleBarBorder" Grid.Row="0" Background="{DynamicResource TitleBarBackground}">
                    <TextBlock Name="TitleBarText" Classes="WindowTitleText" Text="{Binding $parent[Window].Title}" Foreground="{DynamicResource TitleBarForeground}" />
                </Border>
                <Menu Grid.Row="1" Background="{DynamicResource AppSurfaceBrush}" Foreground="{DynamicResource AppTextMutedBrush}" Padding="10,0" FontSize="{DynamicResource AppFontSize12}">
                    <MenuItem Header="_File">
                        <MenuItem Name="MenuUploadVideo" Header="Upload Video..." ToolTip.Tip="Upload an MP4 or MKV video file from your computer to start editing." />
                        <Separator />
                        <MenuItem Name="MenuExportConfig" Header="Backup Settings..." ToolTip.Tip="Save all your current settings to a backup file so you don't lose them." />
                        <MenuItem Name="MenuImportConfig" Header="Restore Settings..." ToolTip.Tip="Load your saved settings from a previous backup." />
                        <Separator />
                        <MenuItem Name="MenuSettingsBtn" Header="_Settings" ToolTip.Tip="Open the settings menu to tweak how the application works." />
                        <Separator />
                        <MenuItem Name="MenuExit" Header="E_xit" ToolTip.Tip="Close the application." />
                    </MenuItem>
                    <MenuItem Header="_Edit">
                        <MenuItem Name="MenuCropSettings" Header="Crop Settings" ToolTip.Tip="Choose how you want to crop or resize your videos." />
                        <MenuItem Name="MenuVideoMerger" Header="Video Merger" ToolTip.Tip="Open a tool that lets you combine multiple videos into one." />
                    </MenuItem>
                    <MenuItem Header="_View">
                        <MenuItem Name="MenuTogglePreviewMonitor" Header="Detach Preview Monitor" ToolTip.Tip="Pop out the video player into its own separate floating window so you can move it around." />
                    </MenuItem>
                </Menu>
                <Grid Grid.Row="2" ColumnDefinitions="*, Auto">
        <!-- Ambient live-wallpaper bubbles (very gentle, non-interactive, behind all content).
             Echoes the FluidVolumeSlider bubble aesthetic across the theme background. -->
        <controls:AmbientBubblesBackground Grid.ColumnSpan="2" IsHitTestVisible="False" ZIndex="-1" />
        <!-- LEFT COLUMN: Player & Editing Controls -->
        <Grid Grid.Column="0" RowDefinitions="*, Auto" ColumnDefinitions="*,Auto" ClipToBounds="False">

            <!-- Video Player Area with overlaid timeline.
                 Right margin removed so the volume frame sits flush against the right pane (no gap). -->
                <Grid Name="MainVideoGrid" Grid.Column="0" Background="{DynamicResource AppVideoSurfaceBrush}" ClipToBounds="True" Cursor="Hand" Margin="10,10,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- IDEA_03: duplicate PlaceholderBubbles layer removed — the window-wide
                         AmbientBubblesBackground already animates behind this area; two overlapping
                         densities read as a rendering glitch. -->
                    <local:MpvVideoView Name="VideoHost" IsVisible="False" Grid.Row="0" />
                    <TextBlock Name="RdpWarningOverlay" Text="RDP SESSION" Foreground="{DynamicResource AppDangerBrush}" Opacity="0.5" FontSize="{DynamicResource AppFontSize60}" FontWeight="Black" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20" IsHitTestVisible="False" IsVisible="False" ZIndex="1" />

                    <Border IsVisible="{Binding #VideoHost.IsSoftwareFallbackActive}"
                            Background="{DynamicResource AppOverlayBrush}"
                            Grid.Row="0"
                            IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="32">
                            <TextBlock Text="Preview unavailable"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       FontSize="{DynamicResource AppFontSize18}"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center" />
                            <TextBlock Text="The hardware bridge and OpenGL fallback could not create a live preview on this graphics session."
                                       Foreground="{DynamicResource AppTextMutedBrush}"
                                       FontSize="{DynamicResource AppFontSize13}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="520" />
                        </StackPanel>
                    </Border>

                    <Border Name="PreviewDetachedWatermark" IsVisible="False" Background="{DynamicResource AppVideoSurfaceBrush}" Grid.Row="0">
                        <TextBlock Text="Preview Detached" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize36}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <Grid Name="PortraitDimmingGrid" IsVisible="False" Grid.Row="0" IsHitTestVisible="False">
                        <controls:PhoneFrameMockup Name="PhoneFrame" />
                    </Grid>

                    <!-- IDEA_01: single consolidated hero empty-state (BlankStateOverlay merged in).
                         IDEA_04: Opacity transition lets the card fade while the drag-over dropzone speaks.
                         IDEA_05: supported-formats hint. IDEA_07: unified "UPLOAD VIDEO" verb. -->
                    <Border Name="UploadOverlay" Background="{DynamicResource AppPanelBrush}" Opacity="0.95" CornerRadius="6" Grid.RowSpan="2">
                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                            </Transitions>
                        </Border.Transitions>
                        <Grid Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Stroke="{DynamicResource AppBorderBrush}" StrokeThickness="2" StrokeDashArray="6,4" RadiusX="8" RadiusY="8" Fill="{DynamicResource AppSurfaceBrush}" Opacity="0.8" IsHitTestVisible="False" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Margin="60,36">
                                <Border Classes="DropIconPulse" Width="88" Height="88" CornerRadius="44"
                                        Background="{DynamicResource AppAccentAlpha20Brush}"
                                        BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="2"
                                        HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock Text="⬇" FontSize="{DynamicResource AppFontSize36}" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Drag &amp; drop your gameplay video here" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize18}" FontWeight="SemiBold" HorizontalAlignment="Center" IsHitTestVisible="False" />
                                <TextBlock Text="or" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize12}" HorizontalAlignment="Center" IsHitTestVisible="False" />
                                <Button Name="CenterUploadButton" Classes="Primary" Content="UPLOAD VIDEO" Cursor="Hand" HorizontalAlignment="Center" ToolTip.Tip="Click here to browse your computer and upload a video file to start editing." Padding="20,10" />
                                <TextBlock Text="MP4 · MKV · AVI · MOV" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" HorizontalAlignment="Center" IsHitTestVisible="False" />
                                <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center" Margin="0,10,0,0" IsHitTestVisible="False">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="✂️" FontSize="{DynamicResource AppFontSize24}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Trim" FontSize="{DynamicResource AppFontSize11}" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="⚡" FontSize="{DynamicResource AppFontSize24}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Speed" FontSize="{DynamicResource AppFontSize11}" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="🎵" FontSize="{DynamicResource AppFontSize24}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Music" FontSize="{DynamicResource AppFontSize11}" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="📱" FontSize="{DynamicResource AppFontSize24}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Portrait" FontSize="{DynamicResource AppFontSize11}" Foreground="{DynamicResource AppTextMutedBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Name="TimelineOverlay" IsVisible="False" Grid.Row="1" Background="{DynamicResource AppOverlayBrush}" Padding="8,4,8,3" ZIndex="9999" Cursor="Hand" ClipToBounds="False">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                            <!-- ISSUE_05: MinWidth (not Width) so scaled fonts never clip the clock.
                                 ISSUE_06: slider row is 44 (was 32) so the 44px CompactSlider fits without bleeding into the tick ruler. -->
                            <TextBlock Name="TimeElapsed" Text="00:00:00" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" MinWidth="64" FontSize="{DynamicResource AppFontSize10}" Margin="0,0,8,0" />
                            <Grid Grid.Column="1" VerticalAlignment="Center" RowDefinitions="Auto, Auto" ClipToBounds="False">
                                <Canvas Grid.Row="0" Name="TimelineScaleCanvas" IsHitTestVisible="False" HorizontalAlignment="Stretch" MinHeight="14" />
                                <Slider Grid.Row="1" Name="TimelineSlider" Classes="CompactSlider" Minimum="0" Maximum="100" MinHeight="44" VerticalAlignment="Center" ToolTip.Tip="Drag this left or right to quickly skip through different parts of the video." AutomationProperties.Name="Main video timeline scrub slider" />
                                <Canvas Grid.Row="1" Name="TimelineMarkersCanvas" Classes="TimelineSeekSurface" Background="Transparent" Focusable="True" KeyboardNavigation.IsTabStop="False" KeyboardNavigation.TabNavigation="Continue" IsHitTestVisible="True" ClipToBounds="False" VerticalAlignment="Center" HorizontalAlignment="Stretch" MinHeight="32" Cursor="Hand" AutomationProperties.Name="Main video timeline seek area">
                                    <Border Name="PlayheadBadge" Background="{DynamicResource AppOverlayBrush}" CornerRadius="4" Padding="4,2" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" Opacity="0" IsHitTestVisible="False" Canvas.Bottom="32">
                                        <Border.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.5"/>
                                            </Transitions>
                                        </Border.Transitions>
                                        <TextBlock Name="PlayheadBadgeText" Text="00:00:00" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Canvas>
                            </Grid>
                            <TextBlock Grid.Column="2" Name="TimeRemaining" Text="-00:00:00" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" MinWidth="64" TextAlignment="Right" FontSize="{DynamicResource AppFontSize10}" Margin="8,0,0,0" />
                        </Grid>
                    </Border>

                    <Popup Name="FeedbackPopup" IsOpen="False" PlacementMode="Center" PlacementTarget="{Binding #MainVideoGrid}"
                           IsLightDismissEnabled="False" IsHitTestVisible="False">
                        <Border Name="FeedbackPopupBorder" Background="{DynamicResource AppOverlayBrush}" BorderBrush="{DynamicResource AppWarningBrush}" BorderThickness="1" CornerRadius="8" Padding="24,12" Opacity="0" MaxWidth="600" MaxHeight="300">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock Name="FeedbackPopupText" Text="" Foreground="{DynamicResource AppWarningBrush}" FontSize="{DynamicResource AppFontSize28}" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </Popup>

                    <!-- IDEA_02: hidden until a video loads (pre-upload it silently no-ops and floats over the hero card) -->
                    <Button Name="DetachOverlayButton"
                            IsVisible="False"
                            Classes="Secondary"
                            Content="◳ Detach Monitor"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="10,10,0,0"
                            Padding="8,4"
                            FontSize="{DynamicResource AppFontSize12}"
                            FontWeight="Bold"
                            Background="{DynamicResource AppOverlayBrush}"
                            ZIndex="9999" ToolTip.Tip="Pop out the video player into its own separate floating window so you can move it around." />
                </Grid>

                <Border Grid.Column="1" CornerRadius="4" Background="{DynamicResource AppVideoRailBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="0,8" VerticalAlignment="Stretch" Margin="2,10,2,10" ClipToBounds="False" ZIndex="9999">
                    <Grid RowDefinitions="Auto, *, Auto" ClipToBounds="False" HorizontalAlignment="Center" Margin="0">
                        <TextBlock Grid.Row="0" Name="VolumeBadgeText" Text="100%" Foreground="{DynamicResource AppInfoBrush}" FontSize="{DynamicResource AppFontSize12}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6" Opacity="1" IsVisible="False" />
                        <!-- Custom fluid "test tube" volume slider (see Controls/FluidVolumeSlider.cs).
                             Rollback: swap for a standard vertical Slider with the same Name/bindings (rollback folder no longer exists). -->
                        <controls:FluidVolumeSlider Grid.Row="1" Name="VolumeSlider" Orientation="Vertical" Minimum="0" Maximum="100" Value="100" MinWidth="57" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,0,0,0" ToolTip.Tip="Slide up or down to make the video louder or quieter." Cursor="Hand" ClipToBounds="False" ZIndex="10000" Foreground="{DynamicResource AppInfoBrush}" />
                        <Button Grid.Row="2" Name="SpeakerHitBox" MinWidth="35" MinHeight="35" Background="Transparent" BorderThickness="0" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0" ZIndex="10001" Cursor="Hand" Focusable="True" ToolTip.Tip="Click here to quickly mute or unmute the video." AutomationProperties.Name="Mute or restore volume" ClipToBounds="False">
                            <Path Name="VolumeSpeakerIcon" Fill="Transparent" Stroke="{DynamicResource AppInfoBrush}" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Width="{DynamicResource AppFontSize20}" Height="{DynamicResource AppFontSize20}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Data="M3,7 L6,7 L10,3 L10,13 L6,9 L3,9 Z M13,5 A4,4 0 0,1 13,11 M16,2 A8,8 0 0,1 16,14" />
                        </Button>
                    </Grid>
                </Border>

            <!-- Combined Trim and Process Controls Grid -->
            <Grid Grid.Row="1" RowDefinitions="Auto, Auto, Auto" Margin="10,8,10,8">
                <!-- Header. IDEA_06: unlock hint explains WHY the section is disabled pre-upload -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,5">
                    <TextBlock Text="TRIM &amp; PROCESS" FontSize="{DynamicResource AppFontSize11}" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Name="TrimUnlockHint" Text="— upload a video to unlock editing" FontSize="{DynamicResource AppFontSize10}" FontStyle="Italic" Foreground="{DynamicResource AppTextMutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <!-- Upper Row -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Button Name="SetThumbnailButton" Classes="Secondary" Padding="16,8" HorizontalAlignment="Left" VerticalAlignment="Center" IsEnabled="False" ToolTip.Tip="Save the exact frame you are looking at right now to be the cover image for your video.">
                        <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Fill="{DynamicResource AppTextPrimaryBrush}" Width="{DynamicResource AppFontSize18}" Height="{DynamicResource AppFontSize18}" Stretch="Uniform" VerticalAlignment="Center" Data="M 2,6 L 4,6 L 5,4 L 11,4 L 12,6 L 14,6 Q 15,6 15,7 L 15,12 Q 15,13 14,13 L 2,13 Q 1,13 1,12 L 1,7 Q 1,6 2,6 Z M 8,7.5 A 2.5,2.5 0 1,0 8,12.5 A 2.5,2.5 0 1,0 8,7.5" />
                            <TextBlock Name="SetThumbnailText" Text=" SET THUMBNAIL " FontSize="{DynamicResource AppFontSize9}" VerticalAlignment="Center" Margin="6,0,6,0" />
                            <Path Fill="{DynamicResource AppTextPrimaryBrush}" Width="{DynamicResource AppFontSize18}" Height="{DynamicResource AppFontSize18}" Stretch="Uniform" VerticalAlignment="Center" Data="M 2,6 L 4,6 L 5,4 L 11,4 L 12,6 L 14,6 Q 15,6 15,7 L 15,12 Q 15,13 14,13 L 2,13 Q 1,13 1,12 L 1,7 Q 1,6 2,6 Z M 8,7.5 A 2.5,2.5 0 1,0 8,12.5 A 2.5,2.5 0 1,0 8,7.5" />
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Name="MarkStartButton" Classes="Secondary" Focusable="True" Content="MARK START" Padding="16,8" Margin="0,0,30,0" IsEnabled="False" ToolTip.Tip="Cut out everything before this point. The final video will start exactly here."/>
                        <Button Name="PlayPauseButton" Classes="Primary" Padding="16,8" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsEnabled="False" AutomationProperties.Name="Play or Pause" ToolTip.Tip="Play or pause the video." Margin="0,0,30,0">
                            <Panel Width="{DynamicResource AppFontSize16}" Height="{DynamicResource AppFontSize16}">
                                <Path Name="PlayIcon" Data="{DynamicResource AppPlayIconGeometry}" Fill="{DynamicResource AppOnAccentTextBrush}" Stretch="Uniform" />
                                <Path Name="PauseIcon" IsVisible="False" Data="{DynamicResource AppPauseIconGeometry}" Fill="{DynamicResource AppOnAccentTextBrush}" Stretch="Uniform" />
                            </Panel>
                        </Button>
                        <Button Name="MarkEndButton" Classes="Secondary" Focusable="True" Content="MARK END" Padding="16,8" IsEnabled="False" ToolTip.Tip="Cut out everything after this point. The final video will end exactly here."/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Name="GranularButton" Classes="Secondary" Content="GRANULAR SPEED" Padding="16,8" IsEnabled="False" ToolTip.Tip="Change the speed of specific parts of your video."/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Button Name="VoiceOverButton" Classes="VoiceOverEntry" Padding="16,8" HorizontalAlignment="Left" VerticalAlignment="Center" IsEnabled="False" ToolTip.Tip="Record your own voice over the video.">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Fill="{DynamicResource AppOnAccentTextBrush}" Width="{DynamicResource AppFontSize16}" Height="{DynamicResource AppFontSize16}" Stretch="Uniform" VerticalAlignment="Center" Data="M12,14c1.66,0,3-1.34,3-3V5c0-1.66-1.34-3-3-3S9,3.34,9,5v6C9,12.66,10.34,14,12,14z M17,11c0,2.76-2.24,5-5,5s-5-2.24-5-5H5c0,3.53,2.61,6.43,6,6.92V21h2v-3.08c3.39-0.49,6-3.39,6-6.92H17z"/>
                            <TextBlock Name="VoiceOverText" Text="VOICE OVER" FontSize="{DynamicResource AppFontSize9}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>

                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle">
                        <StackPanel Name="QualityPanel" IsVisible="False" Orientation="Vertical" Spacing="2" Margin="0,0,20,8" VerticalAlignment="Center">
                            <TextBlock Text="OUTPUT FILE SIZE" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" />
<controls:SpinningWheelSlider Name="QualitySlider" Value="{Binding $parent[local:MainWindow].QualitySliderValue, Mode=TwoWay}" MinWidth="160" MaxWidth="300" MinHeight="35" Cursor="Hand" ToolTip.Tip="Slide left for a smaller file size, or right for higher video quality." />
                            <TextBlock Name="QualityLabel" Text="" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,0" VerticalAlignment="Top" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,20,8">
                            <!-- Issue #13: Normalize to 42px standard -->
                            <Button Name="CancelButton" Classes="Danger" Content="CANCEL" CornerRadius="10" IsVisible="False" ToolTip.Tip="Stop what you are doing right now and cancel it." Padding="20,10">
                                <Button.Flyout>
                                    <Flyout Placement="Top" FlyoutPresenterClasses="CustomFlyout">
                                        <StackPanel Spacing="8" Margin="8">
                                            <TextBlock Text="⚠️ Cannot be undone" Foreground="{DynamicResource AppWarningBrush}" FontSize="{DynamicResource AppFontSize12}" FontWeight="Bold" />
                                            <Button Name="ConfirmCancelButton" Classes="Danger" Content="CONFIRM CANCEL" HorizontalAlignment="Stretch" ToolTip.Tip="Permanently stop what you are doing right now." />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button Name="ProcessButton" Classes="Success" Content="PROCESS" CornerRadius="10" IsEnabled="False" ToolTip.Tip="Save and export your final edited video." Padding="20,10"/>
                        </StackPanel>

                        <Grid Name="SpeedPanel" IsVisible="False" VerticalAlignment="Center" Margin="0,0,0,8" ColumnDefinitions="Auto,8,Auto" RowDefinitions="Auto,Auto,Auto">
                            <!-- Slider Column -->
                            <TextBlock Grid.Column="0" Grid.Row="0" Text="SPEED" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,2" />
                            <controls:SpinningWheelSlider Grid.Column="0" Grid.Row="1" Name="MainSpeedSlider" Value="{Binding $parent[local:MainWindow].MainSpeedSliderValue, Mode=TwoWay}" IsEnabled="False" HorizontalAlignment="Stretch" MinWidth="180" MaxWidth="300" MinHeight="35" Cursor="Hand" ToolTip.Tip="Slide left to make the video slow motion, or right to speed it up." />
                            <TextBlock Grid.Column="0" Grid.Row="2" Name="MainSpeedLabel" Text="" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" VerticalAlignment="Top" TextTrimming="CharacterEllipsis" />
                            
                            <!-- Presets Column -->
                            <Grid Grid.Column="2" Grid.Row="1" Name="MainSpeedPresetsPanel" IsEnabled="False" RowDefinitions="Auto,3,Auto" ColumnDefinitions="Auto,4,Auto,4,Auto" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle">
                                <Button Grid.Row="0" Grid.Column="0" Name="SpeedPreset01" Classes="SpeedPreset" Content="0.1x" ToolTip.Tip="Set speed to 0.1x"/>
                                <Button Grid.Row="0" Grid.Column="2" Name="SpeedPreset10" Classes="SpeedPreset" Content="1.0x" ToolTip.Tip="Set speed to normal (1.0x)"/>
                                <Button Grid.Row="0" Grid.Column="4" Name="SpeedPresetBase" Classes="SpeedPreset BaseSpeedPreset" Content="1.1x" ToolTip.Tip="Set speed to 1.1x"/>
                                
                                <Button Grid.Row="2" Grid.Column="0" Name="SpeedPreset20" Classes="SpeedPreset" Content="2.0x" ToolTip.Tip="Set speed to 2.0x"/>
                                <Button Grid.Row="2" Grid.Column="2" Name="SpeedPreset30" Classes="SpeedPreset" Content="3.0x" ToolTip.Tip="Set speed to 3.0x"/>
                                <Button Grid.Row="2" Grid.Column="4" Name="SpeedPreset40" Classes="SpeedPreset" Content="4.0x" ToolTip.Tip="Set speed to 4.0x"/>
                            </Grid>
                        </Grid>
                    </WrapPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- RIGHT PANEL: Utility & Plugins -->
        <Border Grid.Column="1" MinWidth="170" MaxWidth="300" Background="Transparent" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,0,0,0" Padding="15">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid RowDefinitions="Auto, Auto, *, Auto">
                    <!-- Row 0: File Ops -->
                    <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,15">
                        <TextBlock Text="FILE OPERATIONS" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold"/>
                        <Button Name="UploadButton" Classes="Primary" Content="UPLOAD VIDEO" HorizontalAlignment="Stretch" ToolTip.Tip="Click here to browse your computer and upload a video file to start editing."/>
                        <Button Name="AddMusicButton" Classes="Secondary" HorizontalAlignment="Stretch" IsEnabled="False" ToolTip.Tip="Add a background song to play over your video.">
                            <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- ISSUE_06 (audit round 4): icons sized by AppFontSize14 token (were fixed 14px) so they scale with the label -->
                                <Path Fill="{DynamicResource AppTextPrimaryBrush}" Width="{DynamicResource AppFontSize14}" Height="{DynamicResource AppFontSize14}" Stretch="Uniform" VerticalAlignment="Center" Data="M12,3v10.55c-0.59-0.34-1.27-0.55-2-0.55c-2.21,0-4,1.79-4,4s1.79,4,4,4s4-1.79,4-4V7h4V3H12z" />
                                <TextBlock Name="AddMusicText" Text=" ADD MUSIC " FontSize="{DynamicResource AppFontSize12}" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,6,0" />
                                <Path Fill="{DynamicResource AppTextPrimaryBrush}" Width="{DynamicResource AppFontSize14}" Height="{DynamicResource AppFontSize14}" Stretch="Uniform" VerticalAlignment="Center" Data="M12,3v10.55c-0.59-0.34-1.27-0.55-2-0.55c-2.21,0-4,1.79-4,4s1.79,4,4,4s4-1.79,4-4V7h4V3H12z" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
                            <TextBlock Name="HardwareStatusLabel" Text="HW: Scanning..." Foreground="{DynamicResource AppSuccessBrush}" FontSize="{DynamicResource AppFontSize12}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                            <Button Name="RdpWarningButton" IsVisible="False" Background="Transparent" Padding="0" Cursor="Hand" ToolTip.Tip="Click for details">
                                <Path Fill="{DynamicResource AppDangerBrush}" Width="{DynamicResource AppFontSize14}" Height="{DynamicResource AppFontSize14}" Stretch="Uniform" VerticalAlignment="Center" Data="M12,2L1,21H23M12,6L19.53,19H4.47M11,10V14H13V10M11,16V18H13V16"/>
                                <Button.Flyout>
                                    <Flyout Placement="Bottom">
                                        <StackPanel Spacing="10" MaxWidth="300">
                                            <TextBlock Text="RDP SESSION DETECTED: YOUR GRAPHICS CARD IS ASLEEP!" FontWeight="Bold" Foreground="{DynamicResource AppDangerBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="You are connected via Remote Desktop. Windows turns off your GPU during Remote Desktop to save data, making this app extremely slow." TextWrapping="Wrap"/>
                                            <TextBlock Text="HOW TO FIX THIS (On the HOST machine):" FontWeight="Bold"/>
                                            <TextBlock Text="1. Click Start, type 'gpedit.msc' and hit Enter.&#x0a;2. Go to: Computer Configuration -> Administrative Templates -> Windows Components -> Remote Desktop Services -> Remote Desktop Session Host -> Remote Session Environment.&#x0a;3. Double-click 'Use hardware graphics adapters for all Remote Desktop Services sessions'. Set to 'Enabled'.&#x0a;4. Double-click 'Prioritize H.264/AVC 444 Graphics mode for Remote Desktop connections'. Set to 'Enabled'.&#x0a;5. Restart the computer." TextWrapping="Wrap"/>
                                            <Button Name="RdpFixButton" Classes="Danger" Content="Auto-Fix: Enable GPU Policy (Requires Admin)" HorizontalAlignment="Stretch" FontWeight="Bold" Click="RdpFixButton_Click" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Row 1: Overlays -->
                    <StackPanel Grid.Row="1" Spacing="10" Margin="0,0,0,15">
                        <Separator Background="{DynamicResource AppBorderBrush}" Height="1" Margin="0,0,0,5"/>
                        <Expander Header="OVERLAYS &amp; EFFECTS" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" IsExpanded="False" Background="Transparent" BorderThickness="0" Padding="0">
                        
                        <Border Background="{DynamicResource AppSurfaceBrush}" CornerRadius="6" Padding="12" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Margin="0,10,0,0">
                            <StackPanel Spacing="24">
                                
                                <StackPanel Spacing="12">
                                    <TextBlock Text="LAYOUTS" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize9}" FontWeight="Bold"/>
                                    
                                    <StackPanel Spacing="5">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Text="Portrait (9:16)" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize11}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <ToggleSwitch Name="PortraitModeCheckbox" IsChecked="{Binding $parent[local:MainWindow].IsPortraitMode, Mode=TwoWay}" Cursor="Hand" IsEnabled="False" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" Grid.Column="1" AutomationProperties.Name="Portrait mode (9:16)" ToolTip.Tip="Turn this on to make the video tall for mobile phones like TikTok or YouTube Shorts." />
                                        </Grid>
                                        <TextBox Name="PortraitTextInput" Text="{Binding $parent[local:MainWindow].OverlayText, Mode=TwoWay}" Watermark="Overlay Text" HorizontalAlignment="Stretch" MinHeight="40" MaxHeight="100" FontSize="{DynamicResource AppFontSize14}" ToolTip.Tip="Type text here to show it at the very top of your mobile-friendly video." TextWrapping="Wrap" AcceptsReturn="True" IsVisible="{Binding #PortraitModeCheckbox.IsChecked}" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                </StackPanel>

                                <Separator Background="{DynamicResource AppBorderBrush}" Height="1"/>

                                <Border Background="{DynamicResource AppSurfaceBrush}" CornerRadius="6" Padding="12" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="IN-GAME OVERLAYS" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize9}" FontWeight="Bold"/>
                                        
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Text="Boss HP" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize11}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <ToggleSwitch Name="BossHpCheckbox" IsChecked="{Binding $parent[local:MainWindow].IsBossHp, Mode=TwoWay}" Cursor="Hand" IsEnabled="False" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" Grid.Column="1" AutomationProperties.Name="Boss HP overlay" ToolTip.Tip="Turn this on to show a boss health bar in the video." />
                                        </Grid>

                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Text="Teammate HP" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize11}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <ToggleSwitch Name="TeammatesCheckbox" IsChecked="{Binding $parent[local:MainWindow].IsTeammates, Mode=TwoWay}" Cursor="Hand" IsEnabled="False" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" Grid.Column="1" AutomationProperties.Name="Teammate HP overlay" ToolTip.Tip="Turn this on to show your teammates' health in the video." />
                                        </Grid>

                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Text="Spectating Eye" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize11}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <ToggleSwitch Name="SpectatingCheckbox" IsChecked="{Binding $parent[local:MainWindow].IsSpectating, Mode=TwoWay}" Cursor="Hand" IsEnabled="False" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" Grid.Column="1" AutomationProperties.Name="Spectating eye overlay" ToolTip.Tip="Turn this on to show the spectator eye counter in the video." />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Separator Background="{DynamicResource AppBorderBrush}" Height="1"/>

                                <Border Background="{DynamicResource AppSurfaceBrush}" CornerRadius="6" Padding="12" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="EFFECTS &amp; MEMES" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize9}" FontWeight="Bold"/>

                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Text="Enable Fade" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize11}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <ToggleSwitch Name="EnableFadeCheckbox" IsChecked="{Binding $parent[local:MainWindow].IsEnableFade, Mode=TwoWay}" Cursor="Hand" IsEnabled="False" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" Grid.Column="1" AutomationProperties.Name="Enable fade" ToolTip.Tip="Turn this on to make the video slowly fade in at the start and fade out at the end." />
                                        </Grid>

                                        <StackPanel Spacing="5">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <TextBlock Text="Add MEME" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize11}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <ToggleSwitch Name="AddMemeCheckbox" IsChecked="{Binding $parent[local:MainWindow].IsAddMeme, Mode=TwoWay}" Cursor="Hand" IsEnabled="False" OnContent="{x:Null}" OffContent="{x:Null}" MinWidth="0" Grid.Column="1" AutomationProperties.Name="Add MEME" ToolTip.Tip="Turn this on to add funny meme popups over your video." />
                                            </Grid>
                                            <ComboBox Name="MemeComboBox" HorizontalAlignment="Stretch" IsVisible="{Binding #AddMemeCheckbox.IsChecked}" PlaceholderText="Select MEME" ToolTip.Tip="Choose which meme effect to display over your video." />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </Border>
                        </Expander>
                    </StackPanel>

                    <!-- Row 3: Advanced Tools -->
                    <StackPanel Grid.Row="3" Spacing="8">
                        <Separator Background="{DynamicResource AppBorderBrush}" Height="1" Margin="0,0,0,5"/>
                        <TextBlock Text="ADVANCED TOOLS" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold"/>
                        <Button Name="VideoMergerButton" Classes="Secondary" Content="VIDEO MERGER" HorizontalAlignment="Stretch" ToolTip.Tip="Open a tool that lets you combine multiple videos into one."/>
                        <Button Name="CropSettingsButton" Classes="Secondary" Content="CROP SETTINGS" HorizontalAlignment="Stretch" ToolTip.Tip="Choose how you want to crop or resize your videos."/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Phase Overlay for export progress -->
        <controls:PhaseOverlayControl x:Name="OverlayLayer" Grid.ColumnSpan="2" IsVisible="False" />

        <!-- Contextual Radial Menu (IDEA 2) -->
        <controls:RadialMenuControl x:Name="RadialMenu" Grid.ColumnSpan="2" ZIndex="999"/>

        <!-- Ambient Pulsing Dropzone (IDEA 4) -->
        <controls:AmbientDropzoneControl x:Name="AmbientDropzone" Grid.ColumnSpan="2" ZIndex="998"/>

        <!-- IDEA_01: BlankStateOverlay removed — merged into the single UploadOverlay hero card -->

        <!-- Particle Burst Feedback (IDEA 011) -->
        <controls:ParticleBurstCanvas x:Name="ParticleLayer" Grid.ColumnSpan="2" ZIndex="1000"/>

        <!-- Butler Predictive Ribbon (IDEA 005) -->
        <controls:ButlerRibbon x:Name="Butler" Grid.ColumnSpan="2"/>

        <!-- Meme Wall (IDEA 008) -->
        <controls:MemeWallControl x:Name="MemeWall" Grid.ColumnSpan="2" ZIndex="996"/>

        <!-- Overlay Canvas for Pop-up Badges and Custom Floating Animations -->
        <Canvas Name="OverlayCanvas" Grid.ColumnSpan="2" IsHitTestVisible="False" ZIndex="999"/>
                </Grid>
            </Grid>
        </Border>
        <!-- Drag & Drop Airspace Override Popup Removed -->
    </Grid>
</Window>
