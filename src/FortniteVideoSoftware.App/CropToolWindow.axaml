<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FortniteVideoSoftware.App"
        xmlns:controls="clr-namespace:FortniteVideoSoftware.App.Controls"
        x:CompileBindings="True"
        x:DataType="local:CropToolWindow"
        x:Class="FortniteVideoSoftware.App.CropToolWindow"
        Title="Portrait 1080x1920 (Crop Tool)"
        MinWidth="800" MinHeight="600"
        Background="{DynamicResource AppSurfaceBrush}"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        WindowStartupLocation="Manual"
        DragDrop.AllowDrop="True">

    <Border Name="MainBorder"
            Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource WindowTitleBorder}"
            BorderThickness="5">
        <Grid RowDefinitions="30,*">
            <Border Name="TitleBarBorder"
                    Grid.Row="0"
                    Background="{DynamicResource TitleBarBackground}">
                <TextBlock Classes="WindowTitleText"
                           Text="{Binding $parent[Window].Title}"
                           Foreground="{DynamicResource TitleBarForeground}" />
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto,Auto" Background="{DynamicResource AppSurfaceBrush}">
                    <Border Grid.Row="0"
                            Background="{DynamicResource AppPanelBrush}"
                            BorderBrush="{DynamicResource AppPanelBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,10">
                        <!-- ISSUE_05: Auto rows (were fixed 20/20/8px) so scaled fonts never clip the wizard labels -->
                        <Grid RowDefinitions="Auto,Auto,Auto">
                            <Grid Grid.Row="0" Margin="0,0,0,10" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                                <!-- ISSUE_03: connectors are AppBorderBrush, NOT AppPanelBrush — the
                                     header Border they sit on is AppPanelBrush, so the old value gave
                                     literally zero contrast in both Dark and Light. -->
                                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center" Margin="40,0,40,0" Height="2" Background="{DynamicResource AppBorderBrush}"/>
                                <!-- ISSUE_14 (audit round 5): the suite has TWO three-step wizards that share the
                                     WizDot*/WizIcon*/WizLabel* classes but shipped different geometry — these dots
                                     were 24px/CornerRadius 100/FontSize12 while MusicWizardWindow's are
                                     32px/CornerRadius 16/FontSize14. Aligned to the MusicWizard values so the
                                     "where am I in this flow" signal is identical in both tools. -->
                                <Border Grid.Row="0" Grid.Column="0" Name="Step1Dot" Classes="WizDotActive" MinWidth="32" MinHeight="32" CornerRadius="16" HorizontalAlignment="Center" ZIndex="1">
                                    <TextBlock Name="Step1Icon" Classes="WizIconOn" Text="1" FontWeight="Bold" FontSize="{DynamicResource AppFontSize14}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="1" Grid.Column="0" Name="Step1Label" Classes="WizLabelActive" Text="Upload" FontSize="{DynamicResource AppFontSize9}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <Border Grid.Row="0" Grid.Column="1" Name="Step2Dot" Classes="WizDotPending" MinWidth="32" MinHeight="32" CornerRadius="16" HorizontalAlignment="Center" ZIndex="1">
                                    <TextBlock Name="Step2Icon" Classes="WizIconPending" Text="2" FontWeight="Bold" FontSize="{DynamicResource AppFontSize14}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="1" Grid.Column="1" Name="Step2Label" Classes="WizLabelPending" Text="Crop" FontSize="{DynamicResource AppFontSize9}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <Border Grid.Row="0" Grid.Column="2" Name="Step3Dot" Classes="WizDotPending" MinWidth="32" MinHeight="32" CornerRadius="16" HorizontalAlignment="Center" ZIndex="1">
                                    <TextBlock Name="Step3Icon" Classes="WizIconPending" Text="3" FontWeight="Bold" FontSize="{DynamicResource AppFontSize14}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Row="1" Grid.Column="2" Name="Step3Label" Classes="WizLabelPending" Text="Save" FontSize="{DynamicResource AppFontSize9}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </Grid>
                            <TextBlock Name="GoalLabel"
                                       Grid.Row="1"
                                       Text="Goal: Upload Video"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       FontSize="{DynamicResource AppFontSize12}"
                                       FontWeight="Bold" />
                            <TextBlock Name="StatusLabel"
                                       Grid.Row="2"
                                       Text=""
                                       Foreground="{DynamicResource AppTextMutedBrush}"
                                       FontSize="{DynamicResource AppFontSize10}" />
                        </Grid>
                    </Border>

                    <Grid Name="VideoPanel" Grid.Row="1" Background="{DynamicResource AppVideoSurfaceBrush}">
                        <local:MpvVideoView Name="VideoHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        <Border IsVisible="{Binding #VideoHost.IsSoftwareFallbackActive}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" Background="{DynamicResource AppOverlayBrush}" CornerRadius="4" Padding="6" ToolTip.Tip="Live preview could not initialize on this graphics session.">
                            <TextBlock Text="⚠️" FontSize="{DynamicResource AppFontSize16}" Foreground="{DynamicResource AppWarningBrush}" />
                        </Border>
                        <Border Name="UploadHint"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AppOverlayBrush}"
                                BorderBrush="{DynamicResource AppAccentBrush}"
                                BorderThickness="2"
                                CornerRadius="8"
                                Padding="34,20">
                            <TextBlock Text="UPLOAD VIDEO"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       FontSize="{DynamicResource AppFontSize28}"
                                       FontWeight="Bold" />
                        </Border>
                    </Grid>

                    <!-- ISSUE_07 (audit round 4): toolbar row is Auto (was fixed 44) per the suite Font-Scale
                         Sizing Rule, so the element-name box and ADD SELECTION never clip at large font scale -->
                    <Grid Name="SnapshotPanel"
                          Grid.Row="1"
                          Background="{DynamicResource AppSurfaceBrush}"
                          IsVisible="False"
                          RowDefinitions="*,Auto">
                        <ScrollViewer Grid.Row="0"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="{DynamicResource AppSurfaceBrush}">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource AppVideoSurfaceBrush}">
                                <Image Name="SnapshotImage" Stretch="Uniform" />
                                <Canvas Name="SourceCanvas"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Background="Transparent"
                                        Cursor="Cross"
                                        Focusable="True" KeyboardNavigation.IsTabStop="True"
                                        AutomationProperties.Name="Source snapshot selection canvas" />
                            </Grid>
                        </ScrollViewer>
                        <Border Grid.Row="1"
                                Background="{DynamicResource AppPanelBrush}"
                                BorderBrush="{DynamicResource AppPanelBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="12,12">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" MinWidth="220">
                                    <TextBox Name="RoleTextBox"
                                             Watermark="Element Name (e.g. Ammo)"
                                             Text="{Binding $parent[local:CropToolWindow].RoleName, Mode=TwoWay}"
                                             HorizontalAlignment="Stretch"
                                             Foreground="{DynamicResource AppTextPrimaryBrush}"
                                             Background="{DynamicResource AppPanelBrush}" ToolTip.Tip="Enter a name for the cropped HUD element." />
                                </StackPanel>
                                <TextBlock Name="SelectionInfo"
                                           Grid.Column="1"
                                           Text="Draw a box around a HUD element, then assign its role."
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource AppFontSize11}"
                                           Margin="12,0,12,0" />
                                <!-- ISSUE_08 (audit round 5): was Classes="Success". Green Success is the
                                     suite's TERMINAL-COMMIT colour, and this window already spends it on
                                     "FINISH & SAVE" (SaveButton). Two identical greens meant nothing told
                                     the user which click ends the session. ADD SELECTION is the repeatable,
                                     undoable step action of the current sub-task, so it is Primary (blue);
                                     Success is now reserved for the single button that writes the config. -->
                                <Button Name="AddSelectionButton"
                                        Grid.Column="2"
                                        Classes="Primary"
                                        Content="ADD SELECTION"
                                        ToolTip.Tip="Add the drawn bounding box as a new HUD crop layer."
                                        IsEnabled="False" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Name="TimelinePanel"
                            Grid.Row="2"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppPanelBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,16"
                            Margin="0,8,0,0"
                            IsVisible="False">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" ClipToBounds="False">
                            <TextBlock Name="CurrentTimeLabel"
                                       Grid.Column="0"
                                       Text="00:00"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       MinWidth="64"
                                       FontSize="{DynamicResource AppFontSize10}"
                                       Margin="0,0,8,0" />
                            <Grid Grid.Column="1" VerticalAlignment="Center" RowDefinitions="Auto, Auto" ClipToBounds="False">
                                <Canvas Grid.Row="0" Name="CropTimelineScaleCanvas" IsHitTestVisible="False" ClipToBounds="False" HorizontalAlignment="Stretch" MinHeight="14" />
                                <!-- ISSUE_06: row is 44 (was 32) so the 44px CompactSlider fits without bleeding into the tick ruler -->
                                <Slider Grid.Row="1" Name="TimelineSlider" Classes="CompactSlider" Minimum="0" Maximum="100" MinHeight="44" VerticalAlignment="Center" ClipToBounds="False" KeyboardNavigation.IsTabStop="True" AutomationProperties.Name="Crop tool video timeline scrub slider" ToolTip.Tip="Drag to scrub through the video" />
                                <Canvas Grid.Row="1" Name="CropTimelineMarkersCanvas" Classes="TimelineSeekSurface" Background="Transparent" Focusable="True" KeyboardNavigation.IsTabStop="True" KeyboardNavigation.TabNavigation="Continue" Cursor="Hand" AutomationProperties.Name="Crop timeline seek area" IsHitTestVisible="True" ClipToBounds="False" VerticalAlignment="Center" HorizontalAlignment="Stretch" MinHeight="32">
                                    <Border Name="PlayheadBadge" Background="{DynamicResource AppOverlayBrush}" CornerRadius="4" Padding="4,2" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" Opacity="0" IsHitTestVisible="False" Canvas.Bottom="32">
                                        <Border.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.5"/>
                                            </Transitions>
                                        </Border.Transitions>
                                        <TextBlock Name="PlayheadBadgeText" Text="00:00:00" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Canvas>
                            </Grid>
                            <TextBlock Name="TotalTimeLabel"
                                       Grid.Column="2"
                                       Text="00:00"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       MinWidth="64"
                                       TextAlignment="Right"
                                       FontSize="{DynamicResource AppFontSize10}"
                                       Margin="8,0,0,0" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Background="{DynamicResource AppPanelBrush}"
                            BorderBrush="{DynamicResource AppPanelBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,5">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                <Button Name="OpenVideoButton" Classes="Secondary" Content="OPEN VIDEO" MinWidth="120" ToolTip.Tip="Click here to pick a video from your computer." Cursor="Hand" />
                                <Button Name="SnapshotButton" Classes="Primary" Content="START CROPPING" MinWidth="130" ToolTip.Tip="Take a picture of this frame so you can start drawing boxes." IsEnabled="False" Cursor="Hand" />
                                <Button Name="MagicWandButton" Classes="Secondary" Content="MAGIC WAND" MinWidth="120" ToolTip.Tip="Let the computer try to find the HUD items for you automatically." IsVisible="False" Cursor="Hand" />
                                <Button Name="BackToVideoButton" Classes="Secondary" Content="BACK TO VIDEO" MinWidth="130" ToolTip.Tip="Stop drawing and go back to the video seeker." IsVisible="False" Cursor="Hand" />
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <Button Name="PlayPauseButton" Classes="Primary" Content="PLAY" MinWidth="110" ToolTip.Tip="Play or pause video playback" IsEnabled="False" />
                                <Button Name="ReturnButton" Classes="Secondary" Content="RETURN" MinWidth="110" ToolTip.Tip="Close this tool and go back to the main menu." />
                                <Border Width="1" Height="20" Background="{DynamicResource AppBorderBrush}" Margin="8,0" />
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Name="ResetMenuButton" Classes="Danger" Content="RESET" MinWidth="90" ToolTip.Tip="Wipe everything clean and start over from scratch." />
                                    <StackPanel Name="ResetConfirmPanel" Orientation="Horizontal" Spacing="8" IsVisible="False" VerticalAlignment="Center">
                                        <TextBlock Text="⚠️ Cannot be undone" Foreground="{DynamicResource AppWarningBrush}" FontSize="{DynamicResource AppFontSize12}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Button Name="ConfirmResetButton" Classes="Danger" Content="CONFIRM RESET" ToolTip.Tip="Permanently wipe everything clean and reset the canvas." />
                                        <Button Name="CancelResetButton" Classes="Secondary" Content="CANCEL" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="1"
                        Background="{DynamicResource AppPanelBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1,0,0,0">
                    <!-- ISSUE_02: Auto rows (were fixed 42/46) so scaled fonts never clip the toolbar controls -->
                    <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <Border Grid.Row="0"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,6">
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                            <TextBlock Text="Active Profile:" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="{DynamicResource AppFontSize11}"/>
                            <ComboBox Name="CropToolMaskOverlayCombo" Grid.Column="1" Margin="10,0,10,0" HorizontalAlignment="Stretch" ToolTip.Tip="Select an existing mask overlay profile."/>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0" HorizontalAlignment="Stretch" MinWidth="130">
                                <!-- ISSUE_04: dropped `x:CompileBindings="False" Text="{Binding
                                     NewMaskOverlayName, Mode=TwoWay}"` — same phantom-property/null-DataContext
                                     defect as RoleTextBox above. Read via FindControl("NewMaskOverlayTextBox"). -->
                                <DataValidationErrors>
                                    <TextBox Name="NewMaskOverlayTextBox" Watermark="New profile name..." Text="{Binding $parent[local:CropToolWindow].NewMaskOverlayName, Mode=TwoWay}" HorizontalAlignment="Stretch" FontSize="{DynamicResource AppFontSize11}" ToolTip.Tip="Enter a name to save the current mask overlay layout as a new profile." />
                                </DataValidationErrors>
                            </StackPanel>
                            <Button Name="CreateMaskOverlayBtn" Grid.Column="3" Classes="Secondary" Content="SAVE AS NEW" ToolTip.Tip="Create a new custom mask overlay from current layout" FontSize="{DynamicResource AppFontSize10}" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1"
                            Background="{DynamicResource AppPanelBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,6">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                            <CheckBox Name="ShowPlaceholders"
                                      Grid.Column="0"
                                      Content="Show Existing Crops"
                                      Foreground="{DynamicResource AppTextPrimaryBrush}"
                                      IsChecked="False"
                                      MinHeight="44"
                                      ToolTip.Tip="Toggle the visibility of previously saved crops on the canvas."
                                      VerticalAlignment="Center" />
                            <Slider Name="PlaceholderOpacitySlider"
                                    Grid.Column="1"
                                    MinWidth="128"
                                    Minimum="20"
                                    Maximum="255"
                                    Value="95"
                                    IsVisible="False"
                                    Margin="10,0,0,0"
                                    ToolTip.Tip="Make old saved crops look see-through or solid." />
                            <CheckBox Name="SnapToggle"
                                      Grid.Column="3"
                                      Content="Snap"
                                      Foreground="{DynamicResource AppTextPrimaryBrush}"
                                      IsChecked="True"
                                      MinHeight="44"
                                      VerticalAlignment="Center"
                                      ToolTip.Tip="Turn the 'Magnetic Pull' on or off. Blue lines will always help you align things." />
                            <Button Name="SaveButton"
                                    Grid.Column="5"
                                    Classes="Success"
                                    Content="FINISH &amp; SAVE"
                                    MinWidth="120"
                                    ToolTip.Tip="Save all your work permanently to the computer."
                                    IsEnabled="False" />
                        </Grid>
                    </Border>

                    <!-- ISSUE_02: middle column Auto (was fixed 90) so the Undo/Redo buttons never clip at larger font scale -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto">
                        <Border Grid.Column="0"
                                Background="{DynamicResource AppVideoRailBrush}"
                                ClipToBounds="True">
                            <!-- ISSUE_5: the composer works in absolute portrait pixels (1080x1920).
                                 The Viewbox scales the whole fixed-size surface uniformly, so item
                                 coordinates, the background reference, and the letterbox stay in
                                 exact 1:1 alignment at any window size or DPI. Pointer positions
                                 obtained via GetPosition(PortraitCanvas) are automatically
                                 transformed back into 1080x1920 space by Avalonia. -->
                            <!-- IDEA_4: real device chrome around the composer.
                                 The bezel is a SIBLING wrapper placed OUTSIDE the 1080x1920 grid, so the
                                 composer keeps its exact coordinate space and GetPosition(PortraitCanvas)
                                 still returns true 1080x1920 pixels — the Viewbox simply scales a slightly
                                 larger box. Everything drawn on top of the canvas is IsHitTestVisible="False"
                                 so it can never swallow a drag. Colours reuse the PhoneFrameMockup device
                                 tokens (AppPhoneBezel*/AppPhoneChrome*), which are deliberately
                                 theme-agnostic: a phone bezel is black in Light and Dark alike. -->
                            <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="1920" Height="1080">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="600" />
                                        <ColumnDefinition Width="720" />
                                        <ColumnDefinition Width="600" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Central column scales the 1080x1920 canvas to exactly fit the 720x1280 screen opening -->
                                    <Viewbox Stretch="Uniform" Grid.Column="1" Width="720" Height="1280" VerticalAlignment="Center">
                                        <Grid Width="1080" Height="1920">
                                            <Rectangle Fill="{DynamicResource AppSurfaceBrush}" />
                                            <Image Name="ComposerBackgroundImage" Stretch="UniformToFill" Opacity="0.22" />

                                            <Canvas Name="PortraitCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" Cursor="Cross" Focusable="True" KeyboardNavigation.IsTabStop="True" AutomationProperties.Name="Portrait crop layout canvas" ToolTip.Tip="Click and drag to position crop regions. Use the handles to resize." />

                                            <Grid Name="RuleOfThirdsGrid" Opacity="0" IsHitTestVisible="False">
                                                <Grid.Transitions>
                                                    <Transitions>
                                                        <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut" />
                                                    </Transitions>
                                                </Grid.Transitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.RowSpan="3" Grid.Column="1" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="2,0,2,0" />
                                                <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,2,0,2" />
                                            </Grid>

                                            <Grid IsHitTestVisible="False">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="15*" />
                                                    <RowDefinition Height="162*" />
                                                    <RowDefinition Height="15*" />
                                                </Grid.RowDefinitions>
                                                <Rectangle Grid.Row="0" Fill="{DynamicResource AppVideoSurfaceBrush}" />
                                                <Rectangle Grid.Row="2" Fill="{DynamicResource AppVideoSurfaceBrush}" />
                                            </Grid>
                                        </Grid>
                                    </Viewbox>

                                    <!-- The centralized PhoneFrameMockup overlay -->
                                    <controls:PhoneFrameMockup Grid.ColumnSpan="3" IsHitTestVisible="False" />
                                </Grid>
                            </Viewbox>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Background="{DynamicResource AppPanelBrush}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Spacing="30"
                                    Margin="8,0">
                            <Button Name="UndoButton"
                                    Classes="Secondary"
                                    Content="⮪ UNDO"
                                    MinWidth="90"
                                    ToolTip.Tip="Undo your last mistake."
                                    IsEnabled="False" />
                            <Button Name="RedoButton"
                                    Classes="Secondary"
                                    Content="REDO ⮫"
                                    MinWidth="90"
                                    ToolTip.Tip="Redo what you just undid."
                                    IsEnabled="False" />
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1,0,0,0"
                                MinWidth="180" MaxWidth="300"
                                Padding="8">
                            <!-- ISSUE_02: Auto header row (was fixed 20) so the LAYERS label never clips at larger font scale -->
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Grid.Row="0"
                                           Text="LAYERS"
                                           Foreground="{DynamicResource AppTextMutedBrush}"
                                           FontSize="{DynamicResource AppFontSize10}"
                                           FontWeight="Bold" />
                                <ListBox Name="LayerList"
                                         Grid.Row="1"
                                         Background="Transparent"
                                         Foreground="{DynamicResource AppTextPrimaryBrush}"
                                         FontSize="{DynamicResource AppFontSize11}" />
                                <TextBlock Name="EmptyLayersText"
                                           Grid.Row="1"
                                           Text="Draw a box on the canvas to create a layer."
                                           Foreground="{DynamicResource AppTextMutedBrush}"
                                           FontSize="{DynamicResource AppFontSize11}"
                                           FontStyle="Italic"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3"
                            Background="{DynamicResource AppPanelBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,7">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="22">
                            <Button Name="LowerButton"
                                    Classes="Secondary"
                                    Content="MOVE DOWN"
                                    MinWidth="110"
                                    ToolTip.Tip="Move selected layer down"
                                    IsEnabled="False" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Name="DeleteMenuButton" Classes="Danger" Content="DELETE" MinWidth="90" ToolTip.Tip="Throw this piece into the trash." IsEnabled="False" />
                                    <StackPanel Name="DeleteConfirmPanel" Orientation="Horizontal" Spacing="8" IsVisible="False" VerticalAlignment="Center">
                                        <TextBlock Text="⚠️ Cannot be undone" Foreground="{DynamicResource AppWarningBrush}" FontSize="{DynamicResource AppFontSize12}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Button Name="ConfirmDeleteButton" Classes="Danger" Content="CONFIRM DELETE" ToolTip.Tip="Permanently delete the selected layer." />
                                        <Button Name="CancelDeleteButton" Classes="Secondary" Content="CANCEL" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <Button Name="RaiseButton"
                                    Classes="Secondary"
                                    Content="MOVE UP"
                                    MinWidth="110"
                                    ToolTip.Tip="Move selected layer up"
                                    IsEnabled="False" />
                        </StackPanel>
                    </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Overlays -->
            <Grid Name="ThinkingOverlay" Background="{DynamicResource AppOverlayBrush}" ZIndex="9999" IsVisible="False" Grid.RowSpan="2" IsHitTestVisible="True" KeyboardNavigation.TabNavigation="Cycle" Focusable="True">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                    <Path Data="M12 2v2a8 8 0 1 0 8 8h2a10 10 0 1 1-10-10z" Fill="{DynamicResource AppInfoBrush}" Width="60" Height="60" Stretch="Uniform" HorizontalAlignment="Center" />
                    <Border Background="{DynamicResource AppOverlayBrush}" CornerRadius="10" Padding="20">
                        <TextBlock Text="Please wait while processing" FontSize="{DynamicResource AppFontSize20}" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Name="SummaryOverlay" Background="{DynamicResource AppOverlayBrush}" ZIndex="9999" IsVisible="False" Grid.RowSpan="2" IsHitTestVisible="True" KeyboardNavigation.TabNavigation="Cycle" Focusable="True">
                <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppPanelBrush}" BorderThickness="3" CornerRadius="20" MinWidth="400" MaxWidth="800" MinHeight="300" MaxHeight="800" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40">
                    <StackPanel Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <TextBlock Text="✓" FontSize="{DynamicResource AppFontSize60}" Foreground="{DynamicResource AppSuccessBrush}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SUCCESS" FontSize="{DynamicResource AppFontSize28}" FontWeight="ExtraBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                <TextBlock Text="Configuration deployed safely." FontSize="{DynamicResource AppFontSize16}" Foreground="{DynamicResource AppTextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <!-- ISSUE_05: MaxHeight (was fixed Height) so summary content is never squeezed at larger font scales -->
                        <ScrollViewer MaxHeight="250">
                            <StackPanel Name="SummaryContent" Spacing="10" />
                        </ScrollViewer>
                        <TextBlock Text="Automatically returning to main app..." FontSize="{DynamicResource AppFontSize14}" FontWeight="Bold" Foreground="{DynamicResource AppInfoBrush}" HorizontalAlignment="Center" Margin="0,20,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
            <!-- ISSUE_10: both overlays are children of the outer RowDefinitions="30,*" grid and
                 carried no Grid.Row/Grid.RowSpan, so they defaulted to row 0 — the 30px title-bar
                 strip — while their ThinkingOverlay/SummaryOverlay siblings correctly declare
                 Grid.RowSpan="2". RadialMenuControl is itself 300x300, so it was being crushed into
                 a 30px band. Now spanning the full window like every other overlay in the suite. -->
            <!-- Contextual Radial Menu (IDEA 2) -->
            <controls:RadialMenuControl x:Name="RadialMenu" Grid.Row="0" Grid.RowSpan="2" ZIndex="999"/>

            <!-- Ambient Pulsing Dropzone (IDEA 4) -->
            <controls:AmbientDropzoneControl x:Name="AmbientDropzone" Grid.Row="0" Grid.RowSpan="2" ZIndex="998"/>
        </Grid>
    </Border>
</Window>
