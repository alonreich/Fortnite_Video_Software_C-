<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FortniteVideoSoftware.App"
        x:CompileBindings="True"
        x:Class="FortniteVideoSoftware.App.CropToolWindow"
        Title="Portrait 1080x1920 (Crop Tool)"
        Width="1800" Height="930"
        MinWidth="1500" MinHeight="760"
        Background="{DynamicResource AppSurfaceBrush}"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30">

    <Border Name="MainBorder"
            Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource WindowTitleBorder}"
            BorderThickness="5">
        <Grid RowDefinitions="30,*">
            <Border Name="TitleBarBorder"
                    Grid.Row="0"
                    Background="{DynamicResource TitleBarBackground}">
                <TextBlock Classes="WindowTitleText"
                           Text="{Binding $parent[Window].Title}"
                           Foreground="{DynamicResource TitleBarForeground}" />
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="*,624">
                <Grid Grid.Column="0" RowDefinitions="78,*,42,42" Background="#1a252f">
                    <Border Grid.Row="0"
                            Background="#243447"
                            BorderBrush="{DynamicResource AppPanelBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,10">
                        <Grid RowDefinitions="20,20,8">
                            <ProgressBar Name="WizardProgress"
                                         Grid.Row="0"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="20"
                                         Height="18" />
                            <TextBlock Name="GoalLabel"
                                       Grid.Row="1"
                                       Text="Goal: Upload Video"
                                       Foreground="#cbd5e1"
                                       FontSize="12"
                                       FontWeight="Bold" />
                            <TextBlock Name="StatusLabel"
                                       Grid.Row="2"
                                       Text=""
                                       Foreground="#94a3b8"
                                       FontSize="10" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid Name="VideoPanel" Background="Black">
                            <Viewbox Stretch="Uniform">
                                <Grid Width="1280" Height="720" Background="Black">
                                    <local:MpvVideoView Name="VideoHost"
                                                        Width="1280"
                                                        Height="720" />
                                    <Border IsVisible="{Binding #VideoHost.IsSoftwareFallbackActive}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" Background="#cc000000" CornerRadius="4" Padding="6" ToolTip.Tip="Running in Software Compatibility Mode. Nvidia GPU hardware bridge unavailable. Preview framerate may be lower.">
                                        <TextBlock Text="⚠️" FontSize="16" Foreground="Yellow" />
                                    </Border>
                                </Grid>
                            </Viewbox>
                            <Border Name="UploadHint"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#dd000000"
                                    BorderBrush="#7dd3fc"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Padding="34,20">
                                <TextBlock Text="UPLOAD VIDEO"
                                           Foreground="White"
                                           FontSize="28"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>

                        <Grid Name="SnapshotPanel"
                              Background="{DynamicResource AppSurfaceBrush}"
                              IsVisible="False"
                              RowDefinitions="*,44">
                            <ScrollViewer Grid.Row="0"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          Background="{DynamicResource AppSurfaceBrush}">
                                <Viewbox Stretch="Uniform">
                                    <Canvas Name="SourceCanvas"
                                            Width="1920"
                                            Height="1080"
                                            Background="Black"
                                            Cursor="Cross"
                                            Focusable="True"
                                            AutomationProperties.Name="Source snapshot selection canvas">
                                        <Image Name="SnapshotImage"
                                               Width="1920"
                                               Height="1080"
                                               Stretch="Fill" />
                                    </Canvas>
                                </Viewbox>
                            </ScrollViewer>
                            <Border Grid.Row="1"
                                    Background="#172033"
                                    BorderBrush="{DynamicResource AppPanelBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="12,6">
                                <Grid ColumnDefinitions="220,*,150">
                                    <ComboBox Name="RoleCombo"
                                              Grid.Column="0"
                                              Height="30"
                                              Foreground="White"
                                              Background="{DynamicResource AppPanelBrush}" />
                                    <TextBlock Name="SelectionInfo"
                                               Grid.Column="1"
                                               Text="Draw a box around a HUD element, then assign its role."
                                               Foreground="#cbd5e1"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Margin="12,0,12,0" />
                                    <Button Name="AddSelectionButton"
                                            Grid.Column="2"
                                            Classes="Success"
                                            Content="ADD SELECTION"
                                            IsEnabled="False" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Border Name="TimelinePanel"
                            Grid.Row="2"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppPanelBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,5"
                            IsVisible="False">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" ClipToBounds="False">
                            <TextBlock Name="CurrentTimeLabel"
                                       Grid.Column="0"
                                       Text="00:00"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Width="64"
                                       FontSize="10"
                                       Margin="0,0,8,0" />
                            <Grid Grid.Column="1" VerticalAlignment="Center" MinHeight="46" RowDefinitions="14,32" ClipToBounds="False">
                                <Canvas Name="CropTimelineScaleCanvas" Grid.Row="0" IsHitTestVisible="False" ClipToBounds="False" HorizontalAlignment="Stretch" Height="14" ZIndex="10000" />
                                <Grid Grid.Row="1" Height="32" ClipToBounds="False" ZIndex="10001">
                                    <Slider Name="TimelineSlider" Classes="CompactSlider" Minimum="0" Maximum="1000" Value="0" Height="44" MinHeight="44" VerticalAlignment="Center" ClipToBounds="False" ZIndex="10002" RenderTransform="translateY(-10px)" ToolTip.Tip="Drag to scrub through the video" />
                                    <Canvas Name="CropTimelineMarkersCanvas" IsHitTestVisible="True" ClipToBounds="False" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="32" ZIndex="10003" />
                                </Grid>
                            </Grid>
                            <TextBlock Name="TotalTimeLabel"
                                       Grid.Column="2"
                                       Text="00:00"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Width="64"
                                       TextAlignment="Right"
                                       FontSize="10"
                                       Margin="8,0,0,0" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Background="#243447"
                            BorderBrush="{DynamicResource AppPanelBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,5">
                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto">
                            <Button Name="OpenVideoButton"
                                    Grid.Column="0"
                                    Classes="Primary"
                                    Content="OPEN VIDEO"
                                    Width="120"
                                    ToolTip.Tip="Open a video file"
                                    Margin="0,0,12,0" />
                            <Button Name="SnapshotButton"
                                    Grid.Column="1"
                                    Classes="Primary"
                                    Content="START CROPPING"
                                    Width="130"
                                    ToolTip.Tip="Capture a frame and start cropping"
                                    IsEnabled="False"
                                    Margin="0,0,12,0" />
                            <Button Name="MagicWandButton"
                                    Grid.Column="2"
                                    Classes="Primary"
                                    Content="MAGIC WAND"
                                    Width="120"
                                    ToolTip.Tip="Auto-detect game UI elements"
                                    IsVisible="False"
                                    Margin="0,0,12,0" />
                            <Button Name="BackToVideoButton"
                                    Grid.Column="3"
                                    Classes="Primary"
                                    Content="BACK TO VIDEO"
                                    Width="130"
                                    ToolTip.Tip="Return to video view"
                                    IsVisible="False"
                                    Margin="0,0,12,0" />
                            <Button Name="PlayPauseButton"
                                    Grid.Column="5"
                                    Classes="Primary"
                                    Content="PLAY"
                                    Width="90"
                                    ToolTip.Tip="Play or pause video playback"
                                    IsEnabled="False"
                                    Margin="0,0,12,0" />
                            <Button Name="ReturnButton"
                                    Grid.Column="6"
                                    Classes="Primary"
                                    Content="RETURN"
                                    Width="90"
                                    ToolTip.Tip="Return to the main application"
                                    Margin="0,0,12,0" />
                            <Button Name="ResetButton"
                                    Grid.Column="7"
                                    Classes="Danger"
                                    Content="RESET"
                                    Width="90"
                                    ToolTip.Tip="Clear all layers" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="1"
                        Background="#253549"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1,0,0,0">
                    <Grid RowDefinitions="42,*,46">
                    <Border Grid.Row="0"
                            Background="{DynamicResource AppPanelBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,6">
                        <Grid ColumnDefinitions="Auto,128,*,Auto,24,Auto">
                            <CheckBox Name="ShowPlaceholders"
                                      Grid.Column="0"
                                      Content="Show Existing Crops"
                                      Foreground="White"
                                      IsChecked="False"
                                      VerticalAlignment="Center" />
                            <Slider Name="PlaceholderOpacitySlider"
                                    Grid.Column="1"
                                    Minimum="20"
                                    Maximum="255"
                                    Value="95"
                                    IsVisible="False"
                                    Margin="10,0,0,0" />
                            <CheckBox Name="SnapToggle"
                                      Grid.Column="3"
                                      Content="Snap"
                                      Foreground="White"
                                      IsChecked="True"
                                      VerticalAlignment="Center" />
                            <Button Name="SaveButton"
                                    Grid.Column="5"
                                    Classes="Success"
                                    Content="FINISH &amp; SAVE"
                                    Width="120"
                                    ToolTip.Tip="Save crop settings"
                                    IsEnabled="False" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" ColumnDefinitions="*,90,184">
                        <Border Grid.Column="0"
                                Background="Black"
                                ClipToBounds="True">
                            <Viewbox Stretch="Uniform">
                                <Canvas Name="PortraitCanvas"
                                        Width="1080"
                                        Height="1920"
                                        Background="Transparent"
                                        Cursor="Cross"
                                        Focusable="True"
                                        AutomationProperties.Name="Portrait crop layout canvas">
                                    <Image Name="ComposerBackgroundImage"
                                           Width="1080"
                                           Height="1920"
                                           Stretch="Fill"
                                           Opacity="0.22"
                                           ZIndex="-90" />
                                    <Rectangle Width="1080"
                                               Height="1920"
                                               Fill="#1e1e1e"
                                               ZIndex="-100" />
                                    
                                    <Grid Name="RuleOfThirdsGrid" Width="1080" Height="1920" Opacity="0" IsHitTestVisible="False" ZIndex="800" Canvas.Top="0" Canvas.Left="0">
                                        <Grid.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut" />
                                            </Transitions>
                                        </Grid.Transitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.RowSpan="3" Grid.Column="1" BorderBrush="#66ffffff" BorderThickness="2,0,2,0" />
                                        <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#66ffffff" BorderThickness="0,2,0,2" />
                                    </Grid>

                                    <Rectangle Width="1080"
                                               Height="150"
                                               Fill="Black"
                                               Canvas.Top="0"
                                               Canvas.Left="0"
                                               ZIndex="900" />
                                    <Rectangle Width="1080"
                                               Height="150"
                                               Fill="Black"
                                               Canvas.Top="1770"
                                               Canvas.Left="0"
                                               ZIndex="900" />
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Background="#253549"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Spacing="30"
                                    Margin="8,0">
                            <Button Name="UndoButton"
                                    Classes="Primary"
                                    Content="UNDO"
                                    Width="90"
                                    ToolTip.Tip="Undo the last crop action"
                                    IsEnabled="False" />
                            <Button Name="RedoButton"
                                    Classes="Primary"
                                    Content="REDO"
                                    Width="90"
                                    ToolTip.Tip="Redo the last crop action"
                                    IsEnabled="False" />
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1,0,0,0"
                                Padding="8">
                            <Grid RowDefinitions="20,*">
                                <TextBlock Grid.Row="0"
                                           Text="LAYERS"
                                           Foreground="#94a3b8"
                                           FontSize="10"
                                           FontWeight="Bold" />
                                <ListBox Name="LayerList"
                                         Grid.Row="1"
                                         Background="Transparent"
                                         Foreground="White"
                                         FontSize="11" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2"
                            Background="{DynamicResource AppPanelBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,7">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="22">
                            <Button Name="LowerButton"
                                    Classes="Primary"
                                    Content="MOVE DOWN"
                                    Width="110"
                                    ToolTip.Tip="Move selected layer down"
                                    IsEnabled="False" />
                            <Button Name="DeleteSelectedButton"
                                    Classes="Danger"
                                    Content="DELETE"
                                    Width="90"
                                    ToolTip.Tip="Delete the selected layer"
                                    IsEnabled="False" />
                            <Button Name="RaiseButton"
                                    Classes="Primary"
                                    Content="MOVE UP"
                                    Width="110"
                                    ToolTip.Tip="Move selected layer up"
                                    IsEnabled="False" />
                        </StackPanel>
                    </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
