<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FortniteVideoSoftware.App"
        x:CompileBindings="True"
        x:DataType="local:CropToolWindow"
        x:Class="FortniteVideoSoftware.App.CropToolWindow"
        Title="Portrait 1080x1920 (Crop Tool)"
        MinWidth="1500" MinHeight="760"
        Background="{DynamicResource AppSurfaceBrush}"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30">

    <Border Name="MainBorder"
            Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource WindowTitleBorder}"
            BorderThickness="5">
        <Grid RowDefinitions="30,*">
            <Border Name="TitleBarBorder"
                    Grid.Row="0"
                    Background="{DynamicResource TitleBarBackground}">
                <TextBlock Classes="WindowTitleText"
                           Text="{Binding $parent[Window].Title}"
                           Foreground="{DynamicResource TitleBarForeground}" />
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto,Auto" Background="{DynamicResource AppSurfaceBrush}">
                    <Border Grid.Row="0"
                            Background="{DynamicResource AppPanelBrush}"
                            BorderBrush="{DynamicResource AppPanelBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,10">
                        <Grid RowDefinitions="20,20,8">
                            <ProgressBar Name="WizardProgress"
                                         Grid.Row="0"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="20"
                                         Height="18" />
                            <TextBlock Name="GoalLabel"
                                       Grid.Row="1"
                                       Text="Goal: Upload Video"
                                       Foreground="#cbd5e1"
                                       FontSize="12"
                                       FontWeight="Bold" />
                            <TextBlock Name="StatusLabel"
                                       Grid.Row="2"
                                       Text=""
                                       Foreground="#94a3b8"
                                       FontSize="10" />
                        </Grid>
                    </Border>

                    <Grid Name="VideoPanel" Grid.Row="1" Background="Black">
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Black">
                            <local:MpvVideoView Name="VideoHost"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch" />
                            <Border IsVisible="{Binding #VideoHost.IsSoftwareFallbackActive}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" Background="#cc000000" CornerRadius="4" Padding="6" ToolTip.Tip="Live preview could not initialize on this graphics session.">
                                <TextBlock Text="⚠️" FontSize="16" Foreground="Yellow" />
                            </Border>
                        </Grid>
                        <Border Name="UploadHint"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#dd000000"
                                BorderBrush="#7dd3fc"
                                BorderThickness="2"
                                CornerRadius="8"
                                Padding="34,20">
                            <TextBlock Text="UPLOAD VIDEO"
                                       Foreground="White"
                                       FontSize="28"
                                       FontWeight="Bold" />
                        </Border>
                    </Grid>

                    <Grid Name="SnapshotPanel"
                          Grid.Row="1"
                          Background="{DynamicResource AppSurfaceBrush}"
                          IsVisible="False"
                          RowDefinitions="*,44">
                        <ScrollViewer Grid.Row="0"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      Background="{DynamicResource AppSurfaceBrush}">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Canvas Name="SourceCanvas"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Background="Black"
                                        Cursor="Cross"
                                        Focusable="True"
                                        AutomationProperties.Name="Source snapshot selection canvas">
                                    <Image Name="SnapshotImage"
                                           Width="{Binding $parent[Canvas].Bounds.Width}"
                                           Height="{Binding $parent[Canvas].Bounds.Height}"
                                           Stretch="Uniform" />
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
                        <Border Grid.Row="1"
                                Background="#172033"
                                BorderBrush="{DynamicResource AppPanelBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="12,6">
                            <Grid ColumnDefinitions="220,*,150">
                                <StackPanel Grid.Column="0">
                                    <TextBox Name="RoleTextBox"
                                             Watermark="Element Name (e.g. Ammo)"
                                             Height="30"
                                             Foreground="White"
                                             Background="{DynamicResource AppPanelBrush}" />
                                    <TextBlock Name="RoleErrorText" Foreground="{DynamicResource AppDangerBrush}" FontSize="10" FontWeight="Bold" IsVisible="False" Margin="0,2,0,0" Text="Name must be alphanumeric, 3-15 characters." />
                                </StackPanel>
                                <TextBlock Name="SelectionInfo"
                                           Grid.Column="1"
                                           Text="Draw a box around a HUD element, then assign its role."
                                           Foreground="#cbd5e1"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Margin="12,0,12,0" />
                                <Button Name="AddSelectionButton"
                                        Grid.Column="2"
                                        Classes="Success"
                                        Content="ADD SELECTION"
                                        ToolTip.Tip="Add the drawn bounding box as a new HUD crop layer."
                                        IsEnabled="False" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Name="TimelinePanel"
                            Grid.Row="2"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppPanelBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,5"
                            IsVisible="False">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" ClipToBounds="False">
                            <TextBlock Name="CurrentTimeLabel"
                                       Grid.Column="0"
                                       Text="00:00"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Width="64"
                                       FontSize="10"
                                       Margin="0,0,8,0" />
                            <Grid Grid.Column="1" VerticalAlignment="Center" MinHeight="46" ClipToBounds="False">
                                <StackPanel Orientation="Vertical">
                                    <Canvas Name="CropTimelineScaleCanvas" IsHitTestVisible="False" ClipToBounds="False" HorizontalAlignment="Stretch" Height="14" />
                                    <Grid Height="32" ClipToBounds="False">
                                        <Slider Name="TimelineSlider" Classes="CompactSlider" Minimum="0" Maximum="100" Height="44" MinHeight="44" VerticalAlignment="Center" ClipToBounds="False" ToolTip.Tip="Drag to scrub through the video" />
                                        <Canvas Name="CropTimelineMarkersCanvas" IsHitTestVisible="True" ClipToBounds="False" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="32">
                                            <Border Name="PlayheadBadge" Background="{DynamicResource AppOverlayBrush}" CornerRadius="4" Padding="4,2" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" Opacity="0" IsHitTestVisible="False" Canvas.Top="0" RenderTransform="translateY(-34px)">
                                                <Border.Transitions>
                                                    <Transitions>
                                                        <DoubleTransition Property="Opacity" Duration="0:0:0.5"/>
                                                    </Transitions>
                                                </Border.Transitions>
                                                <TextBlock Name="PlayheadBadgeText" Text="00:00:00" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Canvas>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <TextBlock Name="TotalTimeLabel"
                                       Grid.Column="2"
                                       Text="00:00"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Width="64"
                                       TextAlignment="Right"
                                       FontSize="10"
                                       Margin="8,0,0,0" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Background="{DynamicResource AppPanelBrush}"
                            BorderBrush="{DynamicResource AppPanelBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,5">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                <Button Name="OpenVideoButton" Classes="Secondary" Content="OPEN VIDEO" Width="120" ToolTip.Tip="Click here to pick a video from your computer." />
                                <Button Name="SnapshotButton" Classes="Primary" Content="START CROPPING" Width="130" ToolTip.Tip="Take a picture of this frame so you can start drawing boxes." IsEnabled="False" />
                                <Button Name="MagicWandButton" Classes="Secondary" Content="MAGIC WAND" Width="120" ToolTip.Tip="Let the computer try to find the HUD items for you automatically." IsVisible="False" />
                                <Button Name="BackToVideoButton" Classes="Secondary" Content="BACK TO VIDEO" Width="130" ToolTip.Tip="Stop drawing and go back to the video seeker." IsVisible="False" />
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                                <Button Name="PlayPauseButton" Classes="Secondary" Content="PLAY" Width="90" ToolTip.Tip="Play or pause video playback" IsEnabled="False" />
                                <Button Name="ReturnButton" Classes="Secondary" Content="RETURN" Width="90" ToolTip.Tip="Close this tool and go back to the main menu." />
                                <Button Name="ResetButton" Classes="Danger" Content="RESET" Width="90" ToolTip.Tip="Wipe everything clean and start over from scratch." />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="1"
                        Background="{DynamicResource AppPanelBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1,0,0,0">
                    <Grid RowDefinitions="Auto,42,*,46">
                    <Border Grid.Row="0"
                            Background="{DynamicResource AppSurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,6">
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                            <TextBlock Text="Active Profile:" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                            <ComboBox Name="CropToolMaskOverlayCombo" Grid.Column="1" Margin="10,0,10,0" Width="180" HorizontalAlignment="Left"/>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBox Name="NewMaskOverlayTextBox" Watermark="New profile name..." Width="130" FontSize="11" />
                                <TextBlock Name="NewMaskOverlayErrorText" Foreground="{DynamicResource AppDangerBrush}" FontSize="9" FontWeight="Bold" IsVisible="False" Margin="0,2,0,0" Text="Name must be alphanumeric, no spaces." />
                            </StackPanel>
                            <Button Name="CreateMaskOverlayBtn" Grid.Column="3" Classes="Primary" Content="SAVE AS NEW" ToolTip.Tip="Create a new custom mask overlay from current layout" FontSize="10" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1"
                            Background="{DynamicResource AppPanelBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,6">
                        <Grid ColumnDefinitions="Auto,128,*,Auto,24,Auto">
                            <CheckBox Name="ShowPlaceholders"
                                      Grid.Column="0"
                                      Content="Show Existing Crops"
                                      Foreground="White"
                                      IsChecked="False"
                                      ToolTip.Tip="Toggle the visibility of previously saved crops on the canvas."
                                      VerticalAlignment="Center" />
                            <Slider Name="PlaceholderOpacitySlider"
                                    Grid.Column="1"
                                    Minimum="20"
                                    Maximum="255"
                                    Value="95"
                                    IsVisible="False"
                                    Margin="10,0,0,0"
                                    ToolTip.Tip="Make old saved crops look see-through or solid." />
                            <CheckBox Name="SnapToggle"
                                      Grid.Column="3"
                                      Content="Snap"
                                      Foreground="White"
                                      IsChecked="True"
                                      VerticalAlignment="Center"
                                      ToolTip.Tip="Turn the 'Magnetic Pull' on or off. Blue lines will always help you align things." />
                            <Button Name="SaveButton"
                                    Grid.Column="5"
                                    Classes="Success"
                                    Content="FINISH &amp; SAVE"
                                    Width="120"
                                    ToolTip.Tip="Save all your work permanently to the computer."
                                    IsEnabled="False" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" ColumnDefinitions="*,90,180">
                        <Border Grid.Column="0"
                                Background="{DynamicResource AppVideoRailBrush}"
                                ClipToBounds="True">
                            <Grid>
                                <Rectangle Fill="{DynamicResource AppSurfaceBrush}" />
                                <Image Name="ComposerBackgroundImage" Stretch="UniformToFill" Opacity="0.22" />
                                
                                <Canvas Name="PortraitCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" Cursor="Cross" Focusable="True" AutomationProperties.Name="Portrait crop layout canvas" />

                                <Grid Name="RuleOfThirdsGrid" Opacity="0" IsHitTestVisible="False">
                                    <Grid.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut" />
                                        </Transitions>
                                    </Grid.Transitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.RowSpan="3" Grid.Column="1" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="2,0,2,0" />
                                    <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,2,0,2" />
                                </Grid>

                                <Grid IsHitTestVisible="False">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="150*" />
                                        <RowDefinition Height="1620*" />
                                        <RowDefinition Height="150*" />
                                    </Grid.RowDefinitions>
                                    <Rectangle Grid.Row="0" Fill="Black" />
                                    <Rectangle Grid.Row="2" Fill="Black" />
                                </Grid>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Background="{DynamicResource AppPanelBrush}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Spacing="30"
                                    Margin="8,0">
                            <Button Name="UndoButton"
                                    Classes="Secondary"
                                    Content="UNDO"
                                    Width="90"
                                    ToolTip.Tip="Undo your last mistake."
                                    IsEnabled="False" />
                            <Button Name="RedoButton"
                                    Classes="Secondary"
                                    Content="REDO"
                                    Width="90"
                                    ToolTip.Tip="Redo what you just undid."
                                    IsEnabled="False" />
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="{DynamicResource AppSurfaceBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1,0,0,0"
                                Padding="8">
                            <Grid RowDefinitions="20,*">
                                <TextBlock Grid.Row="0"
                                           Text="LAYERS"
                                           Foreground="#94a3b8"
                                           FontSize="10"
                                           FontWeight="Bold" />
                                <ListBox Name="LayerList"
                                         Grid.Row="1"
                                         Background="Transparent"
                                         Foreground="White"
                                         FontSize="11" />
                                <TextBlock Name="EmptyLayersText"
                                           Grid.Row="1"
                                           Text="No layers added yet."
                                           Foreground="{DynamicResource AppTextMutedBrush}"
                                           FontSize="11"
                                           FontStyle="Italic"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3"
                            Background="{DynamicResource AppPanelBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,7">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="22">
                            <Button Name="LowerButton"
                                    Classes="Secondary"
                                    Content="MOVE DOWN"
                                    Width="110"
                                    ToolTip.Tip="Move selected layer down"
                                    IsEnabled="False" />
                            <Button Name="DeleteSelectedButton"
                                    Classes="Danger"
                                    Content="DELETE"
                                    Width="90"
                                    ToolTip.Tip="Throw this piece into the trash."
                                    IsEnabled="False" />
                            <Button Name="RaiseButton"
                                    Classes="Secondary"
                                    Content="MOVE UP"
                                    Width="110"
                                    ToolTip.Tip="Move selected layer up"
                                    IsEnabled="False" />
                        </StackPanel>
                    </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Overlays -->
            <Grid Name="ThinkingOverlay" Background="{DynamicResource AppOverlayBrush}" ZIndex="9999" IsVisible="False" Grid.RowSpan="2">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                    <Path Data="M12 2v2a8 8 0 1 0 8 8h2a10 10 0 1 1-10-10z" Fill="#38bdf8" Width="60" Height="60" Stretch="Uniform" HorizontalAlignment="Center" />
                    <Border Background="#cc0f172a" CornerRadius="10" Padding="20">
                        <TextBlock Text="Please wait while processing" FontSize="20" FontWeight="Bold" Foreground="White" />
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Name="SummaryOverlay" Background="{DynamicResource AppOverlayBrush}" ZIndex="9999" IsVisible="False" Grid.RowSpan="2">
                <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppPanelBrush}" BorderThickness="3" CornerRadius="20" Width="650" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40">
                    <StackPanel Spacing="20">
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <TextBlock Text="✓" FontSize="60" Foreground="#10b981" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SUCCESS" FontSize="28" FontWeight="ExtraBold" Foreground="White" />
                                <TextBlock Text="Configuration deployed safely." FontSize="16" Foreground="#94a3b8" />
                            </StackPanel>
                        </StackPanel>
                        <ScrollViewer Height="250">
                            <StackPanel Name="SummaryContent" Spacing="10" />
                        </ScrollViewer>
                        <TextBlock Text="Automatically returning to main app..." FontSize="14" FontWeight="Bold" Foreground="#38bdf8" HorizontalAlignment="Center" Margin="0,20,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
