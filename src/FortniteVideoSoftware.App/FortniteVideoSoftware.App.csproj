<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FortniteVideoSoftware.Core\FortniteVideoSoftware.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.0.10" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.0.10" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.0.10" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.0.10" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.0.10" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.0.10" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <!-- AUDIO_12: System.Windows.Extensions was referenced ONLY for System.Media.SoundPlayer in
         UiSoundEffect.cs. UiSoundEffect now runs on NAudio (already a dependency, already used in
         production by Core\Media\VoiceRecorder.cs), so this package and its
         winmm PlaySound single-channel limitation are gone. Verified: no other `System.Media` or
         `SoundPlayer` reference exists anywhere in src\. -->

    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <!-- AUDIO_08: the six UI sound effects used to live as base64 STRING LITERALS inside
       UiSoundEffect.cs (663,680 base64 chars for 497,758 bytes of PCM). .NET stores string
       literals as UTF-16 in the assembly's #US heap, so that cost ~1.27 MB of binary to carry
       ~486 KB of audio, plus a second full copy decoded onto the managed heap at startup — in an
       app whose #2 mandate is a single condensed .exe. They are now real .wav files embedded as
       resources (raw bytes, no 2x encoding penalty, loaded lazily on first use).
       LogicalName is set EXPLICITLY so the lookup can never break from a RootNamespace or folder
       rename. These are deliberately NOT LFS-tracked (unlike *.mp3/*.mp4 in .gitattributes):
       they are build-critical inputs, and an LFS pointer file in a clone without LFS would embed
       130 bytes of text as a "sound" and fail silently. 486 KB of plain git blob is cheaper than
       that failure mode. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Sounds\click.wav"   LogicalName="UiSound.click.wav" />
    <EmbeddedResource Include="Assets\Sounds\mark.wav"    LogicalName="UiSound.mark.wav" />
    <EmbeddedResource Include="Assets\Sounds\open.wav"    LogicalName="UiSound.open.wav" />
    <EmbeddedResource Include="Assets\Sounds\close.wav"   LogicalName="UiSound.close.wav" />
    <EmbeddedResource Include="Assets\Sounds\process.wav" LogicalName="UiSound.process.wav" />
    <EmbeddedResource Include="Assets\Sounds\error.wav"   LogicalName="UiSound.error.wav" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="payload.zip" Condition="Exists('payload.zip')" />
    <TrimmerRootAssembly Include="Avalonia.Controls.ColorPicker" />
    <TrimmerRootAssembly Include="Avalonia.Controls.DataGrid" />
    <TrimmerRootAssembly Include="Avalonia.Themes.Fluent" />
    <TrimmerRootAssembly Include="SkiaSharp" />
    <InternalsVisibleTo Include="FortniteVideoSoftware.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Watch Include="**\*.axaml" />
    <UpToDateCheckInput Include="**\*.axaml" />
  </ItemGroup>

  <!-- DEV ONLY: Copy native binaries (mpv, ffmpeg) to the output folder after every
       Debug build so the app can run locally via `dotnet run` or `dotnet watch run`.
       Does NOT affect production NativeAOT publish (Release). -->
  <Target Name="CopyDevBinaries" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug' And Exists('$(MSBuildThisFileDirectory)..\..\binaries\mpv.exe')">
    <ItemGroup>
      <DevFrontendBinaries Include="$(MSBuildThisFileDirectory)..\..\binaries\mpv.exe" />
      <DevFrontendBinaries Include="$(MSBuildThisFileDirectory)..\..\binaries\libmpv-2.dll" />
      <DevBackendBinaries Include="$(MSBuildThisFileDirectory)..\..\binaries\ffmpeg.exe" />
      <DevBackendBinaries Include="$(MSBuildThisFileDirectory)..\..\binaries\ffprobe.exe" />
      <DevBackendBinaries Include="$(MSBuildThisFileDirectory)..\..\binaries\av*.dll" />
      <DevBackendBinaries Include="$(MSBuildThisFileDirectory)..\..\binaries\sw*.dll" />
      <DevBackendBinaries Include="$(MSBuildThisFileDirectory)..\..\binaries\postproc*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(DevFrontendBinaries)" DestinationFolder="$(OutDir)frontend" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DevBackendBinaries)" DestinationFolder="$(OutDir)backend" SkipUnchangedFiles="true" />
  </Target>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TrimMode>full</TrimMode>
    <!-- ══════════════════════════════════════════════════════════════════════════════════════════
         AOTSAFETY_01 — THE TRIM AND AOT ANALYSERS ARE ON. DO NOT SET THESE BACK TO true.
         These two properties used to be true, which did not make the app AOT-safe; it made the app
         SILENT about not being AOT-safe. A trim warning is the compiler predicting "this reflection
         call has no metadata left after trimming and will throw at run time". Suppressed, the
         prediction still comes true — it just arrives as a NotSupportedException on a user's
         machine, in the published single .exe only, where it cannot be reproduced from a Debug run.
         Mandate #1 makes that one .exe the entire product, so the analyser that guards it may not
         be muted.
         Warnings here are WARNINGS, not errors: the build still succeeds. Each one is either fixed
         (usually by moving to a source-generated JsonSerializerContext, as Ipc/IpcProtocol.cs
         already does) or explicitly annotated at the call site with a comment saying why it is
         provably safe. Silencing the whole category to clear the build log is how this got here.
         ══════════════════════════════════════════════════════════════════════════════════════════ -->
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <SuppressAotAnalysisWarnings>false</SuppressAotAnalysisWarnings>
    <!-- AOTSAFETY_01: IlcTrimMetadata stays false. It is a SIZE/behaviour switch that keeps
         metadata the app needs at run time, not an analyser mute, and turning it on would change
         what the shipped binary can do. Unrelated to the two properties above. -->
    <IlcTrimMetadata>false</IlcTrimMetadata>
    <ApplicationIcon>..\..\assets\icons\Video_Icon_File.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- AOTSAFETY_01: IL2104 ("assembly produced trim warnings") removed from NoWarn. It is the
       summary line that names which assembly is unsafe; muting it while re-enabling the detailed
       warnings would hide the headline and keep the noise. CS1998/CS0414 are unrelated style
       warnings and stay suppressed. -->
  <NoWarn>$(NoWarn);CS1998;CS0414</NoWarn>
  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- ══════════════════════════════════════════════════════════════════════════════════════════
       ISSUE_03 — WIN32 BINARY IDENTITY. DO NOT DELETE THESE, AND DO NOT LEAVE THEM BLANK.
       Until this block existed the shipped single .exe carried .NET's silent defaults: FileVersion
       1.0.0.0, no Company, no Product, no Copyright. Right-click > Properties > Details was empty,
       which is what a user checks when SmartScreen stops an unknown download — so the one place
       they went looking for reassurance said nothing at all. Mandate #2 makes this ONE file the
       entire product; it has to be able to introduce itself.
       ⚠️ Product deliberately avoids the word "Fortnite". That is an Epic Games trademark and this
          string is embedded in a binary that is distributed publicly. The folder and repo may keep
          their working name; the shipped metadata may not.
       ⚠️ Bump <Version> on every release. AssemblyVersion is pinned to a 1.0.0.0-style major line on
          purpose so assembly binding never breaks between patch releases; FileVersion and
          InformationalVersion carry the real number that users and bug reports see.
       ══════════════════════════════════════════════════════════════════════════════════════════ -->
  <PropertyGroup>
    <Version>2026.09.18.0937</Version>
    <AssemblyVersion>2026.09.18.0937</AssemblyVersion>
    <FileVersion>2026.09.18.0937</FileVersion>
    <InformationalVersion>2026.09.18.0937</InformationalVersion>
    <Company>Alon Reich</Company>
    <Authors>Alon Reich</Authors>
    <Product>Clip Studio for Gameplay</Product>
    <AssemblyTitle>Clip Studio for Gameplay</AssemblyTitle>
    <Description>Trim, speed-ramp, add music and export gameplay clips for social video.</Description>
    <Copyright>Copyright © 2026 Alon Reich. All rights reserved.</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

</Project>
