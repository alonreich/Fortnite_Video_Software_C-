<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FortniteVideoSoftware.App"
        xmlns:controls="clr-namespace:FortniteVideoSoftware.App.Controls"
        x:Class="FortniteVideoSoftware.App.PreviewMonitorWindow"
        Title="Preview Monitor"
        Width="1280" Height="750"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        ShowInTaskbar="True"
        Background="{DynamicResource AppSurfaceBrush}">
    
    <Grid>
        <Border Name="MainBorder" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="0" Padding="0" BorderBrush="{DynamicResource WindowTitleBorder}" BorderThickness="5">
            <Grid RowDefinitions="30, *">
                <!-- Custom Title Bar -->
                <Border Name="TitleBarBorder" Grid.Row="0" Background="{DynamicResource TitleBarBackground}">
                    <TextBlock Name="TitleBarText" Classes="WindowTitleText" Text="{Binding $parent[Window].Title}" Foreground="{DynamicResource TitleBarForeground}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </Border>

                <Grid Grid.Row="1" ClipToBounds="True">
                    <!-- The Container where the SINGLE MpvVideoView instance will be transplanted -->
                    <Border Name="VideoContainer" />

                    <UserControl Name="PortraitSimulatorOverlay" IsVisible="False" IsHitTestVisible="False">
                        <controls:PhoneFrameMockup Name="PhoneFrame" />
                    </UserControl>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
