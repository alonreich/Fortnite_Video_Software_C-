<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FortniteVideoSoftware.App"
        x:Class="FortniteVideoSoftware.App.PreviewMonitorWindow"
        Title="Preview Monitor"
        Width="1280" Height="750"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        ShowInTaskbar="True"
        Background="#1e293b">
    
    <Grid>
        <Border Name="MainBorder" Background="#1e293b" CornerRadius="0" Padding="0" BorderBrush="{DynamicResource WindowTitleBorder}" BorderThickness="5">
            <Grid RowDefinitions="30, *">
                <!-- Custom Title Bar -->
                <Border Name="TitleBarBorder" Grid.Row="0" Background="{DynamicResource TitleBarBackground}">
                    <TextBlock Name="TitleBarText" Classes="WindowTitleText" Text="{Binding $parent[Window].Title}" Foreground="{DynamicResource TitleBarForeground}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </Border>

                <Grid Grid.Row="1" ClipToBounds="True">
                    <!-- The Container where the SINGLE MpvVideoView instance will be transplanted -->
                    <Border Name="VideoContainer" />

                    <Grid Name="PortraitSimulatorOverlay" IsVisible="False" ClipToBounds="False">
                        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="False">
                            <Grid Width="1920" Height="1080">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="656.25" />
                                    <ColumnDefinition Width="607.5" />
                                    <ColumnDefinition Width="656.25" />
                                </Grid.ColumnDefinitions>
                                
                                <!-- Infinite Left Dimming -->
                                <Canvas Grid.Column="0" ClipToBounds="False">
                                    <Border Background="#99000000" Width="10000" Height="20000" Canvas.Right="0" Canvas.Top="-5000" />
                                </Canvas>
                                
                                <!-- Center Phone Area -->
                                <Grid Grid.Column="1" ClipToBounds="False" Name="PhoneViewbox">
                                    <Viewbox Stretch="Fill" ClipToBounds="True">
                                        <Grid Width="1080" Height="1920">
                                            <Border Height="266" Background="Black" VerticalAlignment="Top" />
                                            <Border Height="266" Background="Black" VerticalAlignment="Bottom" />

                                            <Image Name="SkiaTextPlaceholder" Height="266" VerticalAlignment="Top" HorizontalAlignment="Center" Stretch="Uniform" Margin="0,90,0,0" />

                                            <!-- Top Edge Phone UI (Battery, Signal, Time) -->
                                            <Grid Height="266" VerticalAlignment="Top" Margin="50,80,50,0">
                                                <TextBlock Text="9:41" Foreground="White" FontSize="56" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,20,0,0"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="20" Margin="0,25,0,0">
                                                    <Path Data="M 0,36 L 36,0 L 36,36 Z" Fill="White" Width="32" Height="32" Stretch="Uniform" />
                                                    <Path Data="M 12,0 C 18,0 23.5,2 27.5,5.5 L 12,24 L -3.5,5.5 C 0.5,2 6,0 12,0 Z" Fill="White" Width="36" Height="32" Stretch="Uniform" />
                                                    <Border BorderBrush="White" BorderThickness="4" CornerRadius="8" Width="60" Height="32">
                                                        <Border Background="White" Margin="3" CornerRadius="4" Width="42" HorizontalAlignment="Left" />
                                                    </Border>
                                                    <Border Background="White" Width="5" Height="12" CornerRadius="0,4,4,0" Margin="-15,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Bottom Edge Android Navigation -->
                                            <Grid Height="266" VerticalAlignment="Bottom" Background="Black">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="160">
                                                    <!-- Triangle (Back) -->
                                                    <Path Data="M 21,0 L 0,21 L 21,42 Z" Fill="White" Width="36" Height="36" Stretch="Uniform" Margin="0,10,0,0"/>
                                                    <!-- Circle (Home) -->
                                                    <Ellipse Fill="White" Width="42" Height="42" />
                                                    <!-- Square (Recent Apps) -->
                                                    <Rectangle Fill="Transparent" Stroke="White" StrokeThickness="4" Width="42" Height="42" RadiusX="6" RadiusY="6" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Viewbox>
                                    <Canvas ClipToBounds="False">
                                        <!-- Infinite Top/Bottom Dimming for center column -->
                                        <Border Background="#99000000" Width="607.5" Height="10000" Canvas.Bottom="1080" />
                                        <Border Background="#99000000" Width="607.5" Height="10000" Canvas.Top="1080" />
                                    </Canvas>
                                </Grid>
                                
                                <!-- Infinite Right Dimming -->
                                <Canvas Grid.Column="2" ClipToBounds="False">
                                    <Border Background="#99000000" Width="10000" Height="20000" Canvas.Left="0" Canvas.Top="-5000" />
                                </Canvas>
                                
                                <!-- Highly Polished Realistic Phone Frame Overlay -->
                                <Grid Grid.Column="0" Grid.ColumnSpan="3" Width="666" Height="1050" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Volume Up -->
                                    <Border Width="8" Height="60" Background="#88cbd5e1" CornerRadius="4,0,0,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,200,0,0" />
                                    <!-- Volume Down -->
                                    <Border Width="8" Height="60" Background="#88cbd5e1" CornerRadius="4,0,0,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,280,0,0" />
                                    <!-- Power -->
                                    <Border Width="8" Height="100" Background="#88cbd5e1" CornerRadius="0,4,4,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,250,0,0" />
                                    
                                    <!-- Main Phone Frame Body -->
                                    <Border Width="650" Height="1050" HorizontalAlignment="Center"
                                            BorderBrush="#B3cbd5e1" BorderThickness="10" CornerRadius="50"
                                            Background="Transparent"
                                            BoxShadow="0 40 80 15 #E6000000">
                                        <!-- Inner Bezel (Screen Edge) -->
                                        <Border BorderBrush="#F2000000" BorderThickness="12" CornerRadius="40">
                                            <!-- Subtle screen glare/reflection -->
                                            <Border Background="Transparent" CornerRadius="28" ClipToBounds="True">
                                                <Path Data="M 0,0 L 650,0 L 0,1050 Z" Fill="#0AFFFFFF" />
                                            </Border>
                                        </Border>
                                    </Border>
                                    
                                    <!-- Camera Island (Dynamic Island / Notch) -->
                                    <Border Width="140" Height="36" Background="#111111" CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
                                        <Grid>
                                            <!-- Camera Lens Reflection -->
                                            <Ellipse Width="16" Height="16" Fill="#222222" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                            <Ellipse Width="6" Height="6" Fill="#444455" HorizontalAlignment="Right" Margin="0,0,15,0" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Viewbox>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
