<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:CompileBindings="True"
             x:Class="FortniteVideoSoftware.App.AvaloniaApp"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <!-- Title Bar Tokens (brushed dark grey metal) -->
        <LinearGradientBrush x:Key="TitleBarBackground" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Offset="0.00" Color="#969ca4" />
            <GradientStop Offset="0.08" Color="#c2c7ce" />
            <GradientStop Offset="0.16" Color="#7e858e" />
            <GradientStop Offset="0.31" Color="#b5bbc3" />
            <GradientStop Offset="0.47" Color="#8a919a" />
            <GradientStop Offset="0.62" Color="#c8cdd3" />
            <GradientStop Offset="0.78" Color="#737a83" />
            <GradientStop Offset="1.00" Color="#a8aeb6" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="TitleBarForeground" Color="#111827" />
        <LinearGradientBrush x:Key="WindowTitleBorder" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0.00" Color="#aeb4bc" />
            <GradientStop Offset="0.14" Color="#767d86" />
            <GradientStop Offset="0.29" Color="#d0d4da" />
            <GradientStop Offset="0.46" Color="#868d96" />
            <GradientStop Offset="0.63" Color="#bdc3ca" />
            <GradientStop Offset="0.81" Color="#6f7780" />
            <GradientStop Offset="1.00" Color="#b2b8c0" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="#1e293b" />
        <SolidColorBrush x:Key="AppPanelBrush" Color="#334155" />
        <SolidColorBrush x:Key="AppBorderBrush" Color="#475569" />
        <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#ffffff" />
        <SolidColorBrush x:Key="AppTextMutedBrush" Color="#b6c2d0" />
        <SolidColorBrush x:Key="AppAccentBrush" Color="#60a5fa" />
        <SolidColorBrush x:Key="AppInfoBrush" Color="#38bdf8" />
        <SolidColorBrush x:Key="AppSuccessBrush" Color="#22c55e" />
        <SolidColorBrush x:Key="AppDangerBrush" Color="#dc2626" />
        <SolidColorBrush x:Key="AppWarningBrush" Color="#facc15" />
        <SolidColorBrush x:Key="AppOverlayBrush" Color="#aa000000" />
        <SolidColorBrush x:Key="AppControlTrackBrush" Color="#222222" />
        <SolidColorBrush x:Key="AppVideoRailBrush" Color="#15202b" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="TextBlock.WindowTitleText">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <!-- Issue #1: Buttons MUST be focusable for keyboard navigation (WCAG 2.1.1, 2.4.7) -->
        <Style Selector="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1,1,1,2"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.05"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- Issue #1: Visible focus ring on all focusable buttons -->
        <Style Selector="Button:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="#7dd3fc"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="#38bdf8"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="ToggleButton:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="#7dd3fc"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="ToggleButton:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="#38bdf8"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="Border.InteractiveFocus:focus">
            <Setter Property="BorderBrush" Value="#7dd3fc"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Border.InteractiveFocus:focus-visible">
            <Setter Property="BorderBrush" Value="#38bdf8"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="RenderTransform" Value="translateY(2px)"/>
        </Style>

        <Style Selector="StackPanel.SpeedPresetRows">
            <Setter Property="Spacing" Value="3"/>
        </Style>

        <Style Selector="Button.SpeedPreset">
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="MinWidth" Value="31"/>
            <Setter Property="MinHeight" Value="25"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource AppPanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.SpeedPreset:pointerover">
            <Setter Property="Background" Value="#4a3714"/>
            <Setter Property="Foreground" Value="#fef3c7"/>
            <Setter Property="BorderBrush" Value="#a16207"/>
        </Style>
        <Style Selector="Button.SpeedPreset:pressed">
            <Setter Property="Background" Value="#60a5fa"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.BaseSpeedPreset">
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Background" Value="#14532d"/>
            <Setter Property="Foreground" Value="#86efac"/>
        </Style>
        <Style Selector="Button.BaseSpeedPreset:pointerover">
            <Setter Property="Background" Value="#166534"/>
        </Style>
        <Style Selector="Button.BaseSpeedPreset:pressed">
            <Setter Property="Background" Value="#22c55e"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Primary Buttons (Bright Blue) -->
        <Style Selector="Button.Primary">
            <Setter Property="BorderBrush" Value="#174f6b"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0.0" Color="#4ea1ca"/>
                    <GradientStop Offset="0.15" Color="#3484ac"/>
                    <GradientStop Offset="1.0" Color="#287397"/>
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.Primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0.0" Color="#63b5dd"/>
                    <GradientStop Offset="0.15" Color="#4ea1ca"/>
                    <GradientStop Offset="1.0" Color="#3a8bb2"/>
                </LinearGradientBrush>
            </Setter>
        </Style>

        <!-- Voiceover entry: distinct from general primary actions in the main editing controls. -->
        <Style Selector="Button.VoiceOverEntry">
            <Setter Property="BorderBrush" Value="#0e7490"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0.0" Color="#38bdf8"/>
                    <GradientStop Offset="0.18" Color="#0891b2"/>
                    <GradientStop Offset="1.0" Color="#155e75"/>
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.VoiceOverEntry:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0.0" Color="#67e8f9"/>
                    <GradientStop Offset="0.18" Color="#06b6d4"/>
                    <GradientStop Offset="1.0" Color="#0e7490"/>
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.VoiceOverEntry:disabled">
            <Setter Property="Foreground" Value="#88ffffff"/>
            <Setter Property="BorderBrush" Value="#2a3340"/>
        </Style>
        <Style Selector="Button.VoiceOverEntry:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3a4452"/>
        </Style>

        <Style Selector="Button.Primary:disabled">
            <Setter Property="Foreground" Value="#b0c4de"/>
            <Setter Property="BorderBrush" Value="#334155"/>
        </Style>
        <Style Selector="Button.Primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#475569"/>
        </Style>

        <!-- Secondary Buttons (Metallic Gray) -->
        <Style Selector="Button.Secondary">
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0.0" Color="#64748b"/>
                    <GradientStop Offset="0.15" Color="#475569"/>
                    <GradientStop Offset="1.0" Color="#334155"/>
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.Secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0.0" Color="#94a3b8"/>
                    <GradientStop Offset="0.15" Color="#64748b"/>
                    <GradientStop Offset="1.0" Color="#475569"/>
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.Secondary:disabled">
            <Setter Property="Foreground" Value="#b0c4de"/>
            <Setter Property="BorderBrush" Value="#334155"/>
        </Style>
        <Style Selector="Button.Secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#475569"/>
        </Style>

        <Style Selector="ToggleButton.Primary:disabled">
            <Setter Property="Foreground" Value="#b0c4de"/>
            <Setter Property="BorderBrush" Value="#334155"/>
        </Style>
        <Style Selector="ToggleButton.Primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#475569"/>
        </Style>

        <!-- Success Buttons (Metallic Green) -->
        <Style Selector="Button.Success">
            <Setter Property="BorderBrush" Value="#14532d"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0.0" Color="#22c55e"/>
                    <GradientStop Offset="0.15" Color="#15803d"/>
                    <GradientStop Offset="1.0" Color="#14532d"/>
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.Success:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0.0" Color="#4ade80"/>
                    <GradientStop Offset="0.15" Color="#16a34a"/>
                    <GradientStop Offset="1.0" Color="#166534"/>
                </LinearGradientBrush>
            </Setter>
        </Style>

        <!-- Issue #1: Disabled Success buttons — flat muted gray, low-opacity text -->
        <Style Selector="Button.Success:disabled">
            <Setter Property="Foreground" Value="#b0c4de"/>
            <Setter Property="BorderBrush" Value="#334155"/>
        </Style>
        <Style Selector="Button.Success:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#475569"/>
        </Style>

        <!-- Danger Buttons (Metallic Red) -->
        <Style Selector="Button.Danger">
            <Setter Property="BorderBrush" Value="#711616"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0.0" Color="#dc2626"/>
                    <GradientStop Offset="0.15" Color="#991b1b"/>
                    <GradientStop Offset="1.0" Color="#711616"/>
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.Danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0.0" Color="#ef4444"/>
                    <GradientStop Offset="0.15" Color="#b91c1c"/>
                    <GradientStop Offset="1.0" Color="#7f1d1d"/>
                </LinearGradientBrush>
            </Setter>
        </Style>

        <!-- Issue #1: Disabled Danger buttons — flat muted gray, low-opacity text -->
        <Style Selector="Button.Danger:disabled">
            <Setter Property="Foreground" Value="#b0c4de"/>
            <Setter Property="BorderBrush" Value="#334155"/>
        </Style>
        <Style Selector="Button.Danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#475569"/>
        </Style>

        <!-- Issue #1: Universal slider thumb — enlarged resting dot (~1.5x) that grows SLOWLY to 2x when grabbed.
             Applies to ALL sliders app-wide (root inheritance). The 0.3s transition gives the slow "grow" feel. -->
        <Style Selector="Slider /template/ Thumb">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="MinHeight" Value="18" />
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="ZIndex" Value="9999" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" />
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Slider">
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Slider /template/ DataValidationErrors">
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
        <Style Selector="Slider /template/ Track">
            <Setter Property="ClipToBounds" Value="False" />
            <Setter Property="ZIndex" Value="9998" />
        </Style>
        <Style Selector="Slider /template/ Grid">
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
        <Style Selector="Slider /template/ Border">
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
        <Style Selector="Slider:pointerover /template/ Thumb">
            <Setter Property="RenderTransform" Value="scale(1.4)" />
            <Setter Property="Background">
                <RadialGradientBrush>
                    <GradientStop Offset="0.0" Color="#7dd3fc" />
                    <GradientStop Offset="0.5" Color="#38bdf8" />
                    <GradientStop Offset="1.0" Color="#0ea5e9" />
                </RadialGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Slider:pressed /template/ Thumb">
            <Setter Property="RenderTransform" Value="scale(2.0)" />
        </Style>
        <!-- CompactSlider (timeline scrubber + vertical volume): resting dot 21px = 1.5x of the prior 14px -->
        <Style Selector="Slider.CompactSlider /template/ Thumb">
            <Setter Property="Width" Value="21" />
            <Setter Property="Height" Value="21" />
            <Setter Property="MinWidth" Value="21" />
            <Setter Property="MinHeight" Value="21" />
        </Style>
        <Style Selector="Slider.CompactSlider:pointerover /template/ Thumb">
            <Setter Property="RenderTransform" Value="scale(1.3)" />
            <Setter Property="Background">
                <RadialGradientBrush>
                    <GradientStop Offset="0.0" Color="#7dd3fc" />
                    <GradientStop Offset="0.5" Color="#38bdf8" />
                    <GradientStop Offset="1.0" Color="#0ea5e9" />
                </RadialGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Slider.CompactSlider:pressed /template/ Thumb">
            <Setter Property="RenderTransform" Value="scale(2.0)" />
        </Style>

        <!-- ISSUE_015: ComboBox cursor + focus consistency -->
        <Style Selector="ComboBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
        </Style>
        <Style Selector="ComboBox:focus /template/ Border#Background">
            <Setter Property="BorderBrush" Value="#7dd3fc"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="ComboBox:focus-visible /template/ Border#Background">
            <Setter Property="BorderBrush" Value="#38bdf8"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Issue #17: CheckBox hover/focus feedback -->
        <Style Selector="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="CheckBox:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="#22ffffff" />
        </Style>
        <Style Selector="CheckBox:focus /template/ Border#Root">
            <Setter Property="BorderBrush" Value="#7dd3fc" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="CheckBox:focus-visible /template/ Border#Root">
            <Setter Property="BorderBrush" Value="#38bdf8" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="Canvas.TimelineSeekSurface:pointerover">
            <Setter Property="Background" Value="#1838bdf8" />
        </Style>
        <Style Selector="Canvas.TimelineSeekSurface:focus">
            <Setter Property="Background" Value="#2638bdf8" />
        </Style>
        <Style Selector="Canvas.TimelineSeekSurface:focus-visible">
            <Setter Property="Background" Value="#3338bdf8" />
        </Style>
        <Style Selector="Grid.TimelineSeekSurface:pointerover">
            <Setter Property="Background" Value="#1838bdf8" />
        </Style>
        <Style Selector="Grid.TimelineSeekSurface:focus">
            <Setter Property="Background" Value="#2638bdf8" />
        </Style>
        <Style Selector="Grid.TimelineSeekSurface:focus-visible">
            <Setter Property="Background" Value="#3338bdf8" />
        </Style>

        <!-- Issue #17: ListBoxItem hover/focus feedback -->
        <Style Selector="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.08" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="#1a38bdf8" />
        </Style>
        <Style Selector="ListBoxItem:focus">
            <Setter Property="BorderBrush" Value="#38bdf8" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ListBoxItem:focus-visible">
            <Setter Property="BorderBrush" Value="#38bdf8" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="#2d4ea1ca" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="#3d63b5dd" />
        </Style>

        <!-- ToggleButton must match Button styling for consistency (e.g., FREEZE FRAME) -->
        <Style Selector="ToggleButton">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1,1,1,2"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.05"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="RenderTransform" Value="translateY(2px)"/>
        </Style>
        <Style Selector="ToggleButton.Primary">
            <Setter Property="BorderBrush" Value="#174f6b"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0.0" Color="#4ea1ca"/>
                    <GradientStop Offset="0.15" Color="#3484ac"/>
                    <GradientStop Offset="1.0" Color="#287397"/>
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.Primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0.0" Color="#63b5dd"/>
                    <GradientStop Offset="0.15" Color="#4ea1ca"/>
                    <GradientStop Offset="1.0" Color="#3a8bb2"/>
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.Primary:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0.0" Color="#4ade80"/>
                    <GradientStop Offset="0.15" Color="#16a34a"/>
                    <GradientStop Offset="1.0" Color="#166534"/>
                </LinearGradientBrush>
            </Setter>
        </Style>

        <!-- Issue #3: Checked toggle hover — subtly brightened green gradient for tactile feedback -->
        <Style Selector="ToggleButton.Primary:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0.0" Color="#86efac"/>
                    <GradientStop Offset="0.15" Color="#22c55e"/>
                    <GradientStop Offset="1.0" Color="#1d7a42"/>
                </LinearGradientBrush>
            </Setter>
        </Style>

        <!-- Issue #11: Close button style for FinishedDialog and other borderless windows -->
        <Style Selector="Button.CloseBtn">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#7DD3FC" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.CloseBtn:pointerover">
            <Setter Property="Background" Value="#227DD3FC" />
            <Setter Property="Foreground" Value="#bae6fd" />
        </Style>
        <Style Selector="Button.CloseBtn:pressed">
            <Setter Property="Background" Value="#447DD3FC" />
        </Style>

        <Style Selector="MenuItem">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Styles>
</Application>
