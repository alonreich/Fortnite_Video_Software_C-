<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:CompileBindings="True"
        xmlns:local="clr-namespace:FortniteVideoSoftware.App"
        x:Class="FortniteVideoSoftware.App.MusicWizardWindow"
        Title="Background Music Selection Wizard"
        Background="{DynamicResource AppSurfaceBrush}"
        CanResize="True"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="Manual"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30"
        DragDrop.AllowDrop="True">

    <Grid>
        <Border Name="MainBorder" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="0" Padding="0" BorderBrush="{DynamicResource WindowTitleBorder}" BorderThickness="5">
            <Grid RowDefinitions="30, *">
                <Border Name="TitleBarBorder" Grid.Row="0" Background="{DynamicResource TitleBarBackground}">
                    <TextBlock Name="TitleBarText" Classes="WindowTitleText" Text="{Binding $parent[Window].Title}" Foreground="{DynamicResource TitleBarForeground}" />
                </Border>
                <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" Margin="20">

                    <!-- Step Progress Bar -->
                    <!-- ISSUE_07: dots live in row 0 and labels in row 1; the connector lines sit in
                         row 0 with VerticalAlignment="Center", so they stay aligned to the middle of the dots -->
                    <Grid Grid.Row="0" Margin="0,0,0,15" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="50,0,50,0" Height="2" Background="{DynamicResource AppPanelBrush}"/>
                        <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="50,0,50,0" Height="2" Background="{DynamicResource AppPanelBrush}"/>
                        <!-- ISSUE_05: Min sizes (not fixed) so the numbered dots grow with the Settings font scale -->
                        <Border Grid.Row="0" Grid.Column="0" Name="Step1Dot" MinWidth="32" MinHeight="32" CornerRadius="16" Background="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center" ZIndex="1">
                            <TextBlock Name="Step1Icon" Text="1" Foreground="{DynamicResource AppTextPrimaryBrush}" FontWeight="Bold" FontSize="{DynamicResource AppFontSize14}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Row="1" Grid.Column="0" Name="Step1Label" Text="Select Music" Foreground="{DynamicResource AppAccentBrush}" FontSize="{DynamicResource AppFontSize9}" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,4,0,0"/>
                        <Border Grid.Row="0" Grid.Column="1" Name="Step2Dot" MinWidth="32" MinHeight="32" CornerRadius="16" Background="{DynamicResource AppPanelBrush}" HorizontalAlignment="Center" ZIndex="1">
                            <TextBlock Name="Step2Icon" Text="2" Foreground="{DynamicResource AppTextMutedBrush}" FontWeight="Bold" FontSize="{DynamicResource AppFontSize14}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Row="1" Grid.Column="1" Name="Step2Label" Text="Mix and Preview" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize9}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <Border Grid.Row="0" Grid.Column="2" Name="Step3Dot" MinWidth="32" MinHeight="32" CornerRadius="16" Background="{DynamicResource AppPanelBrush}" HorizontalAlignment="Center" ZIndex="1">
                            <TextBlock Name="Step3Icon" Text="3" Foreground="{DynamicResource AppTextMutedBrush}" FontWeight="Bold" FontSize="{DynamicResource AppFontSize14}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Row="1" Grid.Column="2" Name="Step3Label" Text="Confirm" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize9}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </Grid>

                    <!-- Step Container -->
                    <Border Grid.Row="1" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource AppPanelBrush}" BorderThickness="1" Padding="20">
                        <Panel>

                            <!-- STEP 1: Track Selection -->
                            <Grid Name="Step1Panel" IsVisible="True" RowDefinitions="Auto,Auto,*">
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,10">
                                    <TextBlock Grid.Column="0" Text="SELECT BACKGROUND MUSIC" FontSize="{DynamicResource AppFontSize14}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Name="ChangeFolderBtn" Content="Change Folder" Classes="Primary" VerticalAlignment="Center" Cursor="Hand" ToolTip.Tip="Choose a different folder to browse for music files"/>
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,10">
                                    <TextBox Grid.Column="0" Name="MusicSearchBox" Watermark="Search songs" Text="{Binding $parent[local:MusicWizardWindow].MusicSearchText, Mode=TwoWay}" MinHeight="32" FontSize="{DynamicResource AppFontSize11}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Name="ClearSearchBtn" Content="X" Classes="Secondary" MinWidth="36" Margin="8,0,0,0" HorizontalContentAlignment="Center" ToolTip.Tip="Clear search" AutomationProperties.Name="Clear Search"/>
                                    <ComboBox Grid.Column="2" Name="MusicSortComboBox" MinWidth="150" Margin="8,0,0,0" SelectedIndex="0" VerticalAlignment="Center" ToolTip.Tip="Change how the music files are sorted.">
                                        <ComboBoxItem Content="Name"/>
                                        <ComboBoxItem Content="Newest"/>
                                        <ComboBoxItem Content="Shortest"/>
                                        <ComboBoxItem Content="Longest"/>
                                    </ComboBox>
                                    <TextBlock Grid.Column="3" Name="MusicResultCountText" Text="0 songs" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                                <Grid Grid.Row="2">
                                    <ListBox Name="MusicListBox" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="4" Padding="2" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.AllowAutoHide="False">
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="MinHeight" Value="24"/>
                                                <Setter Property="Margin" Value="0,0,0,1"/>
                                            </Style>
                                        </ListBox.Styles>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="local:MusicTrackItem">
                                                <Border Padding="5,2" CornerRadius="4" Cursor="Hand" ToolTip.Tip="Click to select this track">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                        <TextBlock Grid.Column="0" Text="{CompiledBinding PinText}" Foreground="{DynamicResource AppAccentBrush}" FontSize="{DynamicResource AppFontSize9}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="1" Text="{CompiledBinding Name}" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize11}" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="2" Text="{CompiledBinding SizeText}" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                        <TextBlock Grid.Column="3" Text="{CompiledBinding DurationText}" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize11}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,20,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Name="EmptyMusicListText" Text="No music files found. Change folder or drop an audio file here." Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize12}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False" IsVisible="False"/>
                                </Grid>
                            </Grid>

                            <!-- STEP 2: Waveform + Song Start -->
                            <ScrollViewer Name="Step2Panel" IsVisible="False" VerticalScrollBarVisibility="Auto">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
                                    <Border Grid.Row="0" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Selected:" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize11}" VerticalAlignment="Center"/>
                                            <TextBlock Name="SelectedTrackLabel" Text="-" Foreground="{DynamicResource AppTextPrimaryBrush}" FontWeight="Bold" FontSize="{DynamicResource AppFontSize11}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Grid.Row="1" Text="CHOOSE WHERE THE SONG BEGINS" FontSize="{DynamicResource AppFontSize14}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,0,5"/>

                                    <Border Grid.Row="2" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="4" BorderBrush="{DynamicResource AppPanelBrush}" BorderThickness="1" Margin="0,5" Height="120">
                                        <Panel>
                                            <Image Name="WaveformImage" Stretch="Fill"/>
                                            <Canvas Name="WaveformCanvas" Classes="TimelineSeekSurface" ClipToBounds="True" Background="Transparent" Cursor="Hand" Focusable="True" AutomationProperties.Name="Song start waveform seek area" ToolTip.Tip="Click the point in the song where the video should begin" KeyboardNavigation.IsTabStop="True" />
                                            <TextBlock Name="WaveformLoadingText" Text="Generating Waveform..." Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize14}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False"/>
                                        </Panel>
                                    </Border>

                                    <StackPanel Grid.Row="3" Spacing="0">
                                        <Grid VerticalAlignment="Center" MinHeight="66" RowDefinitions="20,14,32" ClipToBounds="False">
                                            <Canvas Name="TimelineScaleCanvas" Grid.Row="1" IsHitTestVisible="False" ClipToBounds="False" HorizontalAlignment="Stretch" Height="14" ZIndex="10000" />
                                            <Grid Grid.Row="2" Height="32" ClipToBounds="False" ZIndex="10001">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource AppPanelBrush}" VerticalAlignment="Center" IsHitTestVisible="False" />
                                            </Grid>
                                            <Canvas Name="TimelineMarkersCanvas" Classes="TimelineSeekSurface" Grid.Row="0" Grid.RowSpan="3" Background="Transparent" IsHitTestVisible="True" ClipToBounds="False" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ZIndex="10003" Cursor="Hand" Focusable="True" AutomationProperties.Name="Song start timeline seek area" ToolTip.Tip="Click the point in the song where the video should begin" KeyboardNavigation.IsTabStop="True" />
                                        </Grid>
                                        <TextBlock Name="OffsetLabel" Text="Song begins at 0.0s" Foreground="{DynamicResource AppInfoBrush}" FontWeight="Bold" HorizontalAlignment="Center" FontSize="{DynamicResource AppFontSize11}" Margin="0,5,0,5" IsVisible="True"/>
                                        <Grid Margin="0,6,0,0" ColumnDefinitions="Auto,Auto,*">
                                            <Button Grid.Column="0" Name="BeatSnapBtn" Content="Snap To Beat" Classes="Secondary" MinWidth="110" FontSize="{DynamicResource AppFontSize10}" HorizontalContentAlignment="Center" ToolTip.Tip="Move the song start to the nearest strong beat."/>
                                            <Button Grid.Column="1" Name="SmartFitBtn" Content="Smart Fit" Classes="Primary" MinWidth="100" FontSize="{DynamicResource AppFontSize10}" HorizontalContentAlignment="Center" Margin="8,0,0,0" ToolTip.Tip="Pick a strong song section that fits the video length."/>
                                            <TextBlock Grid.Column="2" Name="SmartFitStatusText" Text="" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="10,0,0,0"/>
                                        </Grid>

                                        <StackPanel Spacing="10" Margin="0,10,0,0">
                                            <CheckBox Name="DuckingCheckBox" Content="Auto-lower music during loud game sounds" IsChecked="True" Foreground="{DynamicResource AppTextPrimaryBrush}" ToolTip.Tip="Makes the music quieter when the game audio is loud, so you can hear both clearly."/>
                                            <CheckBox Name="CarvingCheckBox" Content="Smooth blend between music and game audio" IsChecked="True" Foreground="{DynamicResource AppTextPrimaryBrush}" ToolTip.Tip="Adjusts frequencies so the music and game audio don't clash."/>
                                        </StackPanel>

                                        <!-- MULTI SONG HELPER (Video Merger Mode) -->
                                        <StackPanel Name="MultiSongHelperPanel" IsVisible="False" Margin="0,15,0,0">
                                            <Border Background="{DynamicResource AppOverlayBrush}" BorderBrush="{DynamicResource AppAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                                                <StackPanel Spacing="10">
                                                    <!-- Coverage Bar -->
                                                    <StackPanel Spacing="4">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Text="MUSIC COVERAGE" Foreground="{DynamicResource AppAccentBrush}" FontWeight="Bold" FontSize="{DynamicResource AppFontSize10}"/>
                                                            <TextBlock Grid.Column="1" Name="CoveragePercentText" Text="0%" Foreground="{DynamicResource AppWarningBrush}" FontWeight="Bold" FontSize="{DynamicResource AppFontSize10}"/>
                                                        </Grid>
                                                        <Border Height="20" CornerRadius="4" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" ClipToBounds="True">
                                                            <Grid>
                                                                <Border Name="CoverageBarFill" Background="{DynamicResource AppSuccessBrush}" CornerRadius="3" HorizontalAlignment="Left" Width="0" MinWidth="0"/>
                                                                <TextBlock Name="CoverageBarText" Text="" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize9}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                                            </Grid>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Warning Banner -->
                                                    <Border Name="CoverageWarningBanner" Background="{DynamicResource AppOverlayBrush}" BorderBrush="{DynamicResource AppWarningBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" IsVisible="False">
                                                        <TextBlock Name="CoverageWarningText" Text="" Foreground="{DynamicResource AppWarningBrush}" FontWeight="Bold" FontSize="{DynamicResource AppFontSize10}" TextWrapping="Wrap"/>
                                                    </Border>

                                                    <!-- Loop Toggle -->
                                                    <CheckBox Name="LoopMusicCheckBox" Content="Loop music until video ends" IsChecked="False" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize10}" ToolTip.Tip="Repeat the song from the beginning when it ends so music covers the entire video"/>

                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <Button Grid.Column="0" Name="AutoFillSongsBtn" Classes="Primary" Content="Auto-Fill Remaining Time" HorizontalAlignment="Left" FontSize="{DynamicResource AppFontSize10}" ToolTip.Tip="Automatically add songs from your music folder to cover remaining silence in the video."/>
                                                        <CheckBox Grid.Column="1" Name="AutoFillVisibleOnlyCheckBox" Content="Use visible search results for Auto-Fill" IsChecked="True" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize10}" VerticalAlignment="Center" ToolTip.Tip="When enabled, Auto-Fill uses the current search and sort results."/>
                                                    </Grid>

                                                    <Grid Name="AutoFillQueuePanel" RowDefinitions="Auto,Auto,Auto" IsVisible="False">
                                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,6">
                                                            <TextBlock Grid.Column="0" Name="AutoFillQueueSummaryText" Text="QUEUE" Foreground="{DynamicResource AppAccentBrush}" FontWeight="Bold" FontSize="{DynamicResource AppFontSize10}" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Name="QueueMoveUpBtn" Classes="Secondary" Content="Up" MinWidth="54" FontSize="{DynamicResource AppFontSize10}" HorizontalContentAlignment="Center" ToolTip.Tip="Move the selected track up in the queue."/>
                                                            <Button Grid.Column="2" Name="QueueMoveDownBtn" Classes="Secondary" Content="Down" MinWidth="64" FontSize="{DynamicResource AppFontSize10}" HorizontalContentAlignment="Center" Margin="6,0,0,0" ToolTip.Tip="Move the selected track down in the queue."/>
                                                            <Button Grid.Column="3" Name="QueueRemoveBtn" Classes="Secondary" Content="Remove" MinWidth="74" FontSize="{DynamicResource AppFontSize10}" HorizontalContentAlignment="Center" Margin="6,0,0,0" ToolTip.Tip="Remove the selected track from the queue."/>
                                                        </Grid>
                                                        <ListBox Grid.Row="1" Name="AutoFillQueueList" MinHeight="96" MaxHeight="200" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate x:DataType="local:MusicQueueItem">
                                                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,2">
                                                                        <!-- ISSUE_11 (audit round 4): MinWidth (was fixed Width) per the Font-Scale Sizing Rule -->
                                                                        <TextBlock Grid.Column="0" Text="{CompiledBinding OrderText}" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" MinWidth="32"/>
                                                                        <TextBlock Grid.Column="1" Text="{CompiledBinding Name}" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize10}" TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Grid.Column="2" Text="{CompiledBinding DurationText}" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" Margin="10,0,0,0"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                        <TextBlock Grid.Row="2" Name="AutoFillRemainingText" Text="" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" Margin="0,5,0,0"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>

                            <!-- STEP 3: Final Review Summary -->
                            <Grid Name="Step3Panel" IsVisible="False" RowDefinitions="Auto, *, Auto, Auto">
                                <StackPanel Grid.Row="0" Margin="0,0,0,10" Spacing="3">
                                    <TextBlock Text="CONFIRM MUSIC" FontSize="{DynamicResource AppFontSize14}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}"/>
                                    <TextBlock Name="FinalPlacementLabel" Text="The video and music preview will end together at the video end." Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize11}"/>
                                    <TextBlock Name="Phase3StatusLabel" Text="" Foreground="{DynamicResource AppWarningBrush}" FontSize="{DynamicResource AppFontSize10}"/>
                                    <Border Name="ProblemFlagsPanel" Background="{DynamicResource AppOverlayBrush}" BorderBrush="{DynamicResource AppWarningBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" IsVisible="False">
                                        <TextBlock Name="ProblemFlagsText" Text="" Foreground="{DynamicResource AppWarningBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>

                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Border Name="VideoHostBorder" Background="{DynamicResource AppVideoSurfaceBrush}" CornerRadius="6" ClipToBounds="True">
                                    </Border>
                                    <Border Name="Phase3VideoLoadingOverlay" Background="{DynamicResource AppOverlayBrush}" CornerRadius="6" IsHitTestVisible="False" IsVisible="False">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                            <ProgressBar IsIndeterminate="True" Width="100" Height="4" Foreground="{DynamicResource AppAccentBrush}" Background="{DynamicResource AppPanelBrush}"/>
                                            <TextBlock Text="Initializing Video Preview..." Foreground="{DynamicResource AppTextPrimaryBrush}" FontWeight="Bold" FontSize="{DynamicResource AppFontSize14}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="2" ZIndex="10" Margin="0,0,0,15" ClipToBounds="False" RowDefinitions="20,Auto">
                                    <Canvas Grid.Row="0" Name="Phase3TimelineCanvas" Height="20" Cursor="Hand" HorizontalAlignment="Stretch" ClipToBounds="False"/>
                                    <StackPanel Grid.Row="1" Spacing="0">
                                        <Border BorderBrush="{DynamicResource AppPanelBrush}" BorderThickness="2" CornerRadius="2" Height="60" Margin="0">
                                            <Panel>
                                                <Grid Name="ThumbnailLaneGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True"/>
                                                <Canvas Name="ThumbnailOverlayCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True"/>
                                                <Border Name="Phase3ThumbLoadingOverlay" Background="{DynamicResource AppOverlayBrush}" IsHitTestVisible="False" IsVisible="False">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                                                        <ProgressBar IsIndeterminate="True" Width="60" Height="3" Foreground="{DynamicResource AppWarningBrush}" Background="{DynamicResource AppPanelBrush}"/>
                                                        <TextBlock Text="Generating Frames..." Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize10}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Panel>
                                        </Border>
                                        <Border BorderBrush="{DynamicResource AppPanelBrush}" BorderThickness="2" CornerRadius="2" Height="60">
                                            <Panel>
                                                <Canvas Name="Phase3WaveformClip" ClipToBounds="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                    <Image Name="WaveformLaneImage" Stretch="Fill" Height="60" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                    <Canvas Name="WaveformOverlayCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True"/>
                                                </Canvas>
                                                <Border Name="Phase3WaveLoadingOverlay" Background="{DynamicResource AppOverlayBrush}" IsHitTestVisible="False" IsVisible="False">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                                                        <ProgressBar IsIndeterminate="True" Width="60" Height="3" Foreground="{DynamicResource AppSuccessBrush}" Background="{DynamicResource AppPanelBrush}"/>
                                                        <TextBlock Text="Generating Waveform..." Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize10}" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Panel>
                                        </Border>
                                    </StackPanel>
                                    <Canvas Grid.Row="1" Name="Phase3SeekCanvas" Classes="TimelineSeekSurface" Background="Transparent" Cursor="Hand" Focusable="True" AutomationProperties.Name="Final preview seek area" ToolTip.Tip="Click to seek the video and audio preview" IsHitTestVisible="True" ClipToBounds="False" KeyboardNavigation.IsTabStop="True" />
                                    <Panel Grid.Row="1" Name="Phase3CaretCanvas" ZIndex="20" IsHitTestVisible="False" ClipToBounds="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <Border Name="Phase3Caret" Width="2" Background="{DynamicResource AppDangerBrush}" IsVisible="False" HorizontalAlignment="Left" VerticalAlignment="Stretch" RenderTransform="translateY(0px)"/>
                                        <Border Name="Phase3CaretTextBorder" IsVisible="False" Background="{DynamicResource AppOverlayBrush}" CornerRadius="2" Padding="4,2" Margin="4,2" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Name="Phase3CaretTimeText" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold"/>
                                        </Border>
                                    </Panel>
                                </Grid>

                                <StackPanel Grid.Row="3" ZIndex="5" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="42" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Video Volume: 100%" Name="VideoVolLabel" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center" FontSize="{DynamicResource AppFontSize11}"/>
                                        <Slider Name="VideoVolSlider" Minimum="0" Maximum="100" Value="100" HorizontalAlignment="Stretch" MinWidth="150" MaxWidth="320" Height="30" IsSnapToTickEnabled="False" TickFrequency="1" ToolTip.Tip="Volume of the original video audio"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Music Volume: 100%" Name="MusicVolLabel" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center" FontSize="{DynamicResource AppFontSize11}"/>
                                        <Slider Name="MusicVolSlider" Minimum="0" Maximum="100" Value="100" HorizontalAlignment="Stretch" MinWidth="150" MaxWidth="320" Height="30" IsSnapToTickEnabled="False" TickFrequency="1" ToolTip.Tip="Volume of the background music"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Export Ducking" Name="DuckingCompareLabel" Foreground="{DynamicResource AppTextPrimaryBrush}" HorizontalAlignment="Center" FontSize="{DynamicResource AppFontSize11}"/>
                                        <Button Name="DuckingCompareBtn" Content="Export Ducking ON" Classes="Primary" MinWidth="130" HorizontalContentAlignment="Center" ToolTip.Tip="Toggle whether FFmpeg applies ducking during export."/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                        </Panel>
                    </Border>

                    <!-- Navigation -->
                    <Grid Grid.Row="2" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- ISSUE_05: MinWidth (not Width) so scaled fonts never clip nav button labels -->
                        <!-- ISSUE_08 (audit round 4): CANCEL is Secondary suite-wide (red = destructive data loss only) -->
                        <Button Grid.Column="0" Name="CancelBtn" Content="CANCEL" Classes="Secondary" MinWidth="90" HorizontalContentAlignment="Center" ToolTip.Tip="Cancel and close the wizard without saving"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                            <Button Name="SkipBackBtn" Classes="Secondary" MinWidth="70" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Skip back 30 seconds">
                                <TextBlock Text="-30s" FontWeight="Bold" FontSize="{DynamicResource AppFontSize11}" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                            </Button>
                            <!-- ISSUE_08: transport Play is Primary (blue) so it reads distinctly from the
                                 green "NEXT" progression button sharing this nav pane. -->
                            <Button Name="PlayBtn" Classes="Primary" MinWidth="70" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="Play or Pause" ToolTip.Tip="Preview how the music sounds">
                                <Panel Width="{DynamicResource AppFontSize16}" Height="{DynamicResource AppFontSize16}">
                                    <Path Name="PlayIcon" Data="{DynamicResource AppPlayIconGeometry}" Fill="{DynamicResource AppOnAccentTextBrush}" Stretch="Uniform"/>
                                    <Path Name="PauseIcon" IsVisible="False" Data="{DynamicResource AppPauseIconGeometry}" Fill="{DynamicResource AppOnAccentTextBrush}" Stretch="Uniform"/>
                                </Panel>
                            </Button>
                            <Button Name="SkipForwardBtn" Classes="Secondary" MinWidth="70" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Skip forward 30 seconds">
                                <TextBlock Text="+30s" FontWeight="Bold" FontSize="{DynamicResource AppFontSize11}" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                            </Button>
                        </StackPanel>
                        <Button Grid.Column="2" Name="BackBtn" Content="BACK" Classes="Secondary" MinWidth="90" HorizontalContentAlignment="Center" Margin="0,0,10,0" IsEnabled="False" IsVisible="True" ToolTip.Tip="Go back to the previous step"/>
                        <Button Grid.Column="3" Name="NextBtn" Content="NEXT" Classes="Success" MinWidth="90" HorizontalContentAlignment="Center" ToolTip.Tip="Proceed to the next step"/>
                    </Grid>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
