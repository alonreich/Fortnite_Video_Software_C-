<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:CompileBindings="True"
        xmlns:local="clr-namespace:FortniteVideoSoftware.App"
        x:Class="FortniteVideoSoftware.App.VideoMergerWindow"
        xmlns:controls="clr-namespace:FortniteVideoSoftware.App.Controls"
        Title="Fortnite Video Software - Merger"
        Background="{DynamicResource AppSurfaceBrush}"
        MinWidth="1200" MinHeight="700"
        WindowStartupLocation="Manual"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30">

    <!-- Video Queue: selection marching ants, hover glow, hand cursor -->
    <Window.Styles>
        <Style Selector="ListBoxItem:selected Rectangle.MarchingAnts">
            <Setter Property="IsVisible" Value="True"/>
            <Style.Animations>
                <Animation Duration="0:0:0.6" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="StrokeDashOffset" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="StrokeDashOffset" Value="6"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="ListBoxItem Rectangle.MarchingAnts">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ListBoxItem Border.ItemGlow">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem:pointerover Border.ItemGlow">
            <Setter Property="Background" Value="{DynamicResource AppAccentAlpha10Brush}"/>
            <Setter Property="BoxShadow" Value="{DynamicResource AppItemGlowHoverShadow}"/>
        </Style>
        <Style Selector="ListBoxItem:selected Border.ItemGlow">
            <Setter Property="Background" Value="{DynamicResource AppSuccessAlpha10Brush}"/>
            <Setter Property="BoxShadow" Value="{DynamicResource AppItemGlowSelectedShadow}"/>
        </Style>
        <Style Selector="#VideoList ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
    </Window.Styles>

    <Grid>
        <Border Name="MainBorder" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="0" Padding="0" BorderBrush="{DynamicResource WindowTitleBorder}" BorderThickness="5">
            <Grid RowDefinitions="30, Auto, *">
                <Border Name="TitleBarBorder" Grid.Row="0" Background="{DynamicResource TitleBarBackground}">
                    <TextBlock Name="TitleBarText" Classes="WindowTitleText" Text="{Binding $parent[Window].Title}" Foreground="{DynamicResource TitleBarForeground}" />
                </Border>

                <Menu Grid.Row="1" Background="{DynamicResource AppSurfaceBrush}" Foreground="{DynamicResource AppTextMutedBrush}" Padding="10,0" FontSize="{DynamicResource AppFontSize12}">
                    <MenuItem Header="_File">
                        <MenuItem Name="MenuAddVideo" Header="Add Video..." ToolTip.Tip="Browse your computer to select a new video file and add it to the merger list." />
                        <Separator />
                        <MenuItem Name="MenuOutputFolder" Header="Output Folder..." ToolTip.Tip="Choose the folder on your computer where the final merged video will be saved." />
                        <Separator />
                        <MenuItem Name="MenuSettings" Header="_Settings" ToolTip.Tip="Open advanced settings for video merging." />
                        <Separator />
                        <MenuItem Name="MenuReturnToApp" Header="Return to Main App" ToolTip.Tip="Close the merger and go back to the main editing studio." />
                        <MenuItem Name="MenuExit" Header="Exit" ToolTip.Tip="Close the application entirely." />
                    </MenuItem>
                    <MenuItem Header="_Edit">
                        <MenuItem Name="MenuRemoveSelected" Foreground="{DynamicResource AppDangerBrush}" ToolTip.Tip="Delete the currently highlighted videos from the list. They will not be included in the final merged video.">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="⚠️" />
                                    <TextBlock Text="Remove Selected" />
                                    <TextBlock Text="(WARNING: Cannot be undone)" FontSize="{DynamicResource AppFontSize9}" Foreground="{DynamicResource AppWarningBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Name="MenuClearAll" Foreground="{DynamicResource AppDangerBrush}" ToolTip.Tip="Completely empty the list of videos and start over fresh.">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="⚠️" />
                                    <TextBlock Text="Clear All" />
                                    <TextBlock Text="(WARNING: Cannot be undone)" FontSize="{DynamicResource AppFontSize9}" Foreground="{DynamicResource AppWarningBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                    </MenuItem>
                </Menu>

                <!-- FLIPPED: Queue on LEFT, Player on RIGHT -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto, *">

                    <!-- Ambient live-wallpaper bubbles (very gentle, non-interactive, behind all content).
                         Echoes the FluidVolumeSlider bubble aesthetic across the theme background. -->
                    <controls:AmbientBubblesBackground Grid.ColumnSpan="2" IsHitTestVisible="False" ZIndex="-1" />

                    <!-- LEFT PANEL: Video Queue & Controls -->
                    <Border Grid.Column="0" MinWidth="260" Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0" Padding="15">
                            <Grid RowDefinitions="Auto, *, Auto, Auto" ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="VIDEOS LIST" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize12}" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>

                                <Border Grid.Row="1" Grid.Column="0" Name="VideoListFrame" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,15">
                                <Grid>
                                    <ListBox Name="VideoList" Background="Transparent" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize11}" DragDrop.AllowDrop="True" SelectionMode="Multiple">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Grid MinHeight="30" ClipToBounds="False" ToolTip.Tip="{Binding}">
                                                    <Border Classes="ItemGlow" CornerRadius="3" Background="Transparent" BorderThickness="1"/>
                                                    <Rectangle Classes="MarchingAnts" Stroke="{DynamicResource AppWarningBrush}" StrokeThickness="1" StrokeDashArray="4,2" IsVisible="False" IsHitTestVisible="False" RadiusX="3" RadiusY="3"/>
                                                    <!-- Smart resize via Viewbox inside a constrained Grid -->
                                                    <Grid Margin="8,0" VerticalAlignment="Center" ColumnDefinitions="Auto, *">
                                                        <TextBlock Grid.Column="0" Text="🎬" FontSize="{DynamicResource AppFontSize10}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Converter={x:Static local:FileNameConverter.Instance}}" Cursor="Hand" FontSize="{DynamicResource AppFontSize12}" VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Name="EmptyQueueText" Text="Add at least one video to build a merge queue." Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize11}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18" IsHitTestVisible="False"/>
                                    <Border Name="DropIndicator" Height="3" Background="{DynamicResource AppInfoBrush}" CornerRadius="1.5" IsVisible="False" VerticalAlignment="Top" Margin="4,0,4,0" BoxShadow="{DynamicResource AppDropIndicatorShadow}" ZIndex="100" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Spacing="10" Margin="10,0,0,15">
                                <!-- ISSUE_07: icon-only buttons need AutomationProperties.Name for screen readers -->
                                <Button Name="MoveUpButton" Classes="Primary" Padding="12,12" CornerRadius="20" IsEnabled="False" AutomationProperties.Name="Move selected video up" ToolTip.Tip="Move the highlighted video higher up in the list so it plays earlier." HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand">
                                    <Polygon Points="6,0 12,8 0,8" Fill="{DynamicResource AppOnAccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0" Width="12" Height="10" Stretch="Uniform"/>
                                </Button>
                                <Button Name="MoveDownButton" Classes="Primary" Padding="12,12" CornerRadius="20" IsEnabled="False" AutomationProperties.Name="Move selected video down" ToolTip.Tip="Move the highlighted video lower down in the list so it plays later." HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand">
                                    <Polygon Points="0,0 12,0 6,8" Fill="{DynamicResource AppOnAccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0" Width="12" Height="10" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="8" Margin="0,0,0,15">
                                <Button Name="AddVideoButton" Classes="Primary" Content="ADD VIDEO" HorizontalAlignment="Stretch" ToolTip.Tip="Browse your computer and add another video to your list."/>
                                <Button Name="AddMusicButton" Classes="Secondary" HorizontalAlignment="Stretch" IsEnabled="False" ToolTip.Tip="Add a background song to play over your combined videos.">
                                    <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Fill="{DynamicResource AppTextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Data="M12,3v10.55c-0.59-0.34-1.27-0.55-2-0.55c-2.21,0-4,1.79-4,4s1.79,4,4,4s4-1.79,4-4V7h4V3H12z" />
                                        <TextBlock Name="AddMusicText" Text=" ADD MUSIC " FontSize="{DynamicResource AppFontSize12}" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,6,0" />
                                        <Path Fill="{DynamicResource AppTextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Data="M12,3v10.55c-0.59-0.34-1.27-0.55-2-0.55c-2.21,0-4,1.79-4,4s1.79,4,4,4s4-1.79,4-4V7h4V3H12z" />
                                    </StackPanel>
                                </Button>
                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Grid.Column="0" Text="⚠️" Foreground="{DynamicResource AppWarningBrush}" FontSize="{DynamicResource AppFontSize12}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Button Name="RemoveVideoButton" Grid.Column="1" Classes="Danger" Content="REMOVE SELECTED" HorizontalAlignment="Stretch" IsEnabled="False" ToolTip.Tip="Delete the currently highlighted video from your list.">
                                        <Button.Flyout>
                                            <Flyout Placement="Top">
                                                <StackPanel Spacing="8" Margin="8">
                                                    <TextBlock Text="⚠️ Cannot be undone" Foreground="{DynamicResource AppWarningBrush}" FontSize="{DynamicResource AppFontSize12}" FontWeight="Bold" />
                                                    <Button Name="ConfirmRemoveVideoButton" Classes="Danger" Content="CONFIRM REMOVE" HorizontalAlignment="Stretch" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </StackPanel>

                                <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Name="QueueStatusText" Text="Waiting for videos." Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize11}" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- RIGHT COLUMN: Player & Editing Controls -->
                    <Grid Grid.Column="1" RowDefinitions="*, Auto" ClipToBounds="False">

                        <!-- Video Player Area + Volume Slider -->
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,10,10,10" ClipToBounds="False">

                            <Border Name="VideoAreaBorder" Grid.Column="0" Background="{DynamicResource AppVideoSurfaceBrush}" CornerRadius="6" ClipToBounds="True" Padding="2" Focusable="True" KeyboardNavigation.TabNavigation="Cycle">
                                <Grid ClipToBounds="True" Name="MainVideoGrid" Focusable="True" Cursor="Hand">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <local:MpvVideoView Name="VideoHost" Grid.Row="0" />



                                    <Border Name="NoVideoOverlay" Grid.Row="0" Background="{DynamicResource AppOverlayBrush}" CornerRadius="4" IsVisible="True" ZIndex="500">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                            <TextBlock Text="🎬" FontSize="{DynamicResource AppFontSize48}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="No video loaded" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="{DynamicResource AppFontSize16}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Select a video from the queue to preview" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize11}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Name="TimelineOverlay" Grid.Row="1" VerticalAlignment="Bottom" Background="Transparent" ZIndex="9999" Cursor="Hand" ClipToBounds="False" IsVisible="False">
                                        <Border VerticalAlignment="Bottom" Background="{DynamicResource AppOverlayBrush}" Padding="8,4,8,4" ClipToBounds="False">
                                            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" ClipToBounds="False">
                                                <TextBlock Name="TimeElapsed" Text="00:00:00" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" MinWidth="64" FontSize="{DynamicResource AppFontSize10}" Margin="0,0,8,0" />
                                                <Grid Grid.Column="1" VerticalAlignment="Center" ClipToBounds="False">
                                                    <StackPanel Orientation="Vertical">
                                                        <Canvas Name="TimelineScaleCanvas" IsHitTestVisible="False" ClipToBounds="False" HorizontalAlignment="Stretch" Height="14" />
                                                        <Grid ClipToBounds="False">
                                                            <Slider Name="TimelineSlider" Classes="CompactSlider" Minimum="0" Maximum="100" MinHeight="44" VerticalAlignment="Center" ClipToBounds="False" ToolTip.Tip="Drag this left or right to quickly skip through different parts of the video." />
                                                            <Canvas Name="TimelineMarkersCanvas" Classes="TimelineSeekSurface" Focusable="True" KeyboardNavigation.IsTabStop="True" IsHitTestVisible="True" ClipToBounds="False" VerticalAlignment="Center" HorizontalAlignment="Stretch" Height="32" Cursor="Hand" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Grid.Column="2" Name="TimeRemaining" Text="-00:00:00" Foreground="{DynamicResource AppTextPrimaryBrush}" VerticalAlignment="Center" MinWidth="64" TextAlignment="Right" FontSize="{DynamicResource AppFontSize10}" Margin="8,0,0,0" />
                                            </Grid>
                                        </Border>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" CornerRadius="4" Background="{DynamicResource AppVideoRailBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="4,8" MinWidth="48" VerticalAlignment="Stretch" Margin="2,0,2,0" ClipToBounds="False" ZIndex="9999">
                                <Grid RowDefinitions="Auto, *, Auto" ClipToBounds="False" HorizontalAlignment="Stretch" Margin="0">
                                    <TextBlock Grid.Row="0" Name="VolumeBadgeText" Text="100%" Foreground="{DynamicResource AppInfoBrush}" FontSize="{DynamicResource AppFontSize12}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6" Opacity="1" />
                                    <!-- Custom fluid "test tube" volume slider (see Controls/FluidVolumeSlider.cs).
                                         Rollback to the previous standard Slider: old_code\volume_slider_rollback\ROLLBACK_INSTRUCTIONS.txt -->
                                    <controls:FluidVolumeSlider Grid.Row="1" Name="VolumeSlider" Orientation="Vertical" Minimum="0" Maximum="100" Value="100" Width="46" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,0,0,0" ToolTip.Tip="Slide up or down to make the video louder or quieter." Cursor="Hand" ClipToBounds="False" ZIndex="10000" Foreground="{DynamicResource AppInfoBrush}" />
                                    <!-- ISSUE_08: real Button (was a Border) so mute has identical semantics, focus visuals,
                                         pressed feedback and screen-reader role as the Main App's mute control. -->
                                    <Button Grid.Row="2" Name="SpeakerHitBox" MinWidth="35" MinHeight="35" Background="Transparent" BorderThickness="0" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0" ZIndex="10001" Cursor="Hand" Focusable="True" ToolTip.Tip="Click here to quickly mute or unmute the video." AutomationProperties.Name="Mute or restore volume" ClipToBounds="False">
                                        <Path Name="VolumeSpeakerIcon" Fill="Transparent" Stroke="{DynamicResource AppInfoBrush}" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransform="translateX(2px)" IsHitTestVisible="False" Data="M3,7 L6,7 L10,3 L10,13 L6,9 L3,9 Z M13,5 A4,4 0 0,1 13,11 M16,2 A8,8 0 0,1 16,14" />
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Bottom Controls --><!-- Bottom Controls -->
                        <Grid Grid.Row="1" Margin="0,8,10,8">
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Output Quality -->
                                <StackPanel Orientation="Vertical" Spacing="2" Margin="10" VerticalAlignment="Center">
                                    <TextBlock Text="OUTPUT QUALITY" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" />
                                    <controls:SpinningWheelSlider Name="QualitySlider" HorizontalAlignment="Stretch" MinWidth="180" MaxWidth="300" Height="35" Cursor="Hand" ToolTip.Tip="Slide left for a smaller file size, or right for higher video quality." />
                                    <TextBlock Name="QualityLabel" Text="100% — Lossless" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,0" VerticalAlignment="Top" TextTrimming="CharacterEllipsis" />
                                    <!-- ISSUE_09: duplicate EstimatedSizeText2 removed — the estimate is shown once, next to the output path -->
                                </StackPanel>

                                <!-- Transport Controls + Merge Button -->
                                <StackPanel Orientation="Vertical" Spacing="4" Margin="10" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,0,0,2">
                                        <!-- ISSUE_007: Fast backward uses LEFT-pointing triangles -->
                                        <Button Name="FastBackwardButton" Classes="Primary" MinWidth="50" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand" ToolTip.Tip="Skip backward 10 seconds in the video." Padding="0" IsEnabled="False" AutomationProperties.Name="Fast Backward 10 Seconds">
                                            <Panel Width="16" Height="16">
                                                <Polygon Points="6,2 6,14 0,8" Fill="{DynamicResource AppOnAccentTextBrush}"/>
                                                <Polygon Points="14,2 14,14 8,8" Fill="{DynamicResource AppOnAccentTextBrush}"/>
                                            </Panel>
                                        </Button>
                                        <Button Name="PlayPauseButton" Classes="Success" MinWidth="70" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AutomationProperties.Name="Play or Pause" ToolTip.Tip="Play or pause the video." Cursor="Hand" IsEnabled="False">
                                            <Panel Width="16" Height="16">
                                                <Polygon Name="PlayIcon" Points="3,1 14,8 3,15" Fill="{DynamicResource AppOnAccentTextBrush}"/>
                                                <StackPanel Name="PauseIcon" IsVisible="False" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Rectangle Width="4" Height="14" Fill="{DynamicResource AppOnAccentTextBrush}"/>
                                                    <Rectangle Width="4" Height="14" Fill="{DynamicResource AppOnAccentTextBrush}"/>
                                                </StackPanel>
                                            </Panel>
                                        </Button>
                                        <!-- Fast forward uses RIGHT-pointing triangles -->
                                        <Button Name="FastForwardButton" Classes="Primary" MinWidth="50" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand" ToolTip.Tip="Skip forward 10 seconds in the video." Padding="0" IsEnabled="False" AutomationProperties.Name="Fast Forward 10 Seconds">
                                            <Panel Width="16" Height="16">
                                                <Polygon Points="2,2 8,8 2,14" Fill="{DynamicResource AppOnAccentTextBrush}"/>
                                                <Polygon Points="8,2 14,8 8,14" Fill="{DynamicResource AppOnAccentTextBrush}"/>
                                            </Panel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Name="MergeButton" Classes="Success" Content="MERGE VIDEOS" CornerRadius="10" IsEnabled="False" ToolTip.Tip="Combine all the videos in your list into one single final video." Padding="20,10"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Speed -->
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="10" VerticalAlignment="Center">
                                    <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="SPEED" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" />
                                        <controls:SpinningWheelSlider Name="MainSpeedSlider" HorizontalAlignment="Stretch" MinWidth="180" MaxWidth="300" Height="35" Cursor="Hand" ToolTip.Tip="Slide left to make the video slow motion, or right to speed it up." />
                                        <TextBlock Name="MainSpeedLabel" Text="1.0x — Normal" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize10}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,0" VerticalAlignment="Top" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Name="MainSpeedPresetsPanel" Classes="SpeedPresetRows" Orientation="Vertical" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <Button Name="SpeedPreset01" Classes="SpeedPreset" Content="0.1x" ToolTip.Tip="Set speed to 0.1x"/>
                                            <Button Name="SpeedPreset05" Classes="SpeedPreset" Content="0.5x" ToolTip.Tip="Set speed to 0.5x"/>
                                            <Button Name="SpeedPreset10" Classes="SpeedPreset BaseSpeedPreset" Content="1.0x" ToolTip.Tip="Set speed to normal (1.0x)"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <Button Name="SpeedPreset20" Classes="SpeedPreset" Content="2.0x" ToolTip.Tip="Set speed to 2.0x"/>
                                            <Button Name="SpeedPreset30" Classes="SpeedPreset" Content="3.0x" ToolTip.Tip="Set speed to 3.0x"/>
                                            <Button Name="SpeedPreset40" Classes="SpeedPreset" Content="4.0x" ToolTip.Tip="Set speed to 4.0x"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- RETURN + Output Info + Estimated Size -->
                                <StackPanel Orientation="Vertical" Spacing="3" Margin="10" VerticalAlignment="Center">
                                    <Button Name="ReturnToMainAppButton" Classes="Secondary" Content="← RETURN TO MAIN APP" FontSize="{DynamicResource AppFontSize9}" Cursor="Hand" ToolTip.Tip="Close the merger and go back to the main editing studio."/>
                                    <TextBlock Name="OutputPathText" Text="" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize11}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="400"/>
                                    <TextBlock Name="EstimatedSizeText" Text="" Foreground="{DynamicResource AppInfoBrush}" FontSize="{DynamicResource AppFontSize14}" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                                    <!-- ISSUE_005: Normalization info -->
                                    <TextBlock Name="NormalizeInfoText" Text="" Foreground="{DynamicResource AppTextMutedBrush}" FontSize="{DynamicResource AppFontSize11}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Processing Overlay -->
                <controls:PhaseOverlayControl x:Name="OverlayLayer" Grid.Row="2" Grid.ColumnSpan="2" IsVisible="False" />
            </Grid>
        </Border>
    </Grid>
</Window>
