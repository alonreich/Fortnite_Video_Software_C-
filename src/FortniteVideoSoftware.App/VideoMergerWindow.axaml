<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:CompileBindings="True"
        xmlns:local="clr-namespace:FortniteVideoSoftware.App"
        x:Class="FortniteVideoSoftware.App.VideoMergerWindow"
        xmlns:controls="clr-namespace:FortniteVideoSoftware.App.Controls"
        Title="Fortnite Video Software - Merger"
        Width="1200" Height="800"
        Background="#1e293b"
        MinWidth="1200" MinHeight="800"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="30">


    <Grid>
        <Border Name="MainBorder" Background="#1e293b" CornerRadius="0" Padding="0" BorderBrush="LightGray" BorderThickness="5">
            <Grid RowDefinitions="30, *">
                <Border Name="TitleBarBorder" Grid.Row="0" Background="{DynamicResource TitleBarBackground}" IsHitTestVisible="False">
                    <TextBlock Name="TitleBarText" Classes="WindowTitleText" Text="{Binding $parent[Window].Title}" Foreground="{DynamicResource TitleBarForeground}" />
                </Border>
                <Grid Grid.Row="1" ColumnDefinitions="*, 350">
                    <!-- LEFT COLUMN: Video Player Area -->
        <Grid Grid.Column="0" RowDefinitions="*, Auto, Auto">
            <Border Grid.Row="0" Background="Black" Margin="10,10,10,0" CornerRadius="6" ClipToBounds="True">
                <local:MpvVideoView Name="VideoHost" />
            </Border>

            <!-- Timeline -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="10,10,10,0">
                <TextBlock Name="TimeElapsed" Text="00:00:00" Foreground="White" VerticalAlignment="Center" Width="60" />
                <Slider Grid.Column="1" Name="TimelineSlider" Margin="10,0" Minimum="0" Maximum="100" Cursor="Hand" ToolTip.Tip="Drag to scrub through the video" />
                <TextBlock Grid.Column="2" Name="TimeRemaining" Text="00:00:00" Foreground="White" VerticalAlignment="Center" Width="60" TextAlignment="Right" />
            </Grid>

            <!-- Bottom Controls -->
            <Grid Grid.Row="2" RowDefinitions="Auto, Auto" Margin="10,15,10,10">
                <!-- Top Row: Play/Pause -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Button Name="PlayPauseButton" Classes="Success" Width="60" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" ToolTip.Tip="Play or pause the video">
                        <Panel Width="16" Height="16">
                            <Polygon Name="PlayIcon" Points="3,1 14,8 3,15" Fill="White"/>
                            <StackPanel Name="PauseIcon" IsVisible="False" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle Width="4" Height="14" Fill="White"/>
                                <Rectangle Width="4" Height="14" Fill="White"/>
                            </StackPanel>
                        </Panel>
                    </Button>
                </Grid>

                <!-- Bottom Row: Return To App, Merge Videos, Add Music -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Name="ReturnButton" Classes="Primary" Content="RETURN TO APP" Width="140" Height="42" FontSize="12" ToolTip.Tip="Close merger and return to main app"/>
                    </StackPanel>
                    
                    <!-- Centered buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Name="MergeButton" Classes="Success" Content="MERGE VIDEOS" Width="140" Height="42" FontSize="12" Margin="0,0,15,0" IsEnabled="False" ToolTip.Tip="Add at least two videos to enable merging"/>
                        <Button Name="AddMusicButton" Classes="Primary" Content="ADD MUSIC" Width="130" Height="42" FontSize="12" ToolTip.Tip="Add background music to the video"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- RIGHT PANEL: Video List & Utility -->
        <Border Grid.Column="1" Background="#334155" BorderBrush="#475569" BorderThickness="1,0,0,0" Padding="15">
            <Grid RowDefinitions="Auto, *, Auto, Auto">
                <TextBlock Grid.Row="0" Text="VIDEO QUEUE" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                
                <Border Grid.Row="1" Background="#1e293b" CornerRadius="4" Margin="0,0,0,15">
                    <Grid>
                        <ListBox Name="VideoList" Background="Transparent" Foreground="White" FontSize="12" DragDrop.AllowDrop="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}" Cursor="Hand" ToolTip.Tip="Click to select this video"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Name="EmptyQueueText" Text="Add at least two videos to build a merge queue." Foreground="{DynamicResource AppTextMutedBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Spacing="10" Margin="0,0,0,15">
                    <Button Name="AddVideoButton" Classes="Primary" Content="ADD VIDEO" HorizontalAlignment="Stretch" Height="32" FontSize="9" ToolTip.Tip="Add another video to the queue"/>
                    <Button Name="RemoveVideoButton" Classes="Danger" Content="REMOVE SELECTED" HorizontalAlignment="Stretch" Height="32" FontSize="9" IsEnabled="False" ToolTip.Tip="Select a video to remove it from the queue"/>
                    <Button Name="MoveUpButton" Classes="Primary" Content="MOVE UP" HorizontalAlignment="Stretch" Height="32" FontSize="9" IsEnabled="False" ToolTip.Tip="Select a video that is not already first"/>
                    <Button Name="MoveDownButton" Classes="Primary" Content="MOVE DOWN" HorizontalAlignment="Stretch" Height="32" FontSize="9" IsEnabled="False" ToolTip.Tip="Select a video that is not already last"/>
                </StackPanel>
                <TextBlock Grid.Row="3" Name="QueueStatusText" Text="Waiting for videos." Foreground="{DynamicResource AppTextMutedBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
            </Grid>
        </Border>
        
        <!-- Processing Overlay -->
        <controls:PhaseOverlayControl x:Name="OverlayLayer" Grid.ColumnSpan="2" IsVisible="False" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
