using System;
using System.Runtime.InteropServices;
using Avalonia.OpenGL;
using Avalonia.OpenGL.Controls;
using Avalonia.Threading;
using FortniteVideoSoftware.Core.Media;

namespace FortniteVideoSoftware.App;

public class MpvVideoView : OpenGlControlBase
{
    private nint _mpvHandle;
    private nint _renderContext;
    private LibMpvInterop.GetProcAddressCb? _getProcAddressCb;
    private LibMpvInterop.MpvRenderUpdateFn? _renderUpdateCb;

    public MpvIpcClient? IpcClient { get; private set; }

    public void InitializeMpv(string mpvPath)
    {
        RuntimeLog.Info("MPV", "InitializeMpv: Creating mpv handle...");
        _mpvHandle = MpvWrapper.mpv_create();
        if (_mpvHandle == nint.Zero)
        {
            RuntimeLog.Fail("MPV", "InitializeMpv: mpv_create returned ZERO handle!");
            return;
        }
        RuntimeLog.Info("MPV", $"InitializeMpv: Handle created OK ({_mpvHandle})");

        // CRITICAL FIX 1: 'wid=0' strictly forbids the OS from ever spawning a detached window.
        MpvWrapper.mpv_set_option_string(_mpvHandle, "wid", "0");
        MpvWrapper.mpv_set_option_string(_mpvHandle, "vo", "libmpv");

        // The embedded preview renders through libmpv's OpenGL FBO path. Letting mpv
        // probe hwdec interop here produces noisy failed D3D/DXVA/CUDA/Vulkan attempts
        // before falling back, so preview decode is kept explicit and deterministic.
        MpvWrapper.mpv_set_option_string(_mpvHandle, "hwdec", "no");
        MpvWrapper.mpv_set_option_string(_mpvHandle, "gpu-hwdec-interop", "no");
        // CRITICAL FIX 2: Opaque background prevents Avalonia from discarding fully transparent FBOs.
        MpvWrapper.mpv_set_option_string(_mpvHandle, "background", "#FF000000");
        MpvWrapper.mpv_set_option_string(_mpvHandle, "keep-open", "yes");
        MpvWrapper.mpv_set_option_string(_mpvHandle, "idle", "yes");

        // In DEV MODE: Enable detailed MPV debug logging to a file in the dev log dir.
        if (RuntimeLog.IsDevMode && RuntimeLog.DevLogDir != null)
        {
            string mpvLogPath = System.IO.Path.Combine(RuntimeLog.DevLogDir, "mpv_debug.log");
            MpvWrapper.mpv_set_option_string(_mpvHandle, "terminal", "yes");
            MpvWrapper.mpv_set_option_string(_mpvHandle, "msg-level", "all=v");
            MpvWrapper.mpv_set_option_string(_mpvHandle, "log-file", mpvLogPath);
            RuntimeLog.Info("MPV", $"InitializeMpv: Dev mode — MPV debug log at {mpvLogPath}");
        }
        else
        {
            MpvWrapper.mpv_set_option_string(_mpvHandle, "terminal", "no");
            MpvWrapper.mpv_set_option_string(_mpvHandle, "msg-level", "all=warn");
        }

        MpvWrapper.mpv_set_option_string(_mpvHandle, "force-window", "no");

        int initResult = MpvWrapper.mpv_initialize(_mpvHandle);
        RuntimeLog.Info("MPV", $"InitializeMpv: mpv_initialize returned {initResult}");

        IpcClient = new MpvIpcClient(_mpvHandle);
        RuntimeLog.Info("MPV", "InitializeMpv: IpcClient created. Render context will be created on next GL frame.");

        // Request a frame render — the render context will be created inside
        // OnOpenGlRender where the GL context is actually current.
        RequestNextFrameRendering();
    }

    public Task StartMpvProcessAsync(string mpvPath)
    {
        InitializeMpv(mpvPath);
        return Task.CompletedTask;
    }

    /// <summary>
    /// Forcefully destroys the MPV handle and render context.
    /// </summary>
    public void DisposeMpv()
    {
        if (_renderContext != nint.Zero)
        {
            LibMpvInterop.mpv_render_context_free(_renderContext);
            _renderContext = nint.Zero;
        }

        IpcClient?.Dispose();
        IpcClient = null;

        if (_mpvHandle != nint.Zero)
        {
            MpvWrapper.mpv_terminate_destroy(_mpvHandle);
            _mpvHandle = nint.Zero;
        }
    }

    protected override void OnOpenGlInit(GlInterface gl)
    {
        base.OnOpenGlInit(gl);
        RuntimeLog.Info("MPV-GL", $"OnOpenGlInit: Fired. _mpvHandle={_mpvHandle}, GL version={gl?.Version}");
        // The render context will be created in OnOpenGlRender where we have
        // the GL context + the mpv handle both ready.
    }

    /// <summary>
    /// Creates the mpv render context using the OpenGL interface.
    /// MUST be called from within OnOpenGlRender where the GL context is current.
    /// </summary>
    private bool TryCreateRenderContext(GlInterface gl)
    {
        if (_mpvHandle == nint.Zero || _renderContext != nint.Zero)
            return true; // Already created, or no mpv handle yet

        RuntimeLog.Info("MPV-GL", "TryCreateRenderContext: Creating OpenGL render context...");

        // CRITICAL FIX 3: Avalonia throws exceptions for missing GL extensions.
        _getProcAddressCb = (ctx, name) =>
        {
            try
            {
                nint addr = gl.GetProcAddress(name);
                return addr;
            }
            catch
            {
                return nint.Zero;
            }
        };

        var initParams = new LibMpvInterop.mpv_opengl_init_params
        {
            get_proc_address = Marshal.GetFunctionPointerForDelegate(_getProcAddressCb),
            get_proc_address_ctx = nint.Zero
        };

        nint initParamsPtr = Marshal.AllocHGlobal(Marshal.SizeOf<LibMpvInterop.mpv_opengl_init_params>());
        Marshal.StructureToPtr(initParams, initParamsPtr, false);
        nint apiTypePtr = Marshal.StringToHGlobalAnsi("opengl");

        var renderParams = new LibMpvInterop.mpv_render_param[]
        {
            new LibMpvInterop.mpv_render_param { type = LibMpvInterop.MPV_RENDER_PARAM_API_TYPE, data = apiTypePtr },
            new LibMpvInterop.mpv_render_param { type = LibMpvInterop.MPV_RENDER_PARAM_OPENGL_INIT_PARAMS, data = initParamsPtr },
            new LibMpvInterop.mpv_render_param { type = 0, data = nint.Zero }
        };

        int createResult = LibMpvInterop.mpv_render_context_create(out _renderContext, _mpvHandle, renderParams);
        RuntimeLog.Info("MPV-GL", $"TryCreateRenderContext: mpv_render_context_create returned {createResult}, _renderContext={_renderContext}");

        Marshal.FreeHGlobal(initParamsPtr);
        Marshal.FreeHGlobal(apiTypePtr);

        if (_renderContext == nint.Zero)
        {
            RuntimeLog.Fail("MPV-GL", $"TryCreateRenderContext: Render context creation FAILED (error {createResult})! Video will NOT render.");
            return false;
        }

        // Set up the render update callback for frame notifications.
        _renderUpdateCb = (ctx) =>
        {
            try
            {
                if (_renderContext != nint.Zero)
                {
                    ulong flags = LibMpvInterop.mpv_render_context_update(_renderContext);
                    if ((flags & LibMpvInterop.MPV_RENDER_UPDATE_FRAME) != 0)
                    {
                        Dispatcher.UIThread.Post(RequestNextFrameRendering, DispatcherPriority.Render);
                    }
                }
            }
            catch
            {
            }
        };
        LibMpvInterop.mpv_render_context_set_update_callback(_renderContext, _renderUpdateCb, nint.Zero);

        RuntimeLog.Info("MPV-GL", "TryCreateRenderContext: Render context created successfully!");
        return true;
    }

    protected override void OnOpenGlRender(GlInterface gl, int fb)
    {
        // ──────────────────────────────────────────────────────────────
        // RACE CONDITION FIX: Create the render context here, inside
        // OnOpenGlRender, where the Avalonia OpenGL context is actually
        // current on this thread. Creating it from InitializeMpv (which
        // runs on the UI thread from the Loaded event) fails because the
        // GL context is NOT current on that thread, causing
        // glGetString(GL_VERSION) to return NULL → error -18.
        // ──────────────────────────────────────────────────────────────
        if (_renderContext == nint.Zero && _mpvHandle != nint.Zero)
        {
            if (!TryCreateRenderContext(gl))
            {
                // Render context creation failed — retry on next frame.
                Dispatcher.UIThread.Post(RequestNextFrameRendering, DispatcherPriority.Render);
                return;
            }
        }

        if (_renderContext == nint.Zero)
        {
            if (!_loggedNoContext)
            {
                RuntimeLog.Fail("MPV-GL", "OnOpenGlRender: _renderContext is ZERO — cannot render!");
                _loggedNoContext = true;
            }
            Dispatcher.UIThread.Post(RequestNextFrameRendering, DispatcherPriority.Render);
            return;
        }

        // Consume the newly decoded frame.
        LibMpvInterop.mpv_render_context_update(_renderContext);

        var scale = VisualRoot?.RenderScaling ?? 1.0;
        int width = (int)(Bounds.Width * scale);
        int height = (int)(Bounds.Height * scale);

        // Log first valid render to confirm pipeline is working
        if (!_loggedFirstRender && width > 0 && height > 0)
        {
            RuntimeLog.Info("MPV-GL", $"OnOpenGlRender: First valid render! dims={width}x{height}, fb={fb}, scale={scale}");
            _loggedFirstRender = true;
        }

        // Prevent poisoning the MPV render context with a 0×0 FBO.
        if (width <= 0 || height <= 0)
        {
            Dispatcher.UIThread.Post(RequestNextFrameRendering, DispatcherPriority.Render);
            return;
        }

        // CRITICAL FIX 4: Explicitly define GL_RGBA8 (32856).
        var fbo = new LibMpvInterop.mpv_opengl_fbo
        {
            fbo = fb,
            w = width,
            h = height,
            internal_format = 32856
        };

        nint fboPtr = Marshal.AllocHGlobal(Marshal.SizeOf<LibMpvInterop.mpv_opengl_fbo>());
        Marshal.StructureToPtr(fbo, fboPtr, false);

        int flipY = 1;
        nint flipYPtr = Marshal.AllocHGlobal(sizeof(int));
        Marshal.WriteInt32(flipYPtr, flipY);

        var renderParams = new LibMpvInterop.mpv_render_param[]
        {
            new LibMpvInterop.mpv_render_param { type = LibMpvInterop.MPV_RENDER_PARAM_OPENGL_FBO, data = fboPtr },
            new LibMpvInterop.mpv_render_param { type = LibMpvInterop.MPV_RENDER_PARAM_FLIP_Y, data = flipYPtr },
            new LibMpvInterop.mpv_render_param { type = 0, data = nint.Zero }
        };

        LibMpvInterop.mpv_render_context_render(_renderContext, renderParams);
        Marshal.FreeHGlobal(fboPtr);
        Marshal.FreeHGlobal(flipYPtr);

        // Enforce a continuous render loop to prevent frame delivery stalls.
        Dispatcher.UIThread.Post(RequestNextFrameRendering, DispatcherPriority.Render);
    }

    private bool _loggedFirstRender;
    private bool _loggedNoContext;

    protected override void OnOpenGlDeinit(GlInterface gl)
    {
        RuntimeLog.Info("MPV-GL", "OnOpenGlDeinit: Tearing down GL context.");
        if (_renderContext != nint.Zero)
        {
            LibMpvInterop.mpv_render_context_free(_renderContext);
            _renderContext = nint.Zero;
        }
        if (_mpvHandle != nint.Zero)
        {
            IpcClient?.Dispose();
            IpcClient = null;
            MpvWrapper.mpv_terminate_destroy(_mpvHandle);
            _mpvHandle = nint.Zero;
        }
        base.OnOpenGlDeinit(gl);
    }
}
